---
/**
 * StatementCard
 *
 * The dark card the droplet blooms into on the homepage (Reel.astro): a label,
 * one statement set big, and a button to the About page. Every word of the statement is
 * its own span with an index, and lights up from dim to full as
 * `--reel-read` (0..1, written on the section by the reel engine) climbs —
 * first word to last, in step with the scroll. Without the engine the
 * variable is unset, it falls back to 1, and the whole statement simply shows.
 *
 * Sized in container units, so whatever box it fills (the engine's fixed
 * overlay, or the static frame) must be a size container.
 */
import ArrowFillButton from '@/components/site/ArrowFillButton.astro';

interface Props {
  /** Paint the card's own ink ground and corners. Off when the WebGL frame
   *  underneath already draws them. */
  surface?: boolean;
}

const { surface = false } = Astro.props;

// The statement, in phrases; `accent` phrases are set in the accent colour.
const phrases: { text: string; accent?: boolean }[] = [
  { text: 'Making something' },
  { text: 'beautifully designed', accent: true },
  { text: 'and' },
  { text: 'technically solid', accent: true },
  { text: '— that’s what I find genuinely satisfying.' },
];

const words = phrases.flatMap((phrase) =>
  phrase.text.split(' ').map((text) => ({ text, accent: Boolean(phrase.accent) }))
);
---

<figure class:list={['stmt', surface && 'stmt--surface']} style={`--n: ${words.length}`}>
  <p class="stmt__label label-mono">What drives me</p>

  <blockquote class="stmt__quote">
    <p class="stmt__text">
      {
        words.map((word, i) => (
          <>
            <span class:list={['stmt__w', word.accent && 'stmt__w--accent']} style={`--i: ${i}`}>
              {word.text}
            </span>{' '}
          </>
        ))
      }
    </p>
  </blockquote>

  {/* The way on to the About page, as a button so it is seen (Hans's
      choice): it replaced the signature row of name, role and place. */}
  <div class="stmt__foot">
    <ArrowFillButton href="/about" class="stmt__button">More about me</ArrowFillButton>
  </div>
</figure>

<style>
  .stmt {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 3cqh;
    margin: 0;
    padding: clamp(24px, 6cqh, 64px) clamp(22px, 6cqi, 88px) clamp(20px, 5cqh, 52px);
    color: var(--ice-100);
  }

  .stmt--surface {
    border-radius: inherit;
    background: var(--reel-card-bg, var(--ink-950));
  }

  .stmt__label {
    margin: 0;
    color: rgb(238 242 244 / 0.5);
  }

  .stmt__quote {
    margin: 0;
  }

  /* One statement, set like a headline. Sized off both container axes, so a
     wide 16:9 card and a tall phone card both fill out to three or four lines. */
  .stmt__text {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: clamp(22px, calc(3.7cqi + 4.4cqh), 104px);
    line-height: 1.04;
    letter-spacing: var(--display-tracking);
    text-transform: var(--display-case);
    text-wrap: balance;
  }

  /* Each word is lit by how far the reading has got: the word at index i
     comes up as --reel-read passes i/n, from a faint 16% to full. */
  .stmt__w {
    opacity: clamp(0.16, calc(var(--reel-read, 1) * (var(--n) + 1) - var(--i)), 1);
    transition: opacity 0.12s linear;
  }

  .stmt__w--accent {
    color: var(--statement-accent, var(--orbit-500));
  }

  /* The button fades up while the last quarter of the statement lights
     and goes again just before the card folds away: the reel engine
     writes that as --reel-foot (scripts/reel/morph.ts, FOOT_*). Without
     the engine the variable falls back to 1 and the button simply shows.
     A keyboard user who tabs to it sees it at once. */
  .stmt__foot {
    --foot-in: var(--reel-foot, 1);
    display: flex;
    align-items: center;
    opacity: var(--foot-in);
    translate: 0 calc((1 - var(--foot-in)) * 16px);
    transition:
      opacity 0.12s linear,
      translate 0.12s linear;
  }

  .stmt__foot:focus-within {
    opacity: 1;
    translate: none;
  }

  /* The site's arrow button, turned round for the ink card: a light pill
     with a violet disc, which fills the pill violet on hover. The card's
     overlay lets clicks through; the button takes them. */
  .stmt .stmt__foot :global(.stmt__button) {
    --afb-bg: var(--ice-100);
    --afb-text: var(--ink-950);
    --afb-fill-bg: var(--orbit-fill);
    --afb-fill-text: #fff;
    pointer-events: auto;
  }

  .stmt .stmt__foot :global(.stmt__button:focus-visible) {
    outline-color: var(--statement-accent, var(--orbit-500));
  }
</style>
