---
/**
 * CinemaHero
 *
 * The hero of the blog posts, About, contact and the projects page, in the
 * style of the project pages (Hans's choice). A picture fills the screen:
 * the violet grid of the blog covers with an icon or a mark drawn large, or
 * a photo. The title sits large at its foot with the line beside it, and
 * the facts run along the bottom in a strip of frosted glass.
 *
 * The shading over the picture is the page ground, so light mode gets a
 * light hero with dark type and dark mode an ink one with light type. The
 * top stays dark violet, and every page with this hero sets the nav over
 * it in white until the page scrolls (navOverMedia / overMedia).
 * Phones and tablets held upright: the picture at the top, fading out, and
 * the title, the line and the facts under it.
 *
 * The picture arrives as on the project pages: unveiled from the bottom up
 * while it settles from slightly larger (`data-cinema`, scripts/motion/
 * case.ts and the rules in styles/global.css).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { lucideBody } from '@/lib/og';
import type { PostTone } from '@/lib/post-tone';

export interface CinemaFact {
  label: string;
  value: string;
  href?: string;
  external?: boolean;
  /** A date, rendered in a <time>. */
  date?: Date;
}

interface Props {
  /** The small mono label above the title. */
  label: string;
  title: string;
  /** A word of the title set in the accent colour, e.g. "Astro". */
  accent?: string;
  description: string;
  facts: CinemaFact[];
  /** The strip's name for screen readers. */
  factsLabel: string;
  /** A Lucide name, or "astro" or "claude", drawn large on the grid. */
  icon?: string;
  /** Text drawn large on the grid instead of an icon, e.g. "hm/". */
  mark?: string;
  /** A photo: fills the hero instead of the grid. */
  image?: ImageMetadata;
  imageAlt?: string;
  /** Which part of the photo to keep in view when it is cropped, as CSS
   *  object-position, e.g. "50% 30%" to keep a face above the title. */
  imagePosition?: string;
  /** A long title (a blog post's) is set smaller so it keeps to a few lines. */
  fit?: boolean;
  /** A lower hero, so what comes under it shows on the first screen
   *  (the contact page's form). */
  short?: boolean;
  /** A blog post's colour: emerald for Performance (lib/post-tone.ts). */
  tone?: PostTone;
}

const {
  label,
  title,
  accent,
  description,
  facts,
  factsLabel,
  icon,
  mark,
  image,
  imageAlt,
  imagePosition,
  fit = false,
  short = false,
  tone = 'violet',
} = Astro.props;

// Drawn inline from Lucide's data with thin lines, as on the covers.
const iconBody = icon ? lucideBody(icon)?.replace(/stroke-width="2"/g, 'stroke-width="1"') : undefined;

// A portrait photo can't fill a wide hero without losing most of it: on a
// wide screen it stands on the right, full height, over the violet grid.
const portraitPhoto = Boolean(image && image.height > image.width);

// A link too long for half a phone's width (an email address) puts the
// strip in one column there.
const longLink = facts.some((fact) => fact.href && fact.value.length > 16);

// The accent word, if it is in the title.
const at = accent ? title.indexOf(accent) : -1;
const parts =
  at >= 0 && accent
    ? [title.slice(0, at), accent, title.slice(at + accent.length)]
    : [title, '', ''];
---

<header
  class:list={[
    'cin',
    fit && 'cin--fit',
    short && 'cin--short',
    longLink && 'cin--long',
    tone === 'emerald' && 'cin--emerald tone-emerald',
    portraitPhoto && 'cin--portrait',
  ]}
  data-cinema
>
  <div class:list={['cin__picture', image && 'cin__picture--photo']} data-cinema-picture>
    {
      image ? (
        <Image
          src={image}
          alt={imageAlt || title}
          layout="none"
          widths={[768, 1280, 1920, 2560]}
          sizes="100vw"
          class="cin__photo"
          style={imagePosition ? `object-position: ${imagePosition}` : undefined}
          loading="eager"
          fetchpriority="high"
        />
      ) : iconBody ? (
        <svg
          class="cin__icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          set:html={iconBody}
        />
      ) : (
        mark && (
          <span class="cin__mark" aria-hidden="true">
            {mark}
          </span>
        )
      )
    }
  </div>
  <div class="cin__scrim" aria-hidden="true"></div>

  <div class="cin__body shell">
    <span class="label-mono cin__label">{label}</span>
    <h1 class="cin__title" style={`--len: ${title.length}`}>
      {parts[0]}{parts[1] && <em>{parts[1]}</em>}{parts[2]}
    </h1>
    <p class="cin__desc">{description}</p>
  </div>

  <div class="cin__ledger" role="group" aria-label={factsLabel}>
    <dl class="cin__facts shell" style={`--cols: ${Math.min(facts.length, 4)}`}>
      {
        facts.map((fact) => (
          <div>
            <dt class="label-mono">{fact.label.toUpperCase()}</dt>
            <dd>
              {fact.href ? (
                <a
                  href={fact.href}
                  target={fact.external ? '_blank' : undefined}
                  rel={fact.external ? 'noopener noreferrer' : undefined}
                >
                  {fact.value}
                </a>
              ) : fact.date ? (
                <time datetime={fact.date.toISOString()}>{fact.value}</time>
              ) : (
                fact.value
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</header>

<style>
  .cin {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 100svh;
    padding-top: calc(var(--sw-nav-h, 72px) + 24px);
    background: var(--background);
  }

  .cin--short {
    min-height: 62svh;
  }

  /* In the lower hero the text takes most of the height: no room for the
     icon above it on desktop (a phone shows it above the text), and the
     shading reaches further up. */
  .cin--short .cin__icon {
    display: none;
  }

  .cin--short .cin__scrim {
    background:
      linear-gradient(
        to top,
        color-mix(in srgb, var(--background) 96%, transparent) 0%,
        color-mix(in srgb, var(--background) 78%, transparent) 45%,
        transparent 88%
      ),
      linear-gradient(to bottom, rgb(20 8 48 / 0.35), transparent 22%);
  }

  /* The violet grid: the violet of the blog covers, darker at its foot,
     with the grid over it, as on the newsletter card. */
  .cin__picture {
    position: absolute;
    inset: 0;
    z-index: -2;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--orbit-950) 14%, var(--orbit-fill)),
      var(--orbit-950)
    );
  }

  .cin__picture:not(.cin__picture--photo)::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0.16;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.35) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.35) 1px, transparent 1px);
    background-size: 64px 64px;
  }

  .cin__icon {
    position: absolute;
    left: 50%;
    top: 40%;
    translate: -50% -50%;
    width: min(22vw, 30svh);
    height: auto;
    color: #fff;
    filter: drop-shadow(0 0 60px rgb(255 255 255 / 0.35));
  }

  .cin__mark {
    position: absolute;
    left: 50%;
    top: 38%;
    translate: -50% -50%;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: min(15vw, 24svh);
    line-height: 1;
    letter-spacing: -0.06em;
    color: #fff;
    text-shadow: 0 0 80px rgb(255 255 255 / 0.35);
  }

  .cin__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* A photo keeps the violet grid under it, and a dark shade at its top,
     so the nav's white letters read over a bright sky. */
  .cin__picture--photo::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to bottom, rgb(12 10 20 / 0.55), rgb(12 10 20 / 0) 26%);
  }

  /* A portrait photo on a wide screen: on the right, full height, fading
     into the violet grid on its left; the text keeps to the left. */
  @media (min-width: 801px) and (orientation: landscape), (min-width: 1101px) {
    .cin--portrait .cin__photo {
      left: auto;
      width: min(52%, 900px);
      -webkit-mask-image: linear-gradient(to right, transparent, #000 32%);
      mask-image: linear-gradient(to right, transparent, #000 32%);
    }

    .cin--portrait .cin__picture--photo::before {
      content: '';
      position: absolute;
      inset: 0;
      opacity: 0.16;
      background-image:
        linear-gradient(rgb(255 255 255 / 0.35) 1px, transparent 1px),
        linear-gradient(90deg, rgb(255 255 255 / 0.35) 1px, transparent 1px);
      background-size: 64px 64px;
    }

    .cin--portrait .cin__body {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    }

    .cin--portrait .cin__desc {
      grid-column: 1;
      grid-row: auto;
      max-width: 44ch;
      margin: 24px 0 0;
    }
  }

  /* The page ground rises over the picture's foot, so the type reads in
     either mode. At the top a darker violet, so the nav's white letters
     and icons read over it in light mode too (navOverMedia, Hans's choice
     for people who need the contrast). */
  .cin__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(
        to top,
        color-mix(in srgb, var(--background) 96%, transparent) 0%,
        color-mix(in srgb, var(--background) 62%, transparent) 30%,
        transparent 62%
      ),
      linear-gradient(to bottom, rgb(20 8 48 / 0.35), transparent 22%);
  }

  /* Emerald: a deep green at the top for the white nav, and in light mode
     a lighter shading at the foot, so the green under the title stays
     fresh instead of greying. */
  .cin--emerald .cin__scrim {
    background:
      linear-gradient(
        to top,
        color-mix(in srgb, var(--background) 96%, transparent) 0%,
        color-mix(in srgb, var(--background) 62%, transparent) 30%,
        transparent 62%
      ),
      linear-gradient(to bottom, rgb(2 30 22 / 0.35), transparent 22%);
  }

  :global(html:not(.dark)) .cin--emerald .cin__scrim {
    background:
      linear-gradient(
        to top,
        color-mix(in srgb, var(--background) 94%, transparent) 0%,
        color-mix(in srgb, var(--orbit-50) 55%, transparent) 26%,
        color-mix(in srgb, var(--orbit-50) 16%, transparent) 44%,
        transparent 58%
      ),
      linear-gradient(to bottom, rgb(2 30 22 / 0.35), transparent 22%);
  }

  .cin__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 38ch);
    align-items: end;
    column-gap: 48px;
    width: 100%;
    padding-bottom: 48px;
    color: var(--foreground);
  }

  .cin__label {
    grid-column: 1;
    margin-bottom: 14px;
    color: var(--foreground-secondary);
  }

  .cin__title {
    grid-column: 1;
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    text-transform: var(--display-case);
    letter-spacing: var(--display-tracking);
    font-size: clamp(3.4rem, 9vw, 9rem);
    line-height: 0.92;
    text-wrap: balance;
  }

  /* A short title runs large on one line; a long one gets smaller. */
  .cin--fit .cin__title {
    font-size: clamp(2.8rem, calc(7.4vw * min(1, 28 / var(--len, 20))), 8.4rem);
  }

  .cin__title em {
    font-style: normal;
    color: var(--hero-accent);
  }

  .cin__desc {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: end;
    margin: 0 0 10px;
    font-size: 19px;
    line-height: 1.55;
    color: var(--foreground-secondary);
  }

  .cin__ledger {
    width: 100%;
    border-top: 1px solid var(--border-strong);
    background: color-mix(in srgb, var(--background) 55%, transparent);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    color: var(--foreground);
  }

  .cin__facts {
    display: grid;
    grid-template-columns: repeat(var(--cols, 4), minmax(0, 1fr));
    gap: 32px;
    margin: 0;
    padding-block: 26px 30px;
  }

  .cin__facts dt {
    color: var(--foreground-muted);
  }

  .cin__facts dd {
    margin: 12px 0 0;
    font-size: 17px;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }

  .cin__facts a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 4px;
  }

  .cin__facts a:hover {
    text-decoration-thickness: 2.5px;
  }

  @media (max-width: 1000px) {
    .cin__facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px;
    }
  }

  @media (max-width: 800px), (max-width: 1100px) and (orientation: portrait) {
    .cin {
      min-height: 0;
      padding-top: 0;
    }

    .cin__picture {
      position: relative;
      inset: auto;
      height: 60svh;
      -webkit-mask-image: linear-gradient(#000 70%, transparent);
      mask-image: linear-gradient(#000 70%, transparent);
    }

    .cin__icon {
      top: 52%;
      width: min(32vw, 24svh);
    }

    .cin--short .cin__picture {
      height: 40svh;
    }

    .cin--short .cin__icon {
      display: block;
      top: 52%;
      width: min(24vw, 16svh);
    }

    .cin__mark {
      top: 52%;
      font-size: min(24vw, 20svh);
    }

    .cin__scrim {
      display: none;
    }

    .cin__body {
      grid-template-columns: minmax(0, 1fr);
      margin-top: -24px;
      padding-bottom: 40px;
    }

    .cin__desc {
      grid-column: 1;
      grid-row: auto;
      margin: 20px 0 0;
      font-size: 17px;
    }

    .cin__title,
    .cin--fit .cin__title {
      font-size: clamp(2.4rem, calc(13vw * min(1, 20 / var(--len, 12))), 4.6rem);
    }

    .cin__ledger {
      background: var(--background);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  @media (max-width: 560px) {
    .cin--long .cin__facts {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }
  }
</style>
