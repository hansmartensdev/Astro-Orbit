---
/**
 * ThemeToggle
 *
 * A two-state switch between dark and light mode, as in Velocity: one
 * button, and its icon shows what a click does. A sun in dark mode (click
 * for light), a moon in light mode (click for dark).
 *
 * Dark is the default: a first-time visitor gets dark mode, whatever their
 * system is set to (BaseLayout's inline script, before first paint). A click
 * to light stores `light`; a click back to dark removes it again, so the
 * visitor follows the default from then on.
 *
 * Reads / writes:
 *   localStorage.theme   'light', or nothing for the default (dark). An
 *                        older 'dark' or 'system' from the earlier
 *                        three-way menu is still read correctly.
 *   <html>.dark          the appearance
 *   meta[theme-color]    the browser bar's colour
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const sun =
  '<path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />';
const moon =
  '<path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />';
---

<button type="button" class:list={['ttg__trigger', className]} aria-label="Switch to light mode" data-theme-toggle>
  {/* Sun: shown in dark mode, a click switches to light. */}
  <svg
    class="ttg__icon ttg__icon--sun"
    xmlns="http://www.w3.org/2000/svg"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
    aria-hidden="true"
    set:html={sun}
  />
  {/* Moon: shown in light mode, a click switches to dark. */}
  <svg
    class="ttg__icon ttg__icon--moon"
    xmlns="http://www.w3.org/2000/svg"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
    aria-hidden="true"
    set:html={moon}
  />
</button>

<style>
  .ttg__trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 6px;
    /* No ring: the icon alone, in the bar's own text colour, like the hm/
       mark and the word Menu beside it. */
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: inherit;
    cursor: pointer;
    transition: background-color var(--transition-fast);
  }

  .ttg__trigger:hover {
    background: color-mix(in srgb, currentColor 12%, transparent);
  }

  .ttg__trigger:focus-visible {
    outline: 2px solid var(--hero-accent, #7c3aed);
    outline-offset: 3px;
  }

  .ttg__icon {
    display: none;
    width: 18px;
    height: 18px;
  }

  /* The icon shows the click's result: the sun in dark mode, the moon in
     light mode. */
  :global(html.dark) .ttg__icon--sun,
  :global(html:not(.dark)) .ttg__icon--moon {
    display: block;
  }
</style>

<script>
  const KEY = 'theme';
  const root = document.documentElement;

  // Used when storage is blocked, so a choice still holds on this page.
  let memory: string | null = null;

  function read(): string | null {
    try {
      return localStorage.getItem(KEY);
    } catch {
      return memory;
    }
  }

  function write(value: string | null) {
    memory = value;
    try {
      if (value) localStorage.setItem(KEY, value);
      else localStorage.removeItem(KEY);
    } catch {
      // Storage blocked: the choice lasts for this page only.
    }
  }

  // Dark unless light was chosen. An older 'system' from the three-way menu
  // still follows the system until the visitor clicks.
  function isDark(): boolean {
    const saved = read();
    if (saved === 'light') return false;
    if (saved === 'system') return window.matchMedia('(prefers-color-scheme: dark)').matches;
    return true;
  }

  function render() {
    const dark = isDark();
    root.classList.toggle('dark', dark);
    document.getElementById('theme-color')?.setAttribute('content', dark ? '#0e0e0e' : '#eef2f4');
    for (const button of document.querySelectorAll('[data-theme-toggle]')) {
      button.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
    }
  }

  // One set of listeners per document. The ClientRouter keeps this module
  // between pages but replaces <html>'s attributes on every swap, so the
  // flag lives here, not on <html>: kept there, it was wiped by each swap,
  // every page change added another click listener, and with two a click
  // switched the mode twice, so the button seemed to do nothing.
  let ready = false;

  function initThemeToggle() {
    render();
    if (ready) return;
    ready = true;

    document.addEventListener('click', (event) => {
      if (!(event.target as Element).closest('[data-theme-toggle]')) return;
      // To light: remember it. Back to dark: forget, so the default holds.
      write(root.classList.contains('dark') ? 'light' : null);
      render();
    });

    // Keep other open tabs in step.
    window.addEventListener('storage', (event) => {
      if (event.key === KEY || event.key === null) render();
    });

    // The ClientRouter's swap gives <html> the new page's attributes,
    // without .dark: set it on the incoming page before it shows, so a page
    // change never flashes the wrong mode.
    document.addEventListener('astro:before-swap', (event) => {
      (event as unknown as { newDocument: Document }).newDocument.documentElement.classList.toggle(
        'dark',
        isDark()
      );
    });
  }

  initThemeToggle();
  document.addEventListener('astro:after-swap', initThemeToggle);
</script>
