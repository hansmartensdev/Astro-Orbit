---
/**
 * ThemeToggle
 *
 * Hans's own colour-mode picker from hansmartens.dev (ThemeModeDropdown),
 * brought over as it is: a small round button showing the active mode
 * (monitor for System, sun for Light, moon for Dark) that opens a menu of
 * the three, with "Currently light/dark" under System and a check on the
 * active one, here in the brand violet.
 *
 * Reads / writes:
 *   localStorage.theme          'system' | 'light' | 'dark'
 *   <html data-theme-mode>      the saved mode (drives the icon)
 *   <html>.dark                 the resolved appearance
 *
 * BaseLayout's inline script sets both before first paint, so the page
 * never flashes the wrong theme. The ClientRouter's swap replaces <html>'s
 * attributes with the new page's, so they're put back after every swap.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const monitor =
  '<rect x="2.75" y="3.75" width="18.5" height="13" rx="2" /><path stroke-linecap="round" d="M8 20.25h8M12 16.75v3.5" />';
const sun =
  '<path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />';
const moon =
  '<path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />';

const modes = [
  { mode: 'system', title: 'System', icon: monitor },
  { mode: 'light', title: 'Light', icon: sun },
  { mode: 'dark', title: 'Dark', icon: moon },
];
---

<div class:list={['ttg', className]}>
  <button
    type="button"
    class="ttg__trigger"
    aria-haspopup="menu"
    aria-expanded="false"
    aria-label="Theme: system. Click to change."
  >
    {
      modes.map((m) => (
        <svg
          class:list={['ttg__icon', `ttg__icon--${m.mode}`]}
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
          set:html={m.icon}
        />
      ))
    }
  </button>

  <div class="ttg__panel" role="menu" aria-label="Colour mode" hidden>
    {
      modes.map((m) => (
        <button type="button" class="ttg__row" role="menuitemradio" aria-checked="false" data-mode={m.mode}>
          <svg
            class="ttg__row-icon"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
            set:html={m.icon}
          />
          <span class="ttg__label">
            <span class="ttg__title">{m.title}</span>
            {m.mode === 'system' && <span class="ttg__sub">Currently light</span>}
          </span>
          <svg
            class="ttg__check"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M20 6L9 17l-5-5" />
          </svg>
        </button>
      ))
    }
  </div>
</div>

<style>
  .ttg {
    position: relative;
  }

  .ttg__trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 6px;
    /* No ring: the icon alone, in the bar's own text colour, like the
       hm/ mark and the word Menu beside it (Hans's choice). */
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: inherit;
    cursor: pointer;
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast);
  }

  .ttg__trigger:hover,
  .ttg__trigger[aria-expanded='true'] {
    background: color-mix(in srgb, currentColor 12%, transparent);
  }

  .ttg__trigger:focus-visible {
    outline: 2px solid var(--hero-accent, #7c3aed);
    outline-offset: 3px;
  }

  /* One icon at a time, from <html data-theme-mode>; System before the
     attribute is set. */
  .ttg__icon {
    display: none;
    width: 16px;
    height: 16px;
  }

  :global(html[data-theme-mode='system']) .ttg__icon--system,
  :global(html[data-theme-mode='light']) .ttg__icon--light,
  :global(html[data-theme-mode='dark']) .ttg__icon--dark,
  :global(html:not([data-theme-mode])) .ttg__icon--system {
    display: block;
  }

  .ttg__panel {
    position: absolute;
    right: 0;
    top: 100%;
    z-index: 60;
    width: 224px;
    margin-top: 8px;
    padding: 6px;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-background);
    box-shadow: 0 10px 30px rgb(12 16 22 / 0.12);
  }

  .ttg__panel[hidden] {
    display: none;
  }

  .ttg__row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 8px 10px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--color-foreground-muted);
    text-align: left;
    cursor: pointer;
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast);
  }

  .ttg__row:hover,
  .ttg__row[aria-checked='true'] {
    background: var(--color-secondary);
    color: var(--color-foreground);
  }

  .ttg__row:focus-visible {
    outline: 2px solid var(--hero-accent, #7c3aed);
    outline-offset: -2px;
  }

  .ttg__row-icon {
    width: 16px;
    height: 16px;
  }

  .ttg__label {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .ttg__title {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-foreground);
  }

  .ttg__sub {
    margin-top: 2px;
    font-size: 12px;
    color: var(--color-foreground-muted);
  }

  .ttg__check {
    display: none;
    width: 16px;
    height: 16px;
    color: var(--hero-accent, #7c3aed);
  }

  .ttg__row[aria-checked='true'] .ttg__check {
    display: block;
  }
</style>

<script>
  type Mode = 'system' | 'light' | 'dark';
  const KEY = 'theme';

  const readMode = (): Mode => {
    try {
      const v = localStorage.getItem(KEY);
      if (v === 'system' || v === 'light' || v === 'dark') return v;
    } catch {
      /* storage blocked */
    }
    // Nothing chosen yet: dark first, as BaseLayout's inline script.
    return 'dark';
  };

  const osDark = () => window.matchMedia('(prefers-color-scheme: dark)').matches;

  const apply = (mode: Mode) => {
    const root = document.documentElement;
    root.setAttribute('data-theme-mode', mode);
    const dark = mode === 'dark' || (mode === 'system' && osDark());
    root.classList.toggle('dark', dark);
    document.getElementById('theme-color')?.setAttribute('content', dark ? '#0e0e0e' : '#eef2f4');
  };

  const sync = () => {
    const mode = readMode();
    document.querySelectorAll<HTMLElement>('.ttg__row').forEach((row) => {
      row.setAttribute('aria-checked', String(row.dataset.mode === mode));
    });
    document.querySelectorAll<HTMLElement>('.ttg__trigger').forEach((btn) => {
      btn.setAttribute('aria-label', `Theme: ${mode}. Click to change.`);
    });
    const sub = osDark() ? 'Currently dark' : 'Currently light';
    document.querySelectorAll<HTMLElement>('.ttg__sub').forEach((el) => (el.textContent = sub));
  };

  const closeAll = () => {
    document.querySelectorAll<HTMLElement>('.ttg__panel').forEach((p) => (p.hidden = true));
    document.querySelectorAll<HTMLElement>('.ttg__trigger').forEach((t) => t.setAttribute('aria-expanded', 'false'));
  };

  function init() {
    sync();
    for (const wrap of document.querySelectorAll<HTMLElement>('.ttg')) {
      if (wrap.dataset.ready) continue;
      wrap.dataset.ready = 'true';
      const trigger = wrap.querySelector<HTMLButtonElement>('.ttg__trigger')!;
      const panel = wrap.querySelector<HTMLElement>('.ttg__panel')!;

      trigger.addEventListener('click', (event) => {
        event.stopPropagation();
        const open = !panel.hidden;
        closeAll();
        if (!open) {
          panel.hidden = false;
          trigger.setAttribute('aria-expanded', 'true');
          panel.querySelector<HTMLElement>('[aria-checked="true"]')?.focus();
        }
      });

      panel.querySelectorAll<HTMLButtonElement>('.ttg__row').forEach((row) => {
        row.addEventListener('click', () => {
          const mode = row.dataset.mode as Mode;
          try {
            localStorage.setItem(KEY, mode);
          } catch {
            /* storage blocked: applies for this page only */
          }
          apply(mode);
          sync();
          closeAll();
          trigger.focus();
        });
      });

      // Arrow keys move between the three rows.
      panel.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
        event.preventDefault();
        const rows = [...panel.querySelectorAll<HTMLElement>('.ttg__row')];
        const i = rows.indexOf(document.activeElement as HTMLElement);
        const next = rows[(i + (event.key === 'ArrowDown' ? 1 : rows.length - 1)) % rows.length];
        next.focus();
      });
    }
  }

  // Once per document, not per page: closing on outside click or Escape,
  // following the OS while on System, and putting the theme back after a
  // ClientRouter swap (which replaces <html>'s attributes).
  document.addEventListener('click', (event) => {
    if (!(event.target as Element | null)?.closest?.('.ttg')) closeAll();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const open = document.querySelector<HTMLElement>('.ttg__panel:not([hidden])');
    if (!open) return;
    closeAll();
    open.closest('.ttg')?.querySelector<HTMLElement>('.ttg__trigger')?.focus();
  });
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
    if (readMode() === 'system') apply('system');
    sync();
  });
  document.addEventListener('astro:after-swap', () => apply(readMode()));

  init();
  document.addEventListener('astro:page-load', init);
</script>
