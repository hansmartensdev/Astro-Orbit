---
/**
 * PillButton
 *
 * The studio's button: a tall pill, either solid ink or an ink outline.
 *
 * It wraps Velocity's Button rather than replacing it, so there is still one
 * button implementation on the site. Button composes its classes through `cn`
 * (tailwind-merge), which drops the conflicting base utilities — the rounded-md
 * corners and the fixed h-12 — in favour of the ones passed here.
 */
import Button from '@/components/ui/form/Button/Button.astro';
import { cn } from '@/lib/cn';

interface Props {
  href?: string;
  variant?: 'solid' | 'outline';
  target?: string;
  class?: string;
  /** Anything else (data-* hooks) goes straight through to the anchor. */
  [key: `data-${string}`]: string | undefined;
}

const { href, variant = 'solid', target, class: className, ...rest } = Astro.props;

const pill = [
  'rounded-full h-auto px-10 py-[18px] text-[17px] font-semibold',
  'transition-[transform,background-color,color] duration-300 ease-out',
].join(' ');

// Brand violet and white only, like the sign-off's buttons: a violet pill
// that grows a little on hover, or a violet ring and label that fill violet.
const look =
  variant === 'solid'
    ? 'bg-[var(--hero-accent)] text-white hover:bg-[var(--hero-accent)] hover:text-white hover:scale-105 active:scale-100'
    : 'border-[1.5px] border-[var(--hero-accent)] bg-transparent text-[var(--hero-accent)] hover:bg-[var(--hero-accent)] hover:border-[var(--hero-accent)] hover:text-white active:scale-100 ' +
      // On ink, brand violet is too dark to read as a ring and label; the
      // lighter violet made for ink takes over until the hover fills it.
      'dark:border-[var(--hero-accent-on-ink)] dark:text-[var(--hero-accent-on-ink)] dark:hover:border-[var(--hero-accent)] dark:hover:text-white';
---

<Button
  href={href}
  target={target}
  variant={variant === 'solid' ? 'primary' : 'outline'}
  size="lg"
  data-button
  class={cn(pill, look, className)}
  {...rest}
>
  <slot />
</Button>
