---
/**
 * Thread
 *
 * Hans's notes and the person's messages, newest first, each with who wrote
 * it and when. The person sees "Hans" and "You"; Hans sees "You" and the
 * person's address. On the admin page each entry can be removed.
 */
import type { Entry } from '@/lib/workspace/model';
import { shortDate } from '@/lib/workspace/model';

interface Props {
  entries: Entry[];
  /** Who is looking: the labels depend on it. */
  viewer: 'admin' | 'member';
  member?: string;
  /** Show a remove button per entry (admin page). */
  removable?: boolean;
}

const { entries, viewer, member, removable = false } = Astro.props;

const who = (by: Entry['by']) =>
  viewer === 'admin' ? (by === 'hans' ? 'YOU' : (member || 'THEM').toUpperCase()) : by === 'hans' ? 'HANS' : 'YOU';
---

{
  entries.length === 0 ? (
    <p class="th__empty">Nothing here yet.</p>
  ) : (
    <ul class="th">
      {entries.map((entry) => (
        <li class:list={['th__item', entry.by === 'hans' ? 'th__item--hans' : 'th__item--member']}>
          <span class="label-mono th__meta">
            {who(entry.by)} · {shortDate(entry.at).toUpperCase()}
          </span>
          <p class="th__text">{entry.text}</p>
          {removable && (
            <form method="post" data-astro-reload class="th__remove">
              <input type="hidden" name="do" value="entry-delete" />
              <input type="hidden" name="id" value={entry.id} />
              <button type="submit">Remove</button>
            </form>
          )}
        </li>
      ))}
    </ul>
  )
}

<style>
  .th {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .th__item {
    position: relative;
    padding: 18px 0 18px 18px;
    border-top: 1px solid var(--border-strong);
  }

  /* A violet line marks Hans's notes. */
  .th__item--hans::before {
    content: '';
    position: absolute;
    left: 0;
    top: 20px;
    bottom: 20px;
    width: 3px;
    border-radius: 3px;
    background: var(--orbit-fill);
  }

  .th__item--member::before {
    content: '';
    position: absolute;
    left: 0;
    top: 20px;
    bottom: 20px;
    width: 3px;
    border-radius: 3px;
    background: var(--border-strong);
  }

  .th__meta {
    color: var(--foreground-muted);
  }

  .th__text {
    margin: 8px 0 0;
    font-size: 17px;
    line-height: 1.55;
    color: var(--foreground-secondary);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .th__empty {
    margin: 0;
    color: var(--foreground-muted);
  }

  .th__remove {
    margin-top: 8px;
  }

  .th__remove button {
    padding: 0;
    border: 0;
    background: none;
    color: var(--foreground-muted);
    font-size: 14px;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
</style>
