---
/**
 * Panel
 *
 * The workspace's card on the second ground, the contact page's: a small
 * label above it, a violet glow behind it in light mode, a close violet
 * edge in dark mode. Forms and short messages go in it.
 */
interface Props {
  label: string;
  id?: string;
}

const { label, id } = Astro.props;
---

<section class="wsp" id={id}>
  <div class="wsp__inner shell">
    <span class="label-mono wsp__label">{label}</span>
    <div class="wsp__stage">
      <div class="wsp__card">
        <slot />
      </div>
    </div>
  </div>
</section>

<style>
  .wsp {
    padding-block: clamp(48px, 5vw, 72px) clamp(88px, 11vw, 140px);
    background: var(--background-secondary);
  }

  .wsp__inner {
    max-width: 720px;
  }

  .wsp__label {
    display: block;
    margin-bottom: 24px;
    text-align: center;
    color: var(--foreground-muted);
  }

  .wsp__stage {
    position: relative;
    isolation: isolate;
  }

  .wsp__stage::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 8% 4% -4%;
    border-radius: 40px;
    background: var(--orbit-fill);
    filter: blur(110px);
    opacity: 0.35;
    pointer-events: none;
  }

  :global(.dark) .wsp__stage::before {
    display: none;
  }

  .wsp__card {
    padding: clamp(28px, 4vw, 52px);
    border: 1px solid var(--border);
    border-radius: 28px;
    background: var(--background-elevated, #fff);
  }

  :global(.dark) .wsp__card {
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--orbit-fill) 35%, transparent),
      0 24px 80px -24px color-mix(in srgb, var(--orbit-fill) 55%, transparent);
  }

  .wsp__card :global(form) {
    display: grid;
    gap: 22px;
  }

  .wsp__card :global(.wsp-note) {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
    color: var(--foreground-muted);
  }

  .wsp__card :global(.wsp-done) {
    text-align: center;
  }

  .wsp__card :global(.wsp-done h2) {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    text-transform: var(--display-case);
    letter-spacing: var(--display-tracking);
    font-size: clamp(1.8rem, 3vw, 2.4rem);
  }

  .wsp__card :global(.wsp-done p) {
    margin: 14px auto 0;
    max-width: 42ch;
    font-size: 17px;
    line-height: 1.55;
    color: var(--foreground-secondary);
  }

  .wsp__card :global(.wsp-done svg) {
    display: block;
    width: 52px;
    height: 52px;
    margin: 0 auto 18px;
    color: var(--hero-accent);
  }

  :global(.dark) .wsp__card :global(.wsp-done svg) {
    color: var(--orbit-on-dark);
  }

  .wsp__card :global(.wsp-link) {
    display: inline-block;
    margin-top: 20px;
    color: inherit;
    font-size: 15px;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
