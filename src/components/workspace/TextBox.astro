---
/**
 * TextBox
 *
 * A labelled text area that shows text already saved, for the admin page:
 * Velocity's Textarea draws an empty field only. The field uses the same
 * classes (textareaVariants), so it looks the same.
 */
import { textareaVariants } from '@/components/ui/form/Textarea/textarea.variants';
import { cn } from '@/lib/cn';

interface Props {
  label: string;
  name: string;
  value?: string;
  rows?: number;
  maxlength?: number;
  placeholder?: string;
  required?: boolean;
}

const { label, name, value = '', rows = 4, maxlength, placeholder, required } = Astro.props;
const id = `tb-${name}`;
---

<div class="space-y-1.5">
  <label for={id} class="text-sm leading-none font-medium">{label}</label>
  <textarea
    id={id}
    name={name}
    rows={rows}
    maxlength={maxlength}
    placeholder={placeholder}
    required={required}
    class={cn(textareaVariants({ size: 'md' }), '[field-sizing:content] max-h-[60vh] font-mono')}
    style={`min-height: calc(${rows}lh + 1.5rem)`}>{value}</textarea
  >
</div>
