---
/**
 * Founder
 *
 * One ink card, the size of a service card, carrying the person behind the
 * studio. The headline is the working model in six words — no agency
 * handoffs, the founder is in the work — and two short paragraphs carry the
 * biography: the background, then the desks he sits at now. Four numbers run along the bottom as a strip, the
 * roles he holds now are pills, and LinkedIn is an icon in the corner. The
 * portrait is cropped into the card's right edge and fades into the ground on
 * its inner and lower sides, so the type and the photo read as one surface
 * rather than copy beside a headshot.
 *
 * The card uses the same colourway tokens as the ink service card, minus its
 * blue glows, so it is plain ink and re-maps itself in dark mode along with
 * the rest of the stack.
 */
import { Icon } from 'astro-icon/components';
import siteConfig from '@/config/site.config';
import Placeholder from '@/components/site/Placeholder.astro';
import { Image } from 'astro:assets';
import iphone from '@/assets/about/iphone.png';

interface Stat {
  value: string;
  label: string;
}

// The portrait comes from a photographer. Until it exists the card runs
// without its photo column; set this to true (and swap the placeholder below
// for an <Image class="founder__photo" />) when it does.
const hasPortrait = false;

// The years, from Hans's own introduction: websites since 2010, Astro since
// 2022.
const stats: Stat[] = [
  { value: '2010', label: 'Building websites since' },
  { value: '2022', label: 'With Astro since' },
  { value: 'Veghel', label: 'Based in' },
];

interface Desk {
  org: string;
  role: string;
  href: string;
}

const linkedIn = siteConfig.socialLinks.find((url) => url.includes('linkedin.com'));

// Where to find Hans. (Michael's version listed the roles he held; add
// current roles or companies here the same way if you want them shown.)
const desks: Desk[] = [
  { org: 'GitHub', role: 'hansmartensdev', href: 'https://github.com/hansmartensdev' },
  { org: 'LinkedIn', role: 'hansmartensdev', href: 'https://www.linkedin.com/in/hansmartensdev/' },
];
---

<section class="shell pt-[130px] pb-[40px] max-[800px]:pt-[90px] max-[800px]:pb-[30px]">
  <article
    class:list={['founder', !hasPortrait && 'founder--text']}
    aria-labelledby="founder"
    data-reveal
    data-reveal-load
  >
    {
      linkedIn && (
        <a
          class="founder__linkedin"
          href={linkedIn}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${siteConfig.name} on LinkedIn`}
        >
          <Icon name="fa6-brands:linkedin-in" aria-hidden="true" />
        </a>
      )
    }

    <div class="founder__body">
      <span class="label-mono founder__eyebrow"> ABOUT ME · HANS MARTENS </span>

      <h2 class="founder__headline display-service" id="founder">
        <span class="rv-mask">
          <span>Building websites</span>
        </span>
        <span class="rv-mask">
          <span><em>since 2010.</em></span>
        </span>
      </h2>

      {/* Who Hans is, from the facts in his introduction post, in other
          words than the post. */}
      <div class="founder__prose">
        <p>
          In 1992 I bought a new computer, and both the operating system and the hardware have
          interested me ever since. In 1998 I built my first computer from parts, and in 2000 I
          became a computer service engineer, repairing the laptops that students of the
          Eindhoven University of Technology bought through the university.
        </p>
        <p>
          My first website, in 2010, was one I built for myself with WordPress. I've built websites
          ever since, and in 2022 I moved to Astro. Today I work with Astro every day, on websites
          and on free, MIT-licensed Astro themes for the community, and I build with Claude Code,
          running on Opus 5.5.
        </p>
        <p>
          Away from work you'll find me at the gym, enjoying good food and a proper espresso, or
          outside with my two dogs.
        </p>
        <p>
          There's more about me in my <a href="/blog/introducing-myself/">introduction post</a>.
        </p>
      </div>

      <ul class="founder__desks">
        {
          desks.map((desk) => {
            const external = desk.href.startsWith('http');
            return (
              <li>
                <a
                  class="founder__desk"
                  href={desk.href}
                  target={external ? '_blank' : undefined}
                  rel={external ? 'noopener noreferrer' : undefined}
                >
                  <span class="founder__desk-org">{desk.org}</span>
                  <span class="founder__desk-role">{desk.role}</span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>

    {
      hasPortrait && (
    <figure class="founder__figure m-0">
      {/* PLACEHOLDER: a portrait of Hans. Swap for an <Image class="founder__photo" />
          when it exists; the card's fade and crop stay as they are. */}
      <div class="founder__photo">
        <Placeholder class="h-full w-full rounded-none" invert label="[ placeholder: portrait of Hans ]" />
      </div>
    </figure>
      )
    }

    {
      /* Until the portrait exists: Hans's iPhone screenshot of the homepage,
         on a phone standing on the card's violet, in the card's empty right
         half on desktop only (Hans's choice). Hidden below 1101px, where the
         card is one column; lazy, so it never downloads there. */
      !hasPortrait && (
        <figure class="founder__phone m-0">
          <Image
            src={iphone}
            alt="The hansmartens.dev homepage in dark mode on an iPhone: the 3D droplet and the violet ball above the headline"
            widths={[440, 660, 880, 1100]}
            sizes="440px"
            loading="lazy"
            decoding="async"
          />
        </figure>
      )
    }

    <dl class="founder__stats">
      {
        stats.map((stat) => (
          <div class="founder__stat">
            <dt class="founder__label label-mono">{stat.label.toUpperCase()}</dt>
            <dd class="founder__value">{stat.value}</dd>
          </div>
        ))
      }
    </dl>
  </article>
</section>

<style>
  .founder {
    /* The brand card, as the blog post header and the footer: deep violet
       with the violet glow from the lower left and a light one top right. */
    --card-bg: #1a1030;
    /* Violet-white for the text and lines, in both modes: the site's ice
       white is a touch cool, and on violet its edges read faintly
       blue-green. */
    --card-fg: #f5f3ff;
    --card-chip: rgb(245 243 255 / 0.32);
    --card-glow-a: rgb(124 58 237 / 0.55);
    --card-glow-b: rgb(167 139 250 / 0.18);
    --card-light: 0% 100%;
    --card-light-b: 100% 0%;
    /* A light grain in both modes: a heavy one leaves blue-green specks on
       the violet. */
    --card-grain: 0.25;
    --card-pad-x: 60px;
    --card-pad-y: 60px;
    --card-rule: rgb(245 243 255 / 0.14);

    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    grid-template-rows: auto auto;
    column-gap: 40px;
    border: 1px solid rgb(124 58 237 / 0.18);
    border-radius: var(--radius-xl);
    box-shadow: 0 -12px 40px rgb(12 16 22 / 0.1);
    color: var(--card-fg);
    background-color: var(--card-bg);
    background-image:
      radial-gradient(120% 95% at var(--card-light), var(--card-glow-a), transparent 62%),
      radial-gradient(95% 75% at var(--card-light-b), var(--card-glow-b), transparent 68%);
  }

  /* Without the portrait: one column, the text at a readable width. */
  .founder.founder--text {
    grid-template-columns: minmax(0, 1fr);
  }

  .founder--text .founder__prose {
    max-width: 640px;
  }

  /* Same grain as the service cards, so the pile and this card are one
     material. */
  .founder::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    background-image: var(--sw-grain);
    background-size: 180px 180px;
    opacity: var(--card-grain, 0.5);
    mix-blend-mode: soft-light;
    pointer-events: none;
  }

  .founder__body {
    position: relative;
    z-index: 2;
    grid-column: 1;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: var(--card-pad-y) 0 56px var(--card-pad-x);
  }

  .founder__eyebrow {
    opacity: 0.55;
  }

  .founder__headline {
    margin: 28px 0 0;
  }

  .founder__prose {
    margin: 40px 0 0;
    max-width: 560px;
  }

  .founder__prose p {
    margin: 0;
    font-size: 17px;
    line-height: 1.65;
    opacity: 0.78;
  }

  .founder__prose p + p {
    margin-top: 1.4em;
  }

  .founder__prose a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .founder__prose a:hover {
    text-decoration-thickness: 2px;
  }

  /* ---- linkedin ------------------------------------------------------- */
  /* A round icon button in the card's corner, over the quiet part of the
     portrait backdrop. */
  .founder__linkedin {
    position: absolute;
    top: 28px;
    right: 28px;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border: 1.5px solid var(--card-chip);
    border-radius: var(--radius-full);
    color: var(--card-fg);
    /* No backdrop blur: this sits inside a scroll-driven 3D reveal, and a
       live blur inside an animating layer is re-sampled every frame. */
    background-color: rgb(12 16 22 / 0.35);
    transition:
      background-color 0.25s ease,
      color 0.25s ease,
      border-color 0.25s ease,
      transform 0.3s ease;
  }

  .founder__linkedin :global(svg) {
    width: 18px;
    height: 18px;
  }

  .founder__linkedin:hover {
    background-color: var(--card-fg);
    border-color: var(--card-fg);
    color: var(--card-bg);
    transform: scale(1.06);
  }

  /* ---- the roles ------------------------------------------------------ */
  .founder__desks {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 36px 0 0;
    padding: 0;
    list-style: none;
  }

  .founder__desk {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    padding: 12px 20px;
    border: 1.5px solid var(--card-chip);
    border-radius: var(--radius-full);
    font-size: 15px;
    font-weight: 500;
    color: inherit;
    text-decoration: none;
    transition:
      background-color 0.25s ease,
      color 0.25s ease,
      border-color 0.25s ease;
  }

  .founder__desk:hover {
    background-color: var(--card-fg);
    border-color: var(--card-fg);
    color: var(--card-bg);
  }

  .founder__desk-role {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    opacity: 0.6;
  }

  /* ---- the portrait --------------------------------------------------- */
  /* Fills the card's right column edge to edge. The mask fades its inner and
     lower edges into the ink, so the studio backdrop never reads as a grey
     rectangle sitting on the card, and the numbers strip below it sits on
     clean ground. */
  .founder__figure {
    position: relative;
    z-index: 1;
    grid-column: 2;
    grid-row: 1;
    min-height: 100%;
    -webkit-mask-image:
      linear-gradient(to right, transparent 0%, #000 38%),
      linear-gradient(to top, transparent 0%, #000 30%);
    mask-image:
      linear-gradient(to right, transparent 0%, #000 38%),
      linear-gradient(to top, transparent 0%, #000 30%);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }

  .founder__photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0%;
  }

  /* The lit portrait sits exactly over the photograph and fades in once its
     first frame is drawn; without WebGL it never does, and the photograph
     stays. Opacity only: this sits inside a scroll-driven reveal. */
  .founder__figure :global(.founder-relight) {
    opacity: 0;
    transition: opacity 0.8s ease;
  }

  .founder__figure :global(.founder-relight.is-ready) {
    opacity: 1;
  }

  /* ---- the relight's controls ----------------------------------------- */
  /* An info button to the left of the LinkedIn one, and the panel it opens: what the
     effect is, and a switch between the lit portrait, the relief as clay,
     the raw depth map and the photograph. Portaled onto the card by the
     island, so the figure's fade never dims them. */
  .founder :global(.founder-relight__ui) {
    position: absolute;
    top: 28px;
    right: 86px;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
  }

  .founder :global(.founder-relight__info) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 1.5px solid var(--card-chip);
    border-radius: var(--radius-full);
    color: var(--card-fg);
    background-color: rgb(12 16 22 / 0.35);
    cursor: pointer;
    transition:
      background-color 0.25s ease,
      color 0.25s ease,
      border-color 0.25s ease,
      transform 0.3s ease;
  }

  .founder :global(.founder-relight__info svg) {
    width: 20px;
    height: 20px;
  }

  .founder :global(.founder-relight__info:hover),
  .founder :global(.founder-relight__info[aria-expanded='true']) {
    background-color: var(--card-fg);
    border-color: var(--card-fg);
    color: var(--card-bg);
  }

  .founder :global(.founder-relight__info:hover) {
    transform: scale(1.06);
  }

  .founder :global(.founder-relight__panel) {
    width: min(300px, calc(100vw - 80px));
    padding: 20px 22px 18px;
    border: 1px solid var(--card-chip);
    border-radius: var(--radius-lg, 16px);
    color: var(--card-fg);
    background-color: rgb(12 16 22 / 0.86);
    box-shadow: 0 18px 50px rgb(0 0 0 / 0.35);
  }

  .founder :global(.founder-relight__title) {
    margin: 0;
    opacity: 0.55;
  }

  .founder :global(.founder-relight__text) {
    margin: 12px 0 0;
    font-size: 14px;
    line-height: 1.55;
  }

  .founder :global(.founder-relight__text--dim) {
    margin-top: 8px;
    opacity: 0.6;
  }

  .founder :global(.founder-relight__views) {
    display: flex;
    gap: 6px;
    margin-top: 16px;
  }

  .founder :global(.founder-relight__view) {
    flex: 1 1 0;
    padding: 8px 0;
    border: 1.5px solid var(--card-chip);
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--card-fg);
    background: transparent;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .founder :global(.founder-relight__view:hover) {
    border-color: var(--card-fg);
  }

  .founder :global(.founder-relight__view[aria-pressed='true']) {
    background-color: var(--card-fg);
    border-color: var(--card-fg);
    color: var(--card-bg);
  }

  /* The card flips to ice in dark mode: the glass panel and button follow. */
  :global(.dark) .founder :global(.founder-relight__info),
  :global(.dark) .founder :global(.founder-relight__panel) {
    background-color: rgb(245 243 255 / 0.82);
  }

  /* ---- the numbers ---------------------------------------------------- */
  /* A strip across the full width of the card: four cells divided by
     hairlines, each a mono label over a display-scale figure. */
  .founder__stats {
    position: relative;
    z-index: 2;
    grid-column: 1 / -1;
    grid-row: 2;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    border-top: 1px solid var(--card-rule);
  }

  .founder__stat {
    padding: 36px 32px 40px;
    border-left: 1px solid var(--card-rule);
  }

  .founder__stat:first-child {
    padding-left: var(--card-pad-x);
    border-left: 0;
  }

  .founder__label {
    opacity: 0.55;
  }

  .founder__value {
    margin: 18px 0 0;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: clamp(48px, 4.6vw, 84px);
    line-height: 0.95;
    letter-spacing: var(--display-tracking);
  }

  @media (max-width: 1100px) {
    .founder {
      --card-pad-x: 40px;
      --card-pad-y: 44px;
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      column-gap: 24px;
    }

    .founder__stat {
      padding: 28px 24px 32px;
    }
  }

  @media (max-width: 800px) {
    .founder {
      --card-pad-x: 28px;
      --card-pad-y: 36px;
      grid-template-columns: 1fr;
      grid-template-rows: auto auto auto;
      column-gap: 0;
    }

    /* Photo first, fading down into the copy. */
    .founder__figure {
      grid-column: 1;
      grid-row: 1;
      min-height: 0;
      aspect-ratio: 4 / 5;
      max-height: 520px;
      margin-bottom: -60px;
      -webkit-mask-image: linear-gradient(to top, transparent 0%, #000 42%);
      mask-image: linear-gradient(to top, transparent 0%, #000 42%);
      -webkit-mask-composite: initial;
      mask-composite: initial;
    }

    .founder__body {
      grid-column: 1;
      grid-row: 2;
      padding: 0 var(--card-pad-x) 40px;
    }

    /* Without the portrait above it the text starts the card, so it takes
       the card's own top spacing instead of sitting on the edge. */
    .founder--text .founder__body {
      grid-row: 1;
      padding-top: var(--card-pad-y);
    }

    .founder__linkedin {
      top: 16px;
      right: 16px;
      width: 44px;
      height: 44px;
    }

    .founder :global(.founder-relight__ui) {
      top: 16px;
      right: 68px;
    }

    .founder :global(.founder-relight__info) {
      width: 44px;
      height: 44px;
    }

    .founder__headline {
      margin-top: 20px;
    }

    .founder__prose {
      margin-top: 28px;
    }

    .founder__prose p {
      font-size: 16px;
    }

    .founder__desks {
      margin-top: 28px;
    }

    /* Three figures, side by side on a phone too. */
    .founder__stats {
      grid-column: 1;
      grid-row: 3;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .founder__stat {
      padding: 20px 12px 24px;
    }

    .founder__stat:first-child {
      padding-left: 20px;
    }

    .founder__value {
      margin-top: 10px;
      font-size: clamp(20px, 6.2vw, 30px);
    }
  }

  /* ---- the phone in place of the portrait (desktop) ------------------- */
  .founder__phone {
    display: none;
  }

  @media (min-width: 1101px) {
    .founder.founder--text {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }

    .founder__phone {
      position: relative;
      z-index: 2;
      grid-column: 2;
      grid-row: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: calc(var(--card-pad-y) + 40px) var(--card-pad-x) var(--card-pad-y) 0;
    }

    .founder__phone :global(img) {
      display: block;
      width: auto;
      height: min(640px, 72vh);
      filter: drop-shadow(0 30px 50px rgb(0 0 0 / 0.5));
    }
  }
</style>
