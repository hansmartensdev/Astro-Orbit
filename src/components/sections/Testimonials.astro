---
/**
 * Testimonials: "What clients say"
 *
 * One quote at a time, large, on a dark panel with the violet grid (dark in
 * both modes, like the heroes: .hero-ink). Under it, the client's name and
 * a button per quote, labelled with the project it's about.
 *
 * The buttons are a tab list: click, or the arrow keys, Home and End, show
 * another quote; nothing switches on its own. Without the script every
 * quote shows, one under another, and the buttons stay hidden. The quotes
 * stack in one grid cell, so the panel keeps the height of the longest and
 * nothing below it moves when a quote changes.
 *
 * Text comes from `testimonials` in theme.config.ts. The demo's quotes are
 * fictive; there are no ratings, and no review markup for search engines.
 */
import { getCollection } from 'astro:content';
import SectionHead from './SectionHead.astro';
import { testimonials as section } from '@/config/theme.config';

const work = await getCollection('work');
const titleOf = (slug?: string) => (slug ? work.find((w) => w.id === slug)?.data.title : undefined);

const quotes = section.quotes.map((q, i) => {
  const at = q.accent ? q.quote.indexOf(q.accent) : -1;
  return {
    ...q,
    n: String(i + 1).padStart(2, '0'),
    label: titleOf(q.project) ?? q.name,
    initials: q.name
      .split(/\s+/)
      .map((w) => w[0])
      .filter((c) => c && c === c.toUpperCase())
      .slice(0, 2)
      .join(''),
    parts: at >= 0 ? [q.quote.slice(0, at), q.accent!, q.quote.slice(at + q.accent!.length)] : null,
  };
});
---

<section class="tq-sec shell pt-[130px] max-[800px]:pt-[90px]">
  <SectionHead title={section.title} blurb={section.blurb} id="testimonials" class="mb-14 max-[800px]:mb-9" />

  <div class="tq hero-ink" data-tq data-reveal>
    <div class="tq__stage">
      {
        quotes.map((q, i) => (
          <figure
            class="tq__quote"
            id={`tq-panel-${i}`}
            role="tabpanel"
            aria-labelledby={`tq-tab-${i}`}
            data-tq-panel
            data-active={i === 0 ? '' : undefined}
          >
            <span class="tq__mark" aria-hidden="true" />
            <blockquote class="tq__text">
              <p>
                {q.parts ? (
                  <>
                    {q.parts[0]}
                    <em>{q.parts[1]}</em>
                    {q.parts[2]}
                  </>
                ) : (
                  q.quote
                )}
              </p>
            </blockquote>
            <figcaption class="tq__who">
              <span class="tq__avatar" aria-hidden="true">
                {q.initials}
              </span>
              <span>
                <span class="tq__name">{q.name}</span>
                <span class="tq__role">{q.role}</span>
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>

    {
      quotes.length > 1 && (
        <div class="tq__tabs" role="tablist" aria-labelledby="testimonials" hidden data-tq-tabs>
          {quotes.map((q, i) => (
            <button
              type="button"
              class="tq__tab label-mono"
              id={`tq-tab-${i}`}
              role="tab"
              aria-controls={`tq-panel-${i}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              data-tq-tab
            >
              <span aria-hidden="true">{q.n}</span> {q.label}
            </button>
          ))}
        </div>
      )
    }
  </div>
</section>

<style>
  .tq {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: 22px;
    padding: 76px 88px 52px;
    color: var(--foreground);
    background:
      radial-gradient(90% 120% at 88% 0%, color-mix(in oklab, var(--orbit-fill) 42%, transparent), transparent 62%),
      var(--background);
  }
  .tq::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.12;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.35) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.35) 1px, transparent 1px);
    background-size: 64px 64px;
  }

  /* Without the script: every quote, one under another. */
  .tq__stage {
    display: grid;
    gap: 64px;
  }
  /* With it: the quotes share one cell, and only the active one shows. */
  .tq.is-ready .tq__stage {
    gap: 0;
  }
  .tq.is-ready .tq__quote {
    grid-area: 1 / 1;
    visibility: hidden;
    opacity: 0;
    translate: 0 10px;
    transition:
      opacity 0.45s ease,
      translate 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 0.45s;
  }
  .tq.is-ready .tq__quote[data-active] {
    visibility: visible;
    opacity: 1;
    translate: 0 0;
    transition:
      opacity 0.45s ease 0.08s,
      translate 0.45s cubic-bezier(0.22, 1, 0.36, 1) 0.08s,
      visibility 0s;
  }

  .tq__quote {
    display: flex;
    flex-direction: column;
    margin: 0;
  }

  /* The opening quote mark, drawn by CSS: decoration, not text. */
  .tq__mark::before {
    content: '\201C';
    display: block;
    height: 84px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 190px;
    line-height: 0.62;
    color: var(--orbit-on-ink);
  }

  .tq__text {
    margin: 0;
    flex: 1;
  }
  .tq__text p {
    margin: 0;
    max-width: 1080px;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(26px, 2.2vw + 12px, 50px);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }
  .tq__text em {
    font-style: normal;
    color: var(--orbit-on-ink);
  }

  .tq__who {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 52px;
    padding-top: 26px;
    border-top: 1px solid var(--border);
    /* Room on the right for the buttons, which sit on the same line. */
    padding-right: min(46%, 520px);
  }
  .tq__avatar {
    flex: none;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--orbit-fill);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 16px;
  }
  .tq__name {
    display: block;
    font-weight: 600;
  }
  .tq__role {
    display: block;
    font-size: 14px;
    color: var(--foreground-muted);
  }

  .tq__tabs {
    position: absolute;
    right: 88px;
    bottom: 52px;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 10px;
    max-width: 46%;
  }
  .tq__tabs[hidden] {
    display: none;
  }
  .tq__tab {
    padding: 11px 16px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: transparent;
    color: var(--foreground-secondary);
    letter-spacing: 0.08em;
    text-transform: lowercase;
    cursor: pointer;
    transition:
      background-color 0.25s ease,
      color 0.25s ease,
      border-color 0.25s ease;
  }
  .tq__tab:hover {
    border-color: var(--foreground);
    color: var(--foreground);
  }
  .tq__tab[aria-selected='true'] {
    background: var(--foreground);
    border-color: var(--foreground);
    color: var(--background);
  }
  .tq__tab:focus-visible {
    outline: 2px solid var(--orbit-on-ink);
    outline-offset: 3px;
  }

  @media (max-width: 800px) {
    .tq {
      padding: 40px 24px 28px;
      border-radius: 18px;
    }
    .tq__mark::before {
      height: 52px;
      font-size: 120px;
    }
    .tq__who {
      margin-top: 32px;
      padding-right: 0;
    }
    .tq__tabs {
      position: static;
      max-width: none;
      justify-content: flex-start;
      margin-top: 20px;
    }
  }
</style>

<script>
  function initQuotes() {
    document.querySelectorAll<HTMLElement>('[data-tq]').forEach((root) => {
      if (root.dataset.tqInit) return;
      root.dataset.tqInit = 'true';
      const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tq-tab]')];
      const panels = [...root.querySelectorAll<HTMLElement>('[data-tq-panel]')];
      const list = root.querySelector<HTMLElement>('[data-tq-tabs]');
      if (!list || tabs.length < 2) return;

      const show = (i: number, focus = false) => {
        tabs.forEach((t, k) => {
          const on = k === i;
          t.setAttribute('aria-selected', String(on));
          t.tabIndex = on ? 0 : -1;
          panels[k]?.toggleAttribute('data-active', on);
        });
        if (focus) tabs[i].focus();
      };

      tabs.forEach((t, i) => {
        t.addEventListener('click', () => show(i));
        t.addEventListener('keydown', (e) => {
          const last = tabs.length - 1;
          const to =
            e.key === 'ArrowRight' ? (i === last ? 0 : i + 1)
            : e.key === 'ArrowLeft' ? (i === 0 ? last : i - 1)
            : e.key === 'Home' ? 0
            : e.key === 'End' ? last
            : -1;
          if (to < 0) return;
          e.preventDefault();
          show(to, true);
        });
      });

      list.hidden = false;
      root.classList.add('is-ready');
    });
  }

  initQuotes();
  document.addEventListener('astro:after-swap', initQuotes);
</script>
