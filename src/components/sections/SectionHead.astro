---
/**
 * Giant section title paired with a short right-hand blurb. Shared by Work and
 * Services so the two headers stay identical.
 *
 * The header arrives as one unit, title and blurb together, through the
 * site's [data-reveal] system (src/scripts/motion/reveal.ts).
 */
interface Props {
  title: string;
  /** The heading level: h1 when this header titles the page (About, Work,
   *  Blog, Contact), h2 when it heads a section on a page that has one. */
  as?: 'h1' | 'h2';
  blurb: string;
  /** A word or phrase in the title to set in the brand violet. */
  accent?: string;
  id?: string;
  class?: string;
}

const { title, blurb, accent, id, as: Heading = 'h2', class: className } = Astro.props;

// The title split around the accent, if it has one.
const at = accent ? title.lastIndexOf(accent) : -1;
const parts = at >= 0 ? [title.slice(0, at), title.slice(at, at + accent!.length), title.slice(at + accent!.length)] : null;
---

<header
  class:list={[
    'flex items-baseline justify-between gap-10',
    'max-[800px]:flex-col max-[800px]:items-start max-[800px]:gap-5',
    className,
  ]}
  data-reveal
>
  <Heading class:list={['display-section m-0', Heading === 'h1' && 'sh__title--page']} id={id}>
    {
      parts ? (
        <>
          {parts[0]}
          <span class="sh__accent">{parts[1]}</span>
          {parts[2]}
        </>
      ) : (
        title
      )
    }
  </Heading>
  <p
    class="text-foreground-secondary m-0 max-w-[380px] text-[18px] leading-[1.55] max-[800px]:text-base"
  >
    {blurb}
  </p>
</header>

<style>
  .sh__accent {
    color: var(--hero-accent, #7c3aed);
  }

  /* A page title leads the phone scale, a step above the section heads on
     the same page. Desktop keeps the shared size. */
  @media (max-width: 700px) {
    .sh__title--page {
      font-size: clamp(38px, 11.2vw, 52px);
    }
  }
</style>
