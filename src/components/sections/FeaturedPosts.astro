---
/**
 * FeaturedPosts
 *
 * One or two posts from the blog on the homepage, as cards beside each
 * other: date, title, line, and a "Read the post" cue that turns violet on
 * hover. Which posts: the newest marked `featured: true` in their
 * frontmatter, or the newest posts when none are. Shares the giant-title
 * header with the craft and projects sections, and ends on a link to the
 * whole blog.
 */
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import SectionHead from '@/components/sections/SectionHead.astro';
import PillButton from '@/components/site/PillButton.astro';
import { formatDate } from '@/lib/utils';
import { coverPath } from '@/lib/og';
import PostCover from '@/components/blog/PostCover.astro';

interface Props {
  /** How many posts to show: one or two. */
  count?: 1 | 2;
}

const { count = 2 } = Astro.props;

const posts = (
  await getCollection('blog', ({ data }) => (import.meta.env.PROD ? data.draft !== true : true))
)
  .filter((post) => post.data.locale === 'en')
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const featured = posts.filter((post) => post.data.featured);
const shown = (featured.length > 0 ? featured : posts).slice(0, count);

const postUrl = (id: string) => '/blog/' + id.replace('en/', '');
---

{
  shown.length > 0 && (
    <section class="pt-[130px] max-[800px]:pt-[90px]">
      <div class="shell">
        <SectionHead
          title="From the blog"
          blurb="I write about building themes, Astro, and what makes websites fast."
        />

        <ul class:list={['posts m-0 mt-14 list-none p-0 max-[800px]:mt-10', shown.length === 1 && 'posts--single']}>
          {shown.map((post, i) => (
            <li data-reveal data-reveal-delay={i * 0.1}>
              <a class="post" href={postUrl(post.id)} data-card>
                <PostCover
                  class="post__cover"
                  src={post.data.image?.src ?? coverPath(post.id.replace(/^en\//, ''))}
                />
                <span class="label-mono text-foreground-muted">
                  {formatDate(post.data.publishedAt).toUpperCase()}
                </span>
                <h3 class="post__title">{post.data.title}</h3>
                <p class="post__line">{post.data.description}</p>
                <span class="post__more">
                  Read the post
                  <Icon name="lucide:arrow-right" aria-hidden="true" />
                </span>
              </a>
            </li>
          ))}
        </ul>

        <div class="mt-14 flex justify-center max-[800px]:mt-10" data-reveal>
          <PillButton href="/blog" variant="outline" class="px-9 py-4">
            All posts
            <Icon name="lucide:arrow-right" aria-hidden="true" />
          </PillButton>
        </div>
      </div>
    </section>
  )
}

<style>
  .posts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .posts--single {
    grid-template-columns: minmax(0, 1fr);
  }

  @media (max-width: 800px) {
    .posts {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .post {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: clamp(28px, 3.4vw, 48px);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    background: var(--color-background-elevated, #fff);
    color: inherit;
    text-decoration: none;
    transition:
      transform 0.45s var(--ease-sw),
      border-color 0.3s ease,
      box-shadow 0.45s var(--ease-sw);
  }

  .post:hover {
    transform: translateY(-4px);
    border-color: var(--color-border-strong);
    box-shadow: 0 18px 40px -24px rgb(12 16 22 / 0.28);
  }

  .post:focus-visible {
    outline: 2px solid var(--hero-accent, #7c3aed);
    outline-offset: 4px;
  }

  /* Full-bleed across the top of the card, cancelling its padding. */
  .post :global(.post__cover) {
    display: block;
    width: calc(100% + 2 * clamp(28px, 3.4vw, 48px));
    max-width: none;
    margin: calc(-1 * clamp(28px, 3.4vw, 48px)) calc(-1 * clamp(28px, 3.4vw, 48px)) 28px;
    border-radius: 13px 13px 0 0;
  }

  .post__title {
    margin: 18px 0 0;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: clamp(1.6rem, 2.6vw, 2.4rem);
    line-height: 1.06;
    letter-spacing: var(--display-tracking);
    text-transform: var(--display-case);
    text-wrap: balance;
  }

  .post__line {
    margin: 16px 0 0;
    max-width: 52ch;
    color: var(--color-foreground-secondary);
    font-size: 17px;
    line-height: 1.55;
  }

  /* Pinned to the foot, so two cards of different lengths line up. */
  .post__more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    padding-top: 28px;
    font-weight: 500;
    font-size: 15px;
    transition: color 0.25s ease;
  }

  .post__more :global(svg) {
    width: 16px;
    height: 16px;
    transition: transform 0.35s var(--ease-sw);
  }

  .post:hover .post__more {
    color: var(--hero-accent, #7c3aed);
  }

  .post:hover .post__more :global(svg) {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .post,
    .post__more :global(svg) {
      transition: none;
    }

    .post:hover {
      transform: none;
    }
  }
</style>
