---
/**
 * FeaturedPosts
 *
 * Up to four posts from the blog on the homepage, as cards beside each
 * other: date, title, line, and a "Read the post" cue that turns violet on
 * hover. Which posts: those marked `featured: true` in their frontmatter
 * first, newest first, then the newest of the rest. A post marked
 * `pinned: true` stays first. Shares the giant-title
 * header with the craft and projects sections, and ends on a link to the
 * whole blog.
 */
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import SectionHead from '@/components/sections/SectionHead.astro';
import PillButton from '@/components/site/PillButton.astro';
import PostCard from '@/components/blog/PostCard.astro';

interface Props {
  /** How many posts to show: one to four. */
  count?: 1 | 2 | 3 | 4;
}

const { count = 3 } = Astro.props;

const posts = (
  await getCollection('blog', ({ data }) => (import.meta.env.PROD ? data.draft !== true : true))
)
  .filter((post) => post.data.locale === 'en')
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const featured = posts.filter((post) => post.data.featured);
// A post marked `pinned: true` comes first, before the newest.
const shown = [...featured, ...posts.filter((post) => !post.data.featured)]
  .toSorted((a, b) => Number(b.data.pinned) - Number(a.data.pinned))
  .slice(0, count);

import { home } from '@/config/theme.config';
---

{
  shown.length > 0 && (
    <section class="pt-[130px] max-[800px]:pt-[90px]">
      <div class="shell">
        <SectionHead
          title={home.blog.title}
          blurb={home.blog.blurb}
        />

        <ul
          class:list={[
            'posts m-0 mt-14 list-none p-0 max-[800px]:mt-10',
            shown.length === 1 && 'posts--single',
            shown.length === 3 && 'posts--three',
            shown.length === 4 && 'posts--four',
          ]}
        >
          {shown.map((post, i) => (
            <li data-reveal data-reveal-delay={i * 0.1}>
              <PostCard post={post} compact={shown.length > 1} />
            </li>
          ))}
        </ul>

        <div class="mt-14 flex justify-center max-[800px]:mt-10" data-reveal>
          <PillButton href="/blog" variant="outline" class="px-9 py-4">
            All posts
            <Icon name="lucide:arrow-right" aria-hidden="true" />
          </PillButton>
        </div>
      </div>
    </section>
  )
}

<style>
  .posts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .posts--single {
    grid-template-columns: minmax(0, 1fr);
  }

  /* Three cards at the related posts' width (BlogLayout: max-w-6xl less its
     px-6 padding), centred: on the full width the cards, and the icon and
     word in their pictures, grew a quarter larger than everywhere else. */
  .posts--three {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    max-width: calc(72rem - 48px);
    margin-inline: auto;
  }

  /* Two or three posts use the compact card, as the related posts under a
     post do, so three fit beside each other down to 900px; below that they
     stack, as on a phone. */
  @media (max-width: 900px) {
    .posts--three {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Four cards across the full width, in line with the project grid above
     (Hans's choice); two by two from tablet landscape down, one on a phone. */
  .posts--four {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  @media (max-width: 1179px) {
    .posts--four {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 800px) {
    .posts {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
