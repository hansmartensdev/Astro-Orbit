---
/**
 * Services
 *
 * The cards from services.config as a list of rows, one open at a time.
 * A closed row is its number, its title, the first paragraph (wider than
 * 800px) and a plus; the open row adds its icon, tags, the rest of the
 * text and the link, and turns the brand colour.
 *
 * The rows are <details> sharing one `name`, so the browser opens one and
 * closes the others, with the keyboard and with a screen reader, without a
 * script. Where the browser can animate `::details-content`, a row opens
 * and closes with a short height transition; elsewhere it opens at once.
 * Under reduced motion the global rule in global.css finishes it instantly.
 *
 * On a phone the section is about one screen: four titles, with the open
 * row's text under it.
 */
import SectionHead from './SectionHead.astro';
import { lucideBody } from '@/lib/og';
import { services as section } from '@/config/services.config';

const services = section.cards;

// Text is plain text from the config, escaped, with [text](url) turned into
// a link.
const escape = (t: string) =>
  t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const withLinks = (t: string) =>
  escape(t).replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, '<a class="svc__inline-link" href="$2">$1</a>');
const plus = lucideBody('plus');
---

<section class="svc shell pt-[130px] max-[800px]:pt-[90px]">
  <SectionHead title={section.title} blurb={section.blurb} id="services" class="mb-14 max-[800px]:mb-9" />

  <div class="svc__list" data-reveal>
    {
      services.map((service, i) => {
        const paras = [service.desc].flat();
        return (
          <details class="svc__row" name="services" open={i === 0}>
            <summary class="svc__sum">
              <span class="svc__num label-mono">{service.num}</span>
              <h3 class="svc__title display-service m-0">{service.title.join(' ')}</h3>
              {/* Wider than 800px: the first paragraph beside the title. */}
              <span class="svc__lede" set:html={withLinks(paras[0])} />
              <span class="svc__go" aria-hidden="true">
                <svg viewBox="0 0 24 24" set:html={plus} />
              </span>
            </summary>
            <div class="svc__body">
              <div class="svc__inner">
                <div class="svc__meta">
                  <svg
                    class="svc__icon"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    set:html={lucideBody(service.icon)}
                  />
                  <ul class="svc__tags" role="list">
                    {service.tags.map((tag) => (
                      <li class="svc__tag">{tag}</li>
                    ))}
                  </ul>
                </div>
                <div class="svc__text">
                  {paras.map((para, p) => (
                    <p class:list={['svc__p', p === 0 && 'svc__p--lede']} set:html={withLinks(para)} />
                  ))}
                  {service.link && (
                    <a class="svc__link" href={service.link.href}>
                      {service.link.label}
                      <span aria-hidden="true">→</span>
                    </a>
                  )}
                </div>
              </div>
            </div>
          </details>
        );
      })
    }
  </div>
</section>

<style>
  .svc {
    /* The open row's tint reaches past the shell to the page's edges; clip
       it there so the page never scrolls sideways. */
    overflow-x: clip;
    interpolate-size: allow-keywords;
    --svc-accent: var(--orbit-text);
    --svc-tint: color-mix(in oklab, var(--orbit-fill) 9%, transparent);
  }
  :global(.dark) .svc {
    --svc-accent: var(--orbit-on-dark);
    --svc-tint: color-mix(in oklab, var(--orbit-fill) 16%, transparent);
  }

  .svc__list {
    isolation: isolate;
    border-top: 1px solid var(--border);
  }

  .svc__row {
    position: relative;
    border-bottom: 1px solid var(--border);
  }
  /* The open row's tint runs to the edges of the page, past the shell. */
  .svc__row::before {
    content: '';
    position: absolute;
    inset: 0 calc(50% - 50vw);
    z-index: -1;
    background: linear-gradient(90deg, transparent, var(--svc-tint) 40%, var(--svc-tint));
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .svc__row[open]::before {
    opacity: 1;
  }

  /* Opening and closing, where the browser can animate the content. */
  .svc__row::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      content-visibility 0.45s allow-discrete;
  }
  .svc__row[open]::details-content {
    block-size: auto;
  }

  .svc__sum {
    display: grid;
    grid-template-columns: 70px minmax(0, 1fr) minmax(0, 430px) 52px;
    align-items: center;
    gap: 32px;
    padding: 34px 0;
    cursor: pointer;
    list-style: none;
  }
  .svc__sum::-webkit-details-marker {
    display: none;
  }
  .svc__sum:focus-visible {
    outline: 2px solid var(--svc-accent);
    outline-offset: 4px;
    border-radius: 6px;
  }

  .svc__num {
    color: var(--foreground-muted);
  }

  .svc__title {
    transition: color 0.3s ease;
  }
  .svc__row[open] .svc__title,
  .svc__sum:hover .svc__title {
    color: var(--svc-accent);
  }

  .svc__lede {
    color: var(--foreground-secondary);
    font-size: 16px;
    line-height: 1.55;
  }

  .svc__go {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    color: var(--foreground);
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease,
      color 0.3s ease,
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .svc__go svg {
    width: 22px;
    height: 22px;
  }
  .svc__row[open] .svc__go {
    background: var(--orbit-fill);
    border-color: var(--orbit-fill);
    color: #fff;
    transform: rotate(45deg);
  }

  .svc__inner {
    display: grid;
    grid-template-columns: 70px minmax(0, 1fr) minmax(0, 430px) 52px;
    gap: 32px;
    padding: 0 0 38px;
  }
  .svc__meta {
    grid-column: 2;
    display: flex;
    align-items: flex-start;
    gap: 18px;
  }
  .svc__text {
    grid-column: 3;
  }

  .svc__icon {
    flex: none;
    width: 52px;
    height: 52px;
    padding: 13px;
    border-radius: 14px;
    background: var(--orbit-fill);
    color: #fff;
  }

  .svc__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .svc__tag {
    padding: 8px 14px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    font-size: 13px;
    line-height: 1;
    color: var(--foreground);
  }

  .svc__p {
    margin: 0 0 14px;
    color: var(--foreground-secondary);
    font-size: 16px;
    line-height: 1.6;
  }
  /* Wider than 800px the first paragraph is already beside the title. */
  .svc__p--lede {
    display: none;
  }
  .svc__text :global(.svc__inline-link),
  .svc__lede :global(.svc__inline-link) {
    color: inherit;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
  }

  .svc__link {
    display: inline-flex;
    gap: 6px;
    margin-top: 4px;
    font-weight: 600;
    color: var(--svc-accent);
  }

  @media (max-width: 800px) {
    .svc__sum {
      grid-template-columns: 30px minmax(0, 1fr) 40px;
      gap: 12px;
      padding: 22px 0;
    }
    .svc__lede {
      display: none;
    }
    .svc__go {
      width: 40px;
      height: 40px;
    }
    .svc__go svg {
      width: 18px;
      height: 18px;
    }
    .svc__inner {
      grid-template-columns: 30px minmax(0, 1fr);
      gap: 18px 12px;
      padding-bottom: 26px;
    }
    .svc__meta,
    .svc__text {
      grid-column: 2;
    }
    .svc__icon {
      width: 42px;
      height: 42px;
      padding: 10px;
      border-radius: 12px;
    }
    .svc__p--lede {
      display: block;
    }
    .svc__p {
      font-size: 15px;
    }
  }
</style>
