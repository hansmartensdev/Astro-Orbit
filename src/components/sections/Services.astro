---
/**
 * Services
 *
 * The cards from services.config, piling up as you scroll: each sticks 20px lower than the one
 * before it, so the stack stays legible instead of the cards scrolling past
 * one another.
 *
 * Two motions on top of the stacking:
 *
 *   entrance  each card rises and fades in as one unit, via the site's
 *             [data-reveal] system (on the slot, so it never fights the
 *             recede, which transforms the card itself).
 *   recede    as the next card slides up to cover it, the card underneath
 *             eases back — scroll-linked, via a view timeline on
 *             the *next* card. `timeline-scope` on the section lets card N
 *             read card N+1's timeline. Browsers without it keep the static
 *             depth from translateZ and nothing else.
 */
import SectionHead from './SectionHead.astro';
import { lucideBody } from '@/lib/og';
import { services as section } from '@/config/services.config';

// The title, the line beside it and the cards all come from services.config
// show: false there leaves the section off the homepage.
const services = section.cards;
const bare = false;

const last = services.length - 1;

// Card text is plain text from the config, escaped, with [text](url) turned
// into a link.
const escape = (t: string) =>
  t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const withLinks = (t: string) =>
  escape(t).replace(
    /\[([^\]]+)\]\(([^)\s]+)\)/g,
    '<a class="service__inline-link" href="$2">$1</a>'
  );
// One named timeline per covering card (every card but the first).
const timelineScope = services
  .slice(1)
  .map((_, i) => `--svc-${i + 1}`)
  .join(', ');
---

<section
  class:list={[bare ? 'services--bare' : 'pt-[130px] max-[800px]:pt-[90px]']}
  style={`timeline-scope: ${timelineScope}`}
>
  {
    !bare && (
      <div class="shell mb-14">
        <SectionHead
          title={section.title}
          blurb={section.blurb}
          id="services"
        />
      </div>
    )
  }

  {
    services.map((service, i) => (
      <div
        class:list={['services__slot', !bare && 'shell']}
        data-reveal
        style={
          '--sticky-top:' +
          (bare ? `calc(var(--sw-nav-h, 76px) + ${24 + i * 16}px)` : `${90 + i * 20}px`) +
          '; --i:' +
          i +
          (i > 0 ? `; view-timeline-name: --svc-${i}` : '')
        }
      >
        <article
          class:list={['service', i < last && 'service--covered']}
          style={
            `--card-bg: var(--orbit-card-${(i % 4) + 1})` +
            (i < last ? `; animation-timeline: --svc-${i + 1}` : '')
          }
        >
          <div class="service__lead">
            <span class="service__num label-mono">{service.num}</span>
            <div class="service__head">
              {/* Inline from Lucide's data, with the thin line of the blog
                  header's icon. */}
              <svg
                class="service__icon"
                viewBox="0 0 24 24"
                aria-hidden="true"
                set:html={lucideBody(service.icon)?.replace(
                  /stroke-width="2"/g,
                  'stroke-width="1.25"'
                )}
              />
              <h3 class="service__title display-service m-0">
                {service.title.map((line) => (
                  <span class="block">{line}</span>
                ))}
              </h3>
              {/* Desktop: the tags under the title. */}
              <div class="service__tags service__tags--lead">
                {service.tags.map((tag) => (
                  <span class="service__tag">{tag}</span>
                ))}
              </div>
            </div>
          </div>

          <div class="service__detail">
            {/* Phone: the tags above the text. */}
            <div class="service__tags service__tags--detail">
              {service.tags.map((tag) => (
                <span class="service__tag">{tag}</span>
              ))}
            </div>
            <div class="service__body">
              {[service.desc].flat().map((para) => (
                <p class="service__desc" set:html={withLinks(para)} />
              ))}
              {service.link && (
                <a class="service__link" href={service.link.href}>
                  {service.link.label}
                  <span aria-hidden="true">→</span>
                </a>
              )}
            </div>
          </div>
        </article>
      </div>
    ))
  }
</section>

<style>
  /* Where the cards stack (wider than 800px), a card fading in over the one
     below would show that card's text through it. There each card glides up
     fully opaque, like a card dealt onto the pile; on phones, where nothing
     stacks, it rises and fades like every other arrival. */
  @media (min-width: 801px) {
    :global(html.js .services__slot[data-reveal]:not(.is-in)) {
      opacity: 1;
    }
  }

  .services__slot {
    position: sticky;
    top: var(--sticky-top);
    margin-bottom: 28px;
    /* Perspective per slot rather than one on the section: a single shared
       vanishing point would skew the cards further from centre. */
    perspective: 1600px;
  }

  .service {
    position: relative;
    /* Cards that get covered sit further back, so the 20px slivers showing
       above the top card read as a stack with depth rather than four flat
       sheets of paper. The last card is the front of the pile, at Z 0. */
    transform: translateZ(calc((var(--i, 0) - 3) * 26px));
    /* Keeps the grain's blend mode working the card and nothing behind it. */
    isolation: isolate;
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 60px;
    min-height: 62vh;
    padding: 56px 60px;
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-xl);
    box-shadow: 0 -12px 40px rgb(12 16 22 / 0.1);
    color: #fff;
    --card-chip: rgb(255 255 255 / 0.35);

    /* Each card its own shade of the brand colour, one step deeper per card
       (--orbit-card-1..4 from lib/brand.ts, deeper again in dark mode), so
       the pile reads as four cards. Within the card the shade deepens towards
       the foot. Both ends are dark enough for white text at 4.5:1 or more. */
    background-color: var(--card-bg);
    background-image: linear-gradient(
      to bottom,
      var(--card-bg),
      color-mix(in srgb, var(--card-bg) 72%, var(--orbit-950))
    );
  }

  /* The grid of the theme's other brand surfaces (the demo band, the blog
     cards), fading towards the edges. */
  .service::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    pointer-events: none;
    background-image:
      linear-gradient(to right, rgb(255 255 255 / 0.08) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(255 255 255 / 0.08) 1px, transparent 1px);
    background-size: 48px 48px;
    -webkit-mask-image: radial-gradient(ellipse at center, #000 35%, transparent 100%);
    mask-image: radial-gradient(ellipse at center, #000 35%, transparent 100%);
  }

  /* Grain. soft-light keeps it tonal — it never blows out the white ground or
     muddies the ink one, so a single layer serves both colour schemes. */
  .service::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    background-image: var(--sw-grain);
    background-size: 180px 180px;
    opacity: 0;
    mix-blend-mode: soft-light;
    pointer-events: none;
  }

  /* Content rides above the grain. */
  .service__lead,
  .service__detail {
    position: relative;
    z-index: 1;
  }

  /* --- recede ------------------------------------------------------------
     The card underneath eases back a touch as the next one covers it. No
     shadow: a darkening card under a sliding one read as a glitch. */
  /* The timeline itself is set inline per card (animation-timeline:
     --svc-N). The range is card N+1's travel from the bottom of the viewport
     up to where it sticks. In lengths, not percentages: a sticky subject's
     view range is stretched by its whole sticky travel, which is different
     for every card, so a percentage would land somewhere else on each. */
  @supports (timeline-scope: --a) {
    .service--covered {
      animation: svc-recede linear both;
      animation-range: cover 40px cover calc(100vh - 130px);
    }
  }

  @keyframes svc-recede {
    to {
      transform: translateZ(calc((var(--i, 0) - 3) * 26px)) translateY(-14px) scale(0.965);
    }
  }

  /* Colourways come from the component tier in themes/southwell.css, so all
     four grounds — glows and grain included — re-map themselves in dark mode. */




  .service__lead {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 40px;
  }

  .service__num {
    font-size: 14px;
    opacity: 0.55;
  }

  .service__detail {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 28px;
  }

  /* Title and its tags (and, on desktop, the icon above them) sit together
     at the foot of the left column, level with the end of the text. */
  .service__head {
    display: flex;
    flex-direction: column;
  }

  .service__icon {
    width: clamp(56px, 5vw, 76px);
    height: clamp(56px, 5vw, 76px);
    margin-bottom: 28px;
    opacity: 0.85;
  }

  .service__tags--lead {
    margin-top: 24px;
  }

  .service__body {
    display: flex;
    flex-direction: column;
    gap: 0.85em;
  }

  .service__tags.service__tags--detail {
    display: none;
  }

  /* A link inside the text: the card's own colour, underlined, so it reads
     as a link on every card colour. */
  .service__desc :global(.service__inline-link) {
    color: inherit;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
  }

  .service__desc :global(.service__inline-link:hover) {
    text-decoration-thickness: 2.5px;
  }

  /* A link under the text, in the card's own colour, underlined. */
  .service__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
    margin-top: 6px;
    font-size: 16px;
    font-weight: 600;
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 4px;
  }

  .service__link span {
    transition: transform 0.3s var(--ease-sw, ease);
  }

  .service__link:hover span {
    transform: translateX(4px);
  }

  .service__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .service__tag {
    padding: 8px 16px;
    border: 1.5px solid var(--card-chip);
    border-radius: var(--radius-full);
    font-size: 14px;
    font-weight: 500;
  }

  .service__desc {
    margin: 0;
    font-size: 17px;
    line-height: 1.65;
    opacity: 0.88;
  }

  @media (max-width: 1000px) {
    .service {
      gap: 36px;
      padding: 40px 36px;
    }
  }

  /* --- bare: the pile on a project page -------------------------------
     The same cards and the same stacking, at the size of a picture in the
     case-study column: smaller type, padding and icon, and no fixed height,
     so each card is as tall as its text. */
  .services--bare .services__slot {
    margin-bottom: 16px;
  }

  .services--bare .service {
    min-height: 0;
    gap: 32px;
    padding: 32px 36px;
    border-radius: var(--radius-lg);
  }

  .services--bare .service__lead {
    gap: 20px;
  }

  .services--bare .service__title {
    font-size: clamp(30px, 3vw, 44px);
  }

  .services--bare .service__icon {
    width: 40px;
    height: 40px;
    margin-bottom: 16px;
  }

  .services--bare .service__tags--lead {
    margin-top: 16px;
  }

  .services--bare .service__tag {
    padding: 5px 11px;
    font-size: 12px;
  }

  .services--bare .service__desc {
    font-size: 14px;
    line-height: 1.6;
  }

  .services--bare .service__link {
    font-size: 14px;
  }

  @media (max-width: 800px) {
    .services__slot {
      /* A card taller than the viewport cannot stack cleanly on a phone —
         let them scroll normally instead. */
      position: static;
      margin-bottom: 20px;
      perspective: none;
    }

    .service {
      /* Nothing is stacking, so nothing should be receding. */
      transform: none;
      animation: none;
      grid-template-columns: 1fr;
      gap: 32px;
      min-height: 0;
      padding: 36px 28px;
    }

    .service::after {
      display: none;
    }

    .service__lead {
      gap: 24px;
    }

    /* One column: no icon, and the tags above the text. */
    .service__icon,
    .service__tags.service__tags--lead {
      display: none;
    }

    .service__tags.service__tags--detail {
      display: flex;
    }

    .service__desc {
      font-size: 16px;
    }
  }
</style>
