---
/**
 * Cta
 *
 * The sign-off: the headline and the two buttons on a textured field.
 *
 * The field is the light colourway of the service cards — two soft blooms
 * lit from opposite corners, grain over the top — run full-bleed behind the
 * section, with the wordmark blown up and nearly transparent behind the
 * headline. It gives the sign-off a surface of its own between the ink
 * founder card above and the ink footer below, without adding an object the
 * type has to negotiate with.
 *
 * "Start a conversation" goes to the contact page.
 */
import siteConfig from '@/config/site.config';
import ArrowFillButton from '@/components/site/ArrowFillButton.astro';
---

<section class="cta relative overflow-hidden">
  <div class="cta__field" aria-hidden="true">
    <span class="cta__watermark display-mark">{siteConfig.mark}</span>
  </div>

  <div
    data-reveal
    class="shell relative flex flex-col items-center pt-[130px] pb-[130px] max-[800px]:pt-[100px] max-[800px]:pb-[100px]"
  >
    <h2 class="cta__title display-section m-0 text-center">
      <span class="block">Let&rsquo;s talk</span>
      <span class="block"><em>Astro.</em></span>
    </h2>

    <p
      class="text-foreground-secondary m-0 mt-6 max-w-[440px] text-center text-[18px] leading-[1.55] max-[800px]:mt-5 max-[800px]:text-base"
    >
      A question about Astro, one of my themes or a blog post? I read and answer every message
      myself.
    </p>

    <div class="mt-10 flex flex-wrap justify-center gap-[18px] max-[800px]:mt-8">
      <ArrowFillButton href="/contact" icon="fa6-solid:envelope"
        >Start a conversation</ArrowFillButton
      >
      {/* Messages, not meetings: WhatsApp opens a chat with Hans. */}
      <ArrowFillButton
        href={siteConfig.whatsapp}
        target="_blank"
        icon="fa6-brands:whatsapp"
        variant="outline">WhatsApp me</ArrowFillButton
      >
    </div>
  </div>
</section>

<style>
  .cta {
    isolation: isolate;
  }

  /* Two soft violet blooms and grain over the page (the values the first
     service card had, before that section was removed). Dark mode leaves
     the field out (below). */
  .cta__field {
    --service-white-glow-a: color-mix(in srgb, var(--orbit-600) 16%, transparent);
    --service-white-glow-b: color-mix(in srgb, var(--orbit-400) 14%, transparent);
    --service-white-light: 12% 6%;
    --service-white-light-b: 88% 96%;
    --service-white-grain: 0.5;
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.55;
    background-image:
      radial-gradient(
        70% 90% at var(--service-white-light),
        var(--service-white-glow-a),
        transparent 62%
      ),
      radial-gradient(
        60% 80% at var(--service-white-light-b),
        var(--service-white-glow-b),
        transparent 68%
      );
    /* No edges: the field grows out of the page ground and dissolves again
       before the footer, so it never reads as a band. */
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      #000 42%,
      #000 78%,
      transparent 100%
    );
    mask-image: linear-gradient(to bottom, transparent 0%, #000 42%, #000 78%, transparent 100%);
  }

  .cta__field::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--sw-grain);
    background-size: 180px 180px;
    opacity: var(--service-white-grain, 0.5);
    mix-blend-mode: soft-light;
    pointer-events: none;
  }

  /* The wordmark as a watermark: huge, centred a little above the headline,
     and only just there. */
  .cta__watermark {
    position: absolute;
    left: 50%;
    top: 46%;
    font-size: clamp(240px, 36vw, 560px);
    line-height: 1;
    /* The template's own watermark: the text colour at 6%, so it is
       neutral in both modes (Hans's choice; it was a violet gradient). */
    color: var(--color-foreground);
    opacity: 0.06;
    transform: translate(-50%, -50%);
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
  }

  /* Dark mode. The service-card tokens the field borrows go blue-grey on
     ink, and their heavy grain turns into grey static there. On ink the
     field is left out: the sign-off sits on the plain neutral page (Hans's
     choice; it had a violet glow at the lower left). */
  :global(.dark) .cta__field {
    background-image: none;
  }

  /* No grain on ink: even faint, it showed as grey-green speckle. */
  :global(.dark) .cta__field::after {
    display: none;
  }

  /* On a phone the sign-off takes the page-title size (as on /contact,
     where the same words are the title), not the smaller section-head
     size: alone and centred between the big watermark and the
     full-width buttons, the section size read as small. */
  @media (max-width: 800px) {
    .cta__title {
      font-size: clamp(38px, 11.2vw, 52px);
    }
  }

  @media (max-width: 800px) {
    .cta__watermark {
      font-size: 64vw;
      opacity: 0.07;
    }
  }
</style>
