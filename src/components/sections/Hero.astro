---
/**
 * Hero
 *
 * A panel with the headline overlapping its lower edge, and a staggered
 * load-in: the panel settles, each headline line rises out of its mask, then
 * the foot follows. The sequence lives in src/scripts/motion/hero.ts; the
 * stylesheet only holds the pre-animation state, behind `html.js`.
 *
 * The panel is HeroVisual — CSS, not an image. Client work does not belong
 * here; the first thing on the page has to carry the studio's own brand.
 * Setting the treatment to `none` removes the panel entirely and lets the type
 * carry the page, which is a legitimate answer rather than a fallback.
 *
 * HeroScene ("Clarity in Chaos") is slotted into the panel: an interactive
 * WebGL rod field that resolves into order around the cursor. It hydrates on
 * idle so it never competes with the type for the first paint; the CSS
 * treatments underneath are the no-JS / pre-hydration state.
 */
import HeroVisual from '@/components/site/HeroVisual.astro';
import HeroScene from '@/components/site/HeroScene.astro';
import { getImage } from 'astro:assets';
import heroPoster from '@/assets/hero-poster.png';
import heroPosterDark from '@/assets/hero-poster-dark.png';
import heroPosterPhone from '@/assets/hero-poster-phone.png';
import heroPosterPhoneDark from '@/assets/hero-poster-phone-dark.png';

// Stills of the scene, captured from the live 3D at full quality: wide for
// the desktop panel, near-square for a phone's, each in light and in dark
// (the dark scene is a light slab in a dark studio). The page shows the one
// that matches; a device without a graphics chip keeps it as the hero.
const wide = { widths: [640, 960, 1336, 2000, 2672], format: 'webp' as const, quality: 82 };
const tall = { widths: [400, 800, 1146], format: 'webp' as const, quality: 82 };
const posters = await Promise.all(
  [
    { tone: 'light', desktop: heroPoster, phone: heroPosterPhone },
    { tone: 'dark', desktop: heroPosterDark, phone: heroPosterPhoneDark },
  ].map(async ({ tone, desktop, phone }) => ({
    tone,
    desktop: await getImage({ src: desktop, ...wide }),
    phone: await getImage({ src: phone, ...tall }),
  }))
);
---

<section class="hero shell flex min-h-screen flex-col justify-end pt-24 pb-9 max-[700px]:pt-[84px] min-[701px]:pb-6">
  {
    /* On a phone the content is shorter than the screen, and with the column
      bottom-aligned the slack would sit as a gap under the nav; the panel
      grows to take it instead, never shorter than 42vh. */
  }
  <HeroVisual
    class="hero__render h-[58vh] max-[700px]:h-auto max-[700px]:min-h-[42vh] max-[700px]:flex-1"
  >
    {
      /* A still of the scene, there from the first paint: the live scene
        fades in over it once it runs, and devices without a graphics chip
        keep it (see scripts/gpu.ts). Decorative, like the panel itself. */
    }
    {
      posters.map(({ tone, desktop, phone }) => (
        <picture class:list={['hero__poster-pic', `hero__poster-pic--${tone}`]}>
          <source
            media="(max-width: 700px)"
            srcset={phone.srcSet.attribute}
            sizes="calc(100vw - 48px)"
            type="image/webp"
          />
          {/* Dark is the first paint (dark first on arrival), so it loads at
              once; the light still only loads once light mode shows it. */}
          <img
            src={desktop.src}
            srcset={desktop.srcSet.attribute}
            sizes="calc(100vw - 96px)"
            alt=""
            width={desktop.attributes.width}
            height={desktop.attributes.height}
            loading={tone === 'dark' ? 'eager' : 'lazy'}
            fetchpriority={tone === 'dark' ? 'high' : 'auto'}
            decoding="async"
            class="hero__poster"
          />
        </picture>
      ))
    }
    <HeroScene />
    {
      /* The panel dissolves into the page along its lower edge rather than
        ending in a hard line behind the headline. A painted gradient in the
        page colour, not a mask: masking a container with a live WebGL canvas
        inside costs a compositing pass every frame. */
    }
    <div class="hero__fade" aria-hidden="true"></div>
  </HeroVisual>

  <h1 class="hero__headline display-hero">
    <span class="hero__line"
      ><span class="hero__word hero__word--1">An Astro developer</span></span
    >
    <span class="hero__line"
      ><span class="hero__word hero__word--2"
        ><em>building <span class="hero__accent">beautiful</span> websites.</em>{
          /* A zero-size inline-block sat on the baseline: the reel's droplet
            lands on this line, and reads where the baseline is from here. */
        }<span class="hero__baseline" aria-hidden="true"></span></span
      ></span
    >
  </h1>

  <div class="hero__foot mt-9 flex items-end justify-between gap-10 min-[701px]:mt-6">
    <p class="text-foreground-secondary m-0 max-w-[440px] text-[17px] leading-[1.6]">
      I'm <span class="whitespace-nowrap">Hans Martens</span>, an Astro developer in Veghel, the
      Netherlands. I build fast, secure, high-quality websites that get found on Google and by
      AI assistants.
    </p>

    <div class="hero__scroll" aria-hidden="true">
      Scroll
      <span class="hero__scroll-line"></span>
    </div>
  </div>
</section>

<style>
  /* One still at a time: light, or dark under .dark. */
  .hero__poster-pic {
    display: contents;
  }

  .hero__poster-pic--dark,
  :global(.dark) .hero__poster-pic--light {
    display: none;
  }

  :global(.dark) .hero__poster-pic--dark {
    display: contents;
  }

  .hero__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero {
    position: relative;
    /* The headline is sized in container units off this box, so it is one
       line per row at every width. Inline-size containment only; the section
       still grows to its content vertically. */
    container-type: inline-size;
    /* Art direction for the WebGL scene lives here as --hero-* custom
       properties (see scripts/hero-scene.ts for every hook). Unset, the scene is
       monochrome from the theme greys with a neutral studio light. */
    --hero-warm: #ffffff;
    --hero-cool: #f4f7fa;
  }

  .hero__render {
    /* Set to `none` by the treatment token, which collapses the panel and
       leaves a type-only hero. */
    display: var(--hero-panel-display, block);
    transform-origin: 50% 80%;
  }

  /* Desktop and tablet: the hero is one screen tall, so the headline, the
     whole intro and the scroll cue are in view on arrival, 24px above the
     bottom edge. The 3D panel takes all the height they leave, starting
     just under the header on every screen (up to 75% of it, for very tall
     windows): on a 1440x900 screen about 60%, on a short laptop a little
     less (Hans's choice). Phones keep their own sizing. */
  @media (min-width: 701px) {
    .hero {
      height: 100svh;
      min-height: 600px;
    }

    /* The panel is HeroVisual's own element, outside this file's scope. */
    .hero :global(.hero__render) {
      flex: 1 1 auto;
      height: auto;
      max-height: 75vh;
      min-height: 240px;
    }
  }

  /* Pre-animation state. Motion writes its first keyframe inline, and inline
     beats these, so there is never a frame of the finished layout before the
     entrance. Without JS the class is absent and everything simply shows. */
  :global(html.js) .hero__render,
  :global(html.js) .hero__foot {
    opacity: 0;
  }

  :global(html.js) .hero__word {
    transform: translateY(112%);
  }

  /* The headline rides up over the panel rather than sitting under it. When
     there is no panel it needs no overlap, so the pull-up is a token too. */
  .hero__headline {
    position: relative;
    /* A flex column, not a block: each .hero__line below carries a negative
       margin that must cancel its own mask padding exactly. Block siblings
       collapse adjoining negative margins to the MOST negative one, not the
       sum, which leaked 0.12em of air between the two lines. Flex items never
       collapse margins. */
    display: flex;
    flex-direction: column;
    margin: var(--hero-headline-pull, -0.52em) 0 0;
    /* Tighter than .display-hero's 0.93: this pair is lowercase, and line one
       has no descenders, so the space under it reads as a gap. One token in
       themes/southwell.css. */
    line-height: var(--hero-leading, 0.88);
    /* Sized to the shell, not the viewport: the second line is about 12.4em
       of light Outfit at this tracking, and 7.7cqi puts it at roughly 95% of
       the container's width at every size — one row per line on a phone as
       well as on a 1440px shell. The shell caps at 1440px, so this caps
       itself. */
    font-size: 7.7cqi;
  }

  /* Below about 1000px, one row per line at 7.7cqi would make the page's H1
     smaller than the H2s under it (about 26px on a 390px phone). So the
     headline never goes below the size at which "an astro developer" fills
     about 90% of one row: that line is 8.14em wide and the headline gets
     100vw - 56px, so dividing by 9 leaves clear air before the panel's edge
     instead of running into it (29px at 320, 37px at 390, 42px at 430,
     capped at 64px). Where that is the larger value the
     second line wraps — balanced, so into even rows rather than leaving a
     word alone. The droplet still lands at the end of the second line: its
     marker rides the wrap. */
  .hero__headline {
    font-size: max(7.7cqi, min(calc((100vw - 56px) / 9), 64px));
  }

  /* The promise in the brand violet: the two words that say what Hans
     builds. Large text, so this violet passes contrast comfortably. */
  .hero__accent {
    color: var(--hero-accent, #7c3aed);
  }

  /* A step lighter on the dark page (Hans's choice): violet-500. */
  :global(.dark) .hero__accent {
    color: #8b5cf6;
  }

  .hero__word--2 {
    text-wrap: balance;
  }

  /* Phones: larger (Hans's choice). "an astro developer" fills about 97%
     of the row instead of 90%: 42px on a 393px iPhone, 33px at 320. */
  @media (max-width: 700px) {
    .hero__headline {
      line-height: 1.04;
      font-size: min(calc((100vw - 56px) / 8), 64px);
    }
  }

  /* Each line masks its word so it rises out from behind the line above.
     A line-height under 1 makes the line box SHORTER than the glyphs, so the
     mask has to be padded out vertically or it shears the ascenders and
     descenders off — the negative margins put the layout back exactly where
     it was (see the flex note on .hero__headline). 0.2em covers the p in
     "apps" at 0.88 leading with room to spare. */
  .hero__line {
    display: block;
    overflow: hidden;
    padding-block: 0.2em;
    margin-block: -0.2em;
  }

  /* The words rise inside their masks and nowhere else: the mask is a tight
     box tuned to this line-height, so anything but a flat vertical travel
     would shear the glyphs against its edge. */
  .hero__word {
    display: block;
  }

  .hero__baseline {
    display: inline-block;
    width: 0;
    height: 0;
    vertical-align: baseline;
  }

  .hero__fade {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      transparent 38%,
      color-mix(in srgb, var(--color-background) 55%, transparent) 72%,
      var(--color-background) 100%
    );
  }

  .hero__scroll {
    display: flex;
    flex: none;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--color-foreground-muted);
  }

  .hero__scroll-line {
    display: block;
    width: 1.5px;
    height: 48px;
    background: var(--color-foreground);
    animation: sw-scrollpulse 1.8s ease-in-out infinite;
  }

  /* A phone held upright: the hero is the height of the screen that's visible
     when the page opens, with Safari's address bar showing (svh). The class's
     100vh is the height with the bar hidden, which put the end of the intro
     behind the bar on an iPhone. Desktop, tablet and landscape are unchanged. */
  @media (max-width: 700px) and (orientation: portrait) {
    .hero {
      min-height: 100svh;
    }
  }

  @media (max-width: 700px) {
    .hero__headline {
      margin-top: var(--hero-headline-pull-sm, -0.4em);
    }

    .hero__scroll {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__render,
    .hero__word,
    .hero__foot {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
