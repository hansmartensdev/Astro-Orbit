---
/**
 * PostFigure
 *
 * An image in a blog post, with an optional phone version: a wide picture
 * comes out small in a phone's narrow column, so `mobile` (composed for a
 * narrow screen) takes over up to 700px. The caption is the slot.
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  mobile?: ImageMetadata;
  alt: string;
  /** Where a click on the picture leads, e.g. the project it shows. */
  href?: string;
}

const { src, mobile, alt, href } = Astro.props;
const Wrap = href ? 'a' : 'div';

const wide = await getImage({ src, widths: [768, 1200, 1600, 2400], format: 'webp' });
const narrow = mobile ? await getImage({ src: mobile, widths: [600, 900, 1200], format: 'webp' }) : null;
const hasCaption = Astro.slots.has('default');
---

<figure class="pf not-prose">
  <Wrap class="pf__media" href={href}>
  <picture>
    {
      narrow && (
        <source media="(max-width: 700px)" srcset={narrow.srcSet.attribute} sizes="calc(100vw - 48px)" type="image/webp" />
      )
    }
    <img
      src={wide.src}
      srcset={wide.srcSet.attribute}
      sizes="(max-width: 900px) calc(100vw - 48px), 860px"
      alt={alt}
      width={src.width}
      height={src.height}
      loading="lazy"
      decoding="async"
    />
  </picture>
  </Wrap>
  {
    hasCaption && (
      <figcaption>
        <slot />
      </figcaption>
    )
  }
</figure>

<style>
  .pf {
    margin: 2.2em 0;
  }

  .pf img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 14px;
  }

  .pf figcaption {
    margin-top: 14px;
    font-size: 15px;
    font-style: italic;
    line-height: 1.5;
    color: var(--color-foreground-muted);
  }

  .pf__media {
    display: block;
    overflow: hidden;
    border-radius: 14px;
  }

  .pf__media img {
    transition: transform 0.6s var(--ease-sw, ease);
  }

  a.pf__media:hover img {
    transform: scale(1.02);
  }

  a.pf__media:focus-visible {
    outline: 2px solid var(--hero-accent, #7c3aed);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .pf__media img {
      transition: none;
    }
  }

  /* Same as links in the post's text: violet, with a violet underline. */
  .pf figcaption :global(a) {
    color: var(--hero-accent, #7c3aed);
    font-weight: 500;
    font-style: normal;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
    text-decoration-color: rgb(124 58 237 / 0.45);
  }

  .pf figcaption :global(a:hover) {
    text-decoration-color: var(--hero-accent, #7c3aed);
    text-decoration-thickness: 2.5px;
  }

  /* On ink: the violet made for ink, as in the post's text. */
  :global(.dark) .pf figcaption :global(a) {
    color: var(--hero-accent-on-ink, #a78bfa);
    text-decoration-color: rgb(167 139 250 / 0.45);
  }

  :global(.dark) .pf figcaption :global(a:hover) {
    text-decoration-color: var(--hero-accent-on-ink, #a78bfa);
  }
</style>
