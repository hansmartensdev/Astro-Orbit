---
/**
 * PostCover
 *
 * A post's cover inside a card link. On hover (or keyboard focus) of the
 * link, the image eases in a little. Nothing is laid over it: the card's own
 * "Read the post" line says where the link goes, and a veil and a pill on
 * the picture hid the picture. The image is the post's own (`src`), or else
 * its card art (CardArt: icon and word on the violet grid). It is
 * decorative, so it is hidden from screen readers.
 */
import CardArt from '@/components/blog/CardArt.astro';

interface Props {
  /** The post's own image. Without it the card art is drawn. */
  src?: string;
  /** What the card art needs: the post's slug, icon, tags and card word. */
  art?: { slug: string; icon?: string; tags?: string[]; word?: string };
  class?: string;
}

const { src, art, class: className } = Astro.props;
---

<span class:list={['pc', className]}>
  {
    src ? (
      <img class="pc__img" src={src} alt="" width="1200" height="630" loading="lazy" decoding="async" />
    ) : (
      art && (
        <span class="pc__img">
          <CardArt {...art} />
        </span>
      )
    )
  }
</span>

<style>
  .pc {
    position: relative;
    display: block;
    overflow: hidden;
    isolation: isolate;
  }

  .pc__img {
    display: block;
    overflow: hidden;
    width: 100%;
    height: auto;
    aspect-ratio: 1200 / 630;
    object-fit: cover;
    transition: transform 0.6s var(--ease-sw, ease);
  }

  :global(a:hover) .pc__img,
  :global(a:focus-visible) .pc__img {
    transform: scale(1.04);
  }

  @media (prefers-reduced-motion: reduce) {
    .pc__img {
      transition: none;
      transform: none !important;
    }
  }
</style>
