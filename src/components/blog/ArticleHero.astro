---
/**
 * ArticleHero
 *
 * The top of a blog post: an ink card with the violet glow, in the family of
 * the homepage's "What drives me" card. A mono label, the title in large
 * white type, the description, and an author row (hm/ avatar, name, date,
 * reading time) under a thin rule. The generated cover isn't repeated here
 * (it is the post's share image and its card in the lists); a post's own
 * photo, when it has one, sits under the card.
 */
import { Image } from 'astro:assets';
import { lucideBody } from '@/lib/og';
import type { ImageMetadata } from 'astro';
import { formatDate } from '@/lib/utils';
import siteConfig from '@/config/site.config';

interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  updatedAt?: Date;
  tags?: string[];
  image?: ImageMetadata;
  imageAlt?: string;
  /** The cover's Lucide icon, shown in the card's corner on wide screens. */
  icon?: string;
  /** Minutes, from the post's word count. */
  readingTime?: number;
}

const { title, description, publishedAt, updatedAt, tags = [], image, imageAlt, icon, readingTime } = Astro.props;

// Drawn inline from Lucide's data with thin lines, as on the cover.
const iconBody = icon ? lucideBody(icon)?.replace(/stroke-width="2"/g, 'stroke-width="1.25"') : undefined;

const label = ['Blog', tags[0]].filter(Boolean).join(' · ').toUpperCase();
---

<header class="ah">
  <div class="shell">
    <div class:list={['ah__card', iconBody && 'ah__card--icon']} data-reveal>
      {iconBody && <svg class="ah__icon" viewBox="0 0 24 24" aria-hidden="true" set:html={iconBody} />}
      <span class="label-mono ah__label">{label}</span>
      <h1 class="ah__title">{title}</h1>
      <p class="ah__desc">{description}</p>

      <div class="ah__meta">
        <span class="ah__avatar" aria-hidden="true">{siteConfig.mark}</span>
        <span class="ah__name">{siteConfig.name}</span>
        <span class="ah__facts">
          <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time>
          {
            updatedAt && (
              <>
                <span class="ah__dot" aria-hidden="true">·</span>
                <time datetime={updatedAt.toISOString()}>Updated {formatDate(updatedAt)}</time>
              </>
            )
          }
          {
            readingTime && (
              <>
                <span class="ah__dot" aria-hidden="true">·</span>
                <span>{readingTime} min read</span>
              </>
            )
          }
        </span>
      </div>
    </div>

    {
      image && (
        <div class="ah__image" data-reveal>
          <Image
            src={image}
            alt={imageAlt || title}
            layout="full-width"
            widths={[640, 960, 1280, 1920]}
            sizes="100vw"
            class="aspect-video w-full object-cover"
            loading="eager"
          />
        </div>
      )
    }
  </div>
</header>

<style>
  .ah {
    padding: calc(var(--sw-nav-h, 84px) + 32px) 0 24px;
  }

  .ah__card {
    position: relative;
    overflow: hidden;
    padding: clamp(32px, 6vw, 88px);
    border-radius: 22px;
    /* The same deep violet ground as the blog covers and the dark footer. */
    background-color: #1a1030;
    background-image:
      radial-gradient(circle at 0% 100%, rgb(124 58 237 / 0.55), rgb(124 58 237 / 0) 55%),
      radial-gradient(circle at 100% 0%, rgb(167 139 250 / 0.18), rgb(167 139 250 / 0) 45%);
    color: #fff;
  }

  .ah__label {
    color: var(--hero-accent-on-ink, #a78bfa);
  }

  .ah__title {
    margin: 22px 0 0;
    max-width: 18ch;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(36px, 6vw, 84px);
    line-height: 1.02;
    letter-spacing: -0.045em;
    color: #fff;
    text-wrap: balance;
  }

  .ah__desc {
    margin: 28px 0 0;
    max-width: 56ch;
    color: #c9cfd8;
    font-size: clamp(17px, 1.5vw, 20px);
    line-height: 1.55;
  }

  .ah__meta {
    display: grid;
    grid-template-columns: auto auto 1fr;
    align-items: center;
    column-gap: 14px;
    row-gap: 4px;
    margin-top: 40px;
    padding-top: 28px;
    border-top: 1px solid rgb(255 255 255 / 0.12);
    font-size: 14px;
    color: #b8bfc9;
  }

  .ah__avatar {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    background: #eef2f4;
    color: #0c1016;
    font-weight: 600;
    font-size: 14px;
    letter-spacing: -0.04em;
  }

  .ah__name {
    font-weight: 600;
    color: #fff;
  }

  .ah__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0 10px;
  }

  .ah__dot {
    opacity: 0.8;
  }

  /* Phones: name and facts stack beside the avatar. */
  @media (max-width: 700px) {
    .ah__meta {
      grid-template-columns: auto 1fr;
    }

    .ah__avatar {
      grid-row: span 2;
    }
  }

  @media (min-width: 701px) {
    .ah__facts::before {
      content: '·';
      opacity: 0.8;
    }
  }

  /* The post's icon, as on its cover: desktops and landscape tablets only.
     On narrower screens there's no room beside the title. */
  .ah__icon {
    display: none;
  }

  @media (min-width: 1024px) {
    .ah__icon {
      display: block;
      position: absolute;
      top: clamp(48px, 5vw, 72px);
      right: clamp(48px, 5vw, 80px);
      width: clamp(140px, 13vw, 190px);
      height: clamp(140px, 13vw, 190px);
      color: var(--hero-accent-on-ink, #a78bfa);
    }

    .ah__card--icon .ah__title {
      margin-right: clamp(170px, 16vw, 240px);
    }
  }

  .ah__image {
    margin-top: 24px;
    overflow: hidden;
    border-radius: 22px;
  }
</style>
