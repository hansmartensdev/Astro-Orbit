---
/**
 * ArticleHero
 *
 * The top of a blog post: the shared cinema hero (site/CinemaHero.astro)
 * with the post's card art, the violet grid with its icon drawn large, or
 * the post's own photo (`image`) when it has one. The facts are the
 * author, the dates, the reading time and the category, four at most.
 */
import type { ImageMetadata } from 'astro';
import CinemaHero, { type CinemaFact } from '@/components/site/CinemaHero.astro';
import { formatDate } from '@/lib/utils';
import { toneFor } from '@/lib/post-tone';

interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  updatedAt?: Date;
  author?: string;
  category?: string;
  tags?: string[];
  image?: ImageMetadata;
  imageAlt?: string;
  /** The cover's icon (a Lucide name, or "astro" or "claude"). */
  icon?: string;
  /** Minutes, from the post's word count. */
  readingTime?: number;
}

const {
  title,
  description,
  publishedAt,
  updatedAt,
  author = siteConfig.name,
  category,
  tags = [],
  image,
  imageAlt,
  icon,
  readingTime,
} = Astro.props;

const topic = category ?? tags[0];
const label = upper([t.blog.title, topic].filter(Boolean).join(' · '));

const facts = (
  [
    { label: t.blog.writtenBy, value: author },
    { label: t.blog.published, value: formatDate(publishedAt), date: publishedAt },
    updatedAt ? { label: t.blog.updated, value: formatDate(updatedAt), date: updatedAt } : null,
    readingTime ? { label: t.blog.readingTime, value: t.blog.minRead(readingTime) } : null,
    topic ? { label: t.blog.category, value: topic } : null,
  ].filter((fact) => fact !== null) as CinemaFact[]
).slice(0, 4);
import siteConfig from '@/config/site.config';
import { t, upper } from '@/i18n';
---

<CinemaHero
  label={label}
  title={title}
  description={description}
  facts={facts}
  factsLabel={t.hero.postFacts}
  icon={icon}
  tone={toneFor(category)}
  image={image}
  imageAlt={imageAlt}
  fit
/>
