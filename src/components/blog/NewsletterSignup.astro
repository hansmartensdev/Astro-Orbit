---
/**
 * NewsletterSignup
 *
 * Under every post (BlogLayout): a heading, a line, an email field and a
 * button. The address goes to /api/newsletter, which mails a link to
 * confirm; only the click on that link puts it on the list. Ported from
 * Astro Orbit, with the words here (the site is in English only).
 *
 * A violet card with the grid of the blog cards' pictures, everything centred
 * and in white, the field and the button on one line (Hans's choice). The
 * field's label is there for screen readers only: the placeholder shows
 * what goes in it. Violet in light and dark mode alike.
 */
import Input from '@/components/ui/form/Input/Input.astro';
import ArrowFillButton from '@/components/site/ArrowFillButton.astro';

const text = {
  // The heading and the line, from theme.config.ts.
  title: newsletter.title,
  line: newsletter.text,
  email: 'Email address',
  placeholder: 'you@example.com',
  subscribe: 'Subscribe',
  sending: 'Sending…',
  sent: 'Almost done: check your inbox and click the link in the email to confirm.',
  failed: 'Something went wrong. Please try again later.',
  note: 'You can unsubscribe at any time.',
  privacy: 'Privacy',
};
import { newsletter } from '@/config/theme.config';
---

<section class="nl" aria-labelledby="nl-title" data-reveal>
  <div>
    <h2 id="nl-title" class="nl__title">{text.title}</h2>
    <p class="nl__text">{text.line}</p>
  </div>

  <form
    class="nl__form"
    action="/api/newsletter"
    method="POST"
    data-newsletter-form
    data-subscribe={text.subscribe}
    data-sending={text.sending}
    data-sent={text.sent}
    data-failed={text.failed}
  >
    <div class="nl__row">
      <Input
        label={text.email}
        name="email"
        type="email"
        required
        autocomplete="email"
        placeholder={text.placeholder}
      />
      <ArrowFillButton type="submit" icon="lucide:send" class="nl__button">
        {text.subscribe}
      </ArrowFillButton>
    </div>

    <!-- Honeypot field for spam protection -->
    <div class="hidden" aria-hidden="true">
      <input type="text" name="honeypot" tabindex="-1" autocomplete="off" />
    </div>

    <p class="nl__message hidden" role="status" aria-live="polite"></p>

    <p class="nl__note">
      {text.note} <a href="/privacy/">{text.privacy}</a>
    </p>
  </form>
</section>

<style>
  /* The brand colour under white text (--orbit-fill keeps that contrast
     whatever the colour), deepening to its darkest shade, with a faint
     grid: the same ground as the blog cards' pictures. */
  .nl {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin-top: 56px;
    padding: clamp(36px, 5vw, 60px) clamp(24px, 5vw, 64px);
    border-radius: 24px;
    color: #fff;
    text-align: center;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--orbit-950) 14%, var(--orbit-fill)),
      var(--orbit-950)
    );
  }

  .nl::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    opacity: 0.16;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.35) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.35) 1px, transparent 1px);
    background-size: 48px 48px;
    pointer-events: none;
  }

  .nl__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    line-height: 1.05;
    letter-spacing: var(--display-tracking);
    text-transform: var(--display-case);
    color: #fff;
  }

  .nl__text {
    max-width: 46ch;
    margin: 14px auto 0;
    font-size: 17px;
    line-height: 1.55;
    color: rgb(255 255 255 / 0.88);
  }

  .nl__form {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    max-width: 560px;
    margin: 28px auto 0;
  }

  .nl__row {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
  }

  /* The field is the Input component's markup, outside this component's
     scope: it takes the row's width, the button beside it. */
  .nl__row > :global(:first-child) {
    flex: 1 1 auto;
    min-width: 0;
  }

  .nl__row :global(label) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .nl__row :global(input[type='email']) {
    width: 100%;
    border-color: rgb(255 255 255 / 0.4);
    background: rgb(255 255 255 / 0.12);
    color: #fff;
  }

  .nl__row :global(input[type='email']::placeholder) {
    color: rgb(255 255 255 / 0.7);
  }

  .nl__row :global(input[type='email']:focus-visible) {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  .nl__message,
  .nl__note {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
  }

  /* The reply after sending, in white on the violet (the script sets the
     success or error colour class; both read as white here). */
  .nl__message {
    color: #fff !important;
    font-weight: 500;
  }

  .nl__note {
    color: rgb(255 255 255 / 0.85);
  }

  .nl__note a {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 640px) {
    .nl__row {
      flex-direction: column;
      align-items: stretch;
    }

    .nl__row > :global(button) {
      align-self: center;
    }
  }
</style>

<script>
  function initNewsletter() {
    for (const form of document.querySelectorAll<HTMLFormElement>('[data-newsletter-form]')) {
      if (form.dataset.ready) continue;
      form.dataset.ready = 'true';
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const message = form.querySelector<HTMLParagraphElement>('.nl__message');
      if (!button || !message) continue;

      // The button carries its label twice (the pill and the disc's copy).
      const setLabel = (text: string) =>
        button.querySelectorAll('.afb__label').forEach((el) => (el.textContent = text));

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        button.disabled = true;
        setLabel(form.dataset.sending ?? '');
        message.classList.add('hidden');

        try {
          const response = await fetch(form.action, { method: 'POST', body: new FormData(form) });
          const data = await response.json();
          if (data.success) {
            message.textContent = form.dataset.sent ?? '';
            message.className = 'nl__message text-success';
            form.reset();
          } else {
            message.textContent = data.errors
              ? Object.values(data.errors).flat().join(', ')
              : (form.dataset.failed ?? '');
            message.className = 'nl__message text-destructive';
          }
        } catch {
          message.textContent = form.dataset.failed ?? '';
          message.className = 'nl__message text-destructive';
        } finally {
          button.disabled = false;
          setLabel(form.dataset.subscribe ?? '');
          message.classList.remove('hidden');
        }
      });
    }
  }

  initNewsletter();
  document.addEventListener('astro:after-swap', initNewsletter);
</script>
