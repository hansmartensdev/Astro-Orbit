---
import ProjectView from '@/views/ProjectView.astro';
import { defaultLocale, locales } from '@/i18n';
import { getProjects, getProjectSlug } from '@/lib/projects';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of locales.filter((l) => l !== defaultLocale)) {
    for (const project of await getProjects(lang)) {
      paths.push({ params: { lang, slug: getProjectSlug(project) }, props: { project } });
    }
  }
  return paths;
}

const { project } = Astro.props;
---

<ProjectView project={project} />
