---
/**
 * Privacy
 * URL: /privacy
 *
 * What the site does with personal data, under the GDPR (in the
 * Netherlands, the AVG). Adapted from the privacy page on the previous
 * the site and checked against this theme's code on 2026-11-23:
 *
 *   contact form   name, email, optional subject, message; sent by email
 *                  through Resend (src/pages/api/contact.ts), not stored
 *   newsletter     email address, added to a Resend contact list only once
 *                  the subscriber clicks the link in the confirmation email
 *                  (src/pages/api/newsletter.ts)
 *   analytics      none: Analytics.astro loads Google Analytics or Tag
 *                  Manager only when PUBLIC_GA_MEASUREMENT_ID or
 *                  PUBLIC_GTM_ID is set. If either is ever set, this page
 *                  must say so, and the cookie section below changes too.
 *   cookies        none; the colour mode is kept in localStorage.theme (with
 *                  darkOnly in config/mode.config: nothing stored)
 *   fonts          self-hosted (@fontsource in global.css), no font CDN
 *   hosting        Vercel
 *
 * Keep it in step with the site: a policy that describes something the
 * site doesn't do is as wrong as one that leaves out something it does.
 *
 * The text is in src/i18n/privacy/, one file per language; this page
 * renders the one for the site's language (theme.config language), and the
 * English one, with a warning in the build log, for a language without its
 * own. The complaint section names the Dutch authority: outside the
 * Netherlands, name your own country's data protection authority. Read the
 * whole text before you publish it, and change what doesn't match your site.
 */
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import SiteLayout from '@/layouts/SiteLayout.astro';
import SectionHead from '@/components/sections/SectionHead.astro';
import { t, lang, formatDate } from '@/i18n';

const texts = import.meta.glob<{ default: AstroComponentFactory }>('../i18n/privacy/*.astro', { eager: true });
const own = texts[`../i18n/privacy/${lang}.astro`];
if (!own) {
  console.warn(`[privacy] There's no src/i18n/privacy/${lang}.astro, so the privacy page is in English.`);
}
const Privacy = (own ?? texts['../i18n/privacy/en.astro']).default;

const updated = new Date('2026-11-28');
// The host the site runs on (the Vercel adapter in astro.config.mjs).
const host = 'Vercel';
---

<SiteLayout title={t.privacy.title} description={t.privacy.description}>
  <header class="shell pt-[180px] max-[800px]:pt-[130px]">
    <SectionHead as="h1" title={t.privacy.title} blurb={t.privacy.blurb} />
  </header>

  <section class="shell mt-16 max-[800px]:mt-10">
    <div class="prose prose-lg max-w-[68ch] dark:prose-invert" data-reveal-content>
      <p class="label-mono text-foreground-muted">{t.privacy.updated(formatDate(updated))}</p>

      <Privacy host={host} />
    </div>
  </section>

  <div class="pb-[120px] max-[800px]:pb-[80px]"></div>
</SiteLayout>
