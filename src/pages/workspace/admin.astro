---
/**
 * /workspace/admin: where Hans fills in the workspace (server-rendered,
 * Hans only). Every part is its own small form that posts back here and
 * returns to the same place: the project's details and the invited
 * address, the steps, what he needs, the links, and a note to the person.
 * The thread shows their messages, and an entry can be removed.
 */
import { Icon } from 'astro-icon/components';
import SiteLayout from '@/layouts/SiteLayout.astro';
import CinemaHero from '@/components/site/CinemaHero.astro';
import Thread from '@/components/workspace/Thread.astro';
import SignedIn from '@/components/workspace/SignedIn.astro';
import Input from '@/components/ui/form/Input/Input.astro';
import Textarea from '@/components/ui/form/Textarea/Textarea.astro';
import TextBox from '@/components/workspace/TextBox.astro';
import ArrowFillButton from '@/components/site/ArrowFillButton.astro';
import { ready } from '@/lib/workspace/config';
import { whoIs } from '@/lib/workspace/session';
import { addEntry, getProject, getThread, removeEntry, saveProject } from '@/lib/workspace/store';
import { formatLinks, formatSteps, parseLinks, parseSteps } from '@/lib/workspace/model';
import { normalizeEmail } from '@/lib/workspace/sign';
import { sendNoteToMember } from '@/lib/workspace/mail';

export const prerender = false;

const who = ready ? await whoIs(Astro.cookies) : null;
if (!who || who.role !== 'admin') return Astro.redirect('/workspace', 303);

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const get = (name: string, max = 600) => (form.get(name)?.toString() ?? '').trim().slice(0, max);
  const action = get('do', 40);
  const project = await getProject();
  let back = '';

  if (action === 'details') {
    Object.assign(project, {
      name: get('name', 80),
      client: get('client', 80),
      description: get('description', 240),
      status: get('status', 60),
      next: get('next', 80),
      launch: get('launch', 80),
      member: normalizeEmail(get('member', 200)),
    });
    back = 'details';
  } else if (action === 'steps') {
    project.steps = parseSteps(get('steps', 2000));
    back = 'steps';
  } else if (action === 'links') {
    project.links = parseLinks(get('links', 3000));
    back = 'links';
  } else if (action === 'need-add' && get('title', 120)) {
    project.needs.push({
      id: crypto.randomUUID(),
      title: get('title', 120),
      detail: get('detail', 600),
      due: get('due', 40),
      done: false,
    });
    back = 'needs';
  } else if (action === 'need-toggle' || action === 'need-delete') {
    const id = get('id', 60);
    project.needs =
      action === 'need-delete'
        ? project.needs.filter((need) => need.id !== id)
        : project.needs.map((need) => (need.id === id ? { ...need, done: !need.done } : need));
    back = 'needs';
  } else if (action === 'note' && get('note', 4000)) {
    await addEntry('hans', get('note', 4000));
    if (form.get('notify') && project.member) {
      try {
        await sendNoteToMember(project.member, new URL('/workspace#thread', Astro.url).toString());
      } catch (error) {
        console.error('[workspace] note email:', error);
      }
    }
    return Astro.redirect('/workspace/admin#thread', 303);
  } else if (action === 'entry-delete') {
    await removeEntry(get('id', 60));
    return Astro.redirect('/workspace/admin#thread', 303);
  }

  await saveProject(project);
  return Astro.redirect(`/workspace/admin${back ? `#${back}` : ''}`, 303);
}

const project = await getProject();
const thread = await getThread();
const open = project.needs.filter((need) => !need.done).length;
---

<SiteLayout title="Edit the workspace" description="Edit the workspace." noindex navOverMedia>
  <CinemaHero
    label="WORKSPACE · ADMIN"
    title="Edit"
    description="Fill in what the person you build with sees. They can read everything here and leave messages; only you can change it."
    facts={[
      { label: 'Project', value: project.name || 'Not named yet' },
      { label: 'Invited', value: project.member || 'Nobody yet' },
      { label: 'Open items', value: String(open) },
    ]}
    factsLabel="The workspace in short"
    icon="pencil-line"
    short
  />

  <SignedIn email={who.email} link={{ href: '/workspace', label: 'See it as they do' }} />

  <div class="adm">
    <div class="shell adm__inner">

      <section class="adm__card" id="details" aria-labelledby="adm-details">
        <h2 class="label-mono adm__label" id="adm-details">THE PROJECT</h2>
        <form method="post" data-astro-reload class="adm__form adm__form--two">
          <input type="hidden" name="do" value="details" />
          <Input label="Project name" name="name" value={project.name} maxlength={80} />
          <Input label="Who it's for" name="client" value={project.client} maxlength={80} />
          <div class="adm__wide">
            <TextBox label="One line about it" name="description" rows={2} maxlength={240} value={project.description} />
          </div>
          <Input label="Status" name="status" value={project.status} maxlength={60} placeholder="Building" />
          <Input label="Next" name="next" value={project.next} maxlength={80} placeholder="Testing, from 15 Dec" />
          <Input label="Launch" name="launch" value={project.launch} maxlength={80} placeholder="Planned for 20 Dec" />
          <Input
            label="Invited person's email"
            name="member"
            type="email"
            value={project.member}
            maxlength={200}
            hint="Only this address (and yours) can sign in. Clear it to sign them out."
          />
          <div class="adm__wide">
            <ArrowFillButton type="submit" icon="lucide:check">Save</ArrowFillButton>
          </div>
        </form>
      </section>

      <section class="adm__card" id="needs" aria-labelledby="adm-needs">
        <h2 class="label-mono adm__label" id="adm-needs">WHAT I NEED FROM THEM</h2>
        {
          project.needs.length > 0 && (
            <ul class="adm__needs">
              {project.needs.map((need) => (
                <li class:list={[need.done && 'is-done']}>
                  <span class="adm__need">
                    <strong>{need.title}</strong>
                    {need.due && <span class="label-mono"> · BY {need.due.toUpperCase()}</span>}
                    {need.detail && <small>{need.detail}</small>}
                  </span>
                  <form method="post" data-astro-reload>
                    <input type="hidden" name="do" value="need-toggle" />
                    <input type="hidden" name="id" value={need.id} />
                    <button type="submit" class="adm__btn">
                      <Icon name={need.done ? 'lucide:rotate-ccw' : 'lucide:check'} aria-hidden="true" />
                      {need.done ? 'Open again' : 'Received'}
                    </button>
                  </form>
                  <form method="post" data-astro-reload>
                    <input type="hidden" name="do" value="need-delete" />
                    <input type="hidden" name="id" value={need.id} />
                    <button type="submit" class="adm__btn adm__btn--quiet">Remove</button>
                  </form>
                </li>
              ))}
            </ul>
          )
        }
        <form method="post" data-astro-reload class="adm__form adm__form--two">
          <input type="hidden" name="do" value="need-add" />
          <Input label="What you need" name="title" required maxlength={120} />
          <Input label="Needed by" name="due" maxlength={40} placeholder="4 Dec" />
          <div class="adm__wide">
            <Textarea label="A few words more (optional)" name="detail" rows={2} maxlength={600} />
          </div>
          <div class="adm__wide">
            <ArrowFillButton type="submit" icon="lucide:plus">Add</ArrowFillButton>
          </div>
        </form>
      </section>

      <section class="adm__card" id="steps" aria-labelledby="adm-steps">
        <h2 class="label-mono adm__label" id="adm-steps">THE STEPS</h2>
        <form method="post" data-astro-reload class="adm__form">
          <input type="hidden" name="do" value="steps" />
          <TextBox
            label="One step a line: name | done, now or next | date"
            name="steps"
            rows={6}
            maxlength={2000}
            placeholder={'Plan | done | 14 Nov\nDesign | done | 25 Nov\nBuild | now | until 12 Dec\nTest | next | from 15 Dec\nLaunch | next | 20 Dec'}
            value={formatSteps(project.steps)}
          />
          <ArrowFillButton type="submit" icon="lucide:check">Save the steps</ArrowFillButton>
        </form>
      </section>

      <section class="adm__card" id="links" aria-labelledby="adm-links">
        <h2 class="label-mono adm__label" id="adm-links">LINKS</h2>
        <form method="post" data-astro-reload class="adm__form">
          <input type="hidden" name="do" value="links" />
          <TextBox
            label="One link a line: label | https://… | note"
            name="links"
            rows={4}
            maxlength={3000}
            placeholder={'Preview of the site | https://preview.example.com | the latest build'}
            value={formatLinks(project.links)}
          />
          <ArrowFillButton type="submit" icon="lucide:check">Save the links</ArrowFillButton>
        </form>
      </section>

      <section class="adm__card" id="thread" aria-labelledby="adm-thread">
        <h2 class="label-mono adm__label" id="adm-thread">NOTES AND MESSAGES</h2>
        <form method="post" data-astro-reload class="adm__form">
          <input type="hidden" name="do" value="note" />
          <Textarea label="Leave a note for them" name="note" rows={4} required maxlength={4000} />
          <label class="adm__check">
            <input type="checkbox" name="notify" checked={Boolean(project.member)} disabled={!project.member} />
            Email them that there's a new note
          </label>
          <ArrowFillButton type="submit" icon="lucide:send">Add the note</ArrowFillButton>
        </form>
        <div class="adm__thread">
          <Thread entries={thread} viewer="admin" member={project.member} removable />
        </div>
      </section>

      <form method="post" data-astro-reload action="/workspace/signout" class="adm__out">
        <button type="submit" class="adm__btn"><Icon name="lucide:log-out" aria-hidden="true" /> Sign out</button>
      </form>
    </div>
  </div>
</SiteLayout>

<style>
  .adm {
    padding-block: clamp(48px, 5vw, 72px) clamp(88px, 11vw, 140px);
    background: var(--background-secondary);
  }

  .adm__inner {
    display: grid;
    gap: 24px;
    max-width: 880px;
  }

  .adm__card {
    padding: clamp(24px, 3.5vw, 40px);
    border: 1px solid var(--border);
    border-radius: 24px;
    background: var(--background-elevated);
    scroll-margin-top: 96px;
  }

  .adm__label {
    margin: 0 0 22px;
    font-size: inherit;
    font-weight: inherit;
    color: var(--foreground-muted);
  }

  .adm__form {
    display: grid;
    gap: 18px;
    justify-items: start;
  }

  .adm__form > :global(*) {
    width: 100%;
  }

  .adm__form > :global(button),
  .adm__form > :global(a) {
    width: auto;
  }

  .adm__form--two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .adm__wide {
    grid-column: 1 / -1;
  }

  .adm__needs {
    display: grid;
    gap: 10px;
    margin: 0 0 28px;
    padding: 0;
    list-style: none;
  }

  .adm__needs li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 10px;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: 14px;
  }

  .adm__needs li.is-done strong {
    color: var(--foreground-muted);
    text-decoration: line-through;
  }

  .adm__need small {
    display: block;
    margin-top: 4px;
    color: var(--foreground-secondary);
    font-size: 14px;
  }

  .adm__need .label-mono {
    color: var(--foreground-muted);
  }

  .adm__btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: none;
    color: var(--foreground);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }

  .adm__btn :global(svg) {
    width: 15px;
    height: 15px;
  }

  .adm__btn--quiet {
    border-color: transparent;
    color: var(--foreground-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .adm__check {
    display: flex !important;
    align-items: center;
    gap: 10px;
    font-size: 15px;
  }

  .adm__check input {
    width: 18px;
    height: 18px;
    accent-color: var(--orbit-fill);
  }

  .adm__thread {
    margin-top: 28px;
  }

  .adm__out {
    justify-self: end;
  }

  @media (max-width: 700px) {
    .adm__form--two {
      grid-template-columns: minmax(0, 1fr);
    }

    .adm__needs li {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .adm__needs li > :last-child {
      grid-column: 2;
    }
  }
</style>
