---
/**
 * The workspace
 * URL: /workspace (server-rendered; not in the menu, not indexed)
 *
 * Signed out: the sign-in form. An invited address (or Hans's) gets a link
 * by email; any other address gets the same "check your email", so the
 * page never tells who has access. Signed in: the project
 * (components/workspace/ProjectView.astro), with a box for a message to
 * Hans. See src/lib/workspace/README.md.
 */
import SiteLayout from '@/layouts/SiteLayout.astro';
import CinemaHero from '@/components/site/CinemaHero.astro';
import Panel from '@/components/workspace/Panel.astro';
import ProjectView from '@/components/workspace/ProjectView.astro';
import Input from '@/components/ui/form/Input/Input.astro';
import ArrowFillButton from '@/components/site/ArrowFillButton.astro';
import { config, ready } from '@/lib/workspace/config';
import { addEntry, getProject, getThread, mayEmail } from '@/lib/workspace/store';
import { roleOf, whoIs } from '@/lib/workspace/session';
import { LINK_LIFETIME, nonce, normalizeEmail, sign } from '@/lib/workspace/sign';
import { sendMessageToAdmin, sendSignInLink } from '@/lib/workspace/mail';

export const prerender = false;

let sentTo = '';
let failed = false;

const who = ready ? await whoIs(Astro.cookies) : null;

if (ready && Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('do')?.toString();

  if (action === 'signin' && !who) {
    const email = normalizeEmail(form.get('email')?.toString() ?? '').slice(0, 200);
    sentTo = email;
    try {
      // Only invited addresses get a link; the page says the same either way.
      if (email && (await roleOf(email)) && (await mayEmail(email))) {
        const token = await sign({ e: email, p: 'link', x: Date.now() + LINK_LIFETIME, n: nonce() }, config.secret);
        await sendSignInLink(email, new URL(`/workspace/verify?t=${token}`, Astro.url).toString());
      }
    } catch (error) {
      console.error('[workspace] sign-in link:', error);
      failed = true;
    }
  }

  if (action === 'message' && who?.role === 'member') {
    const text = (form.get('message')?.toString() ?? '').trim().slice(0, 4000);
    if (text) {
      await addEntry('member', text);
      try {
        await sendMessageToAdmin(config.admin, who.email, text, new URL('/workspace/admin#thread', Astro.url).toString());
      } catch (error) {
        console.error('[workspace] message email:', error);
      }
    }
    return Astro.redirect('/workspace?sent=1#thread', 303);
  }
}

const project = who ? await getProject() : null;
const thread = who ? await getThread() : [];
const sent = Astro.url.searchParams.get('sent') === '1';

const steps = [
  { label: '1 · Your email', value: 'The address I invited' },
  { label: '2 · The link', value: 'Arrives in your inbox' },
  { label: '3 · You’re in', value: 'No password needed' },
];

const facts = project
  ? [
      project.status && { label: 'Status', value: project.status },
      project.next && { label: 'Next', value: project.next },
      project.launch && { label: 'Launch', value: project.launch },
      project.updated && {
        label: 'Last update',
        value: new Date(project.updated).toLocaleDateString('en-GB', {
          day: 'numeric',
          month: 'long',
          timeZone: 'Europe/Amsterdam',
        }),
      },
    ].filter((fact): fact is { label: string; value: string } => Boolean(fact))
  : steps;
---

<SiteLayout title="Workspace" description="The workspace for the people Hans builds a project with." noindex navOverMedia>
  {
    who && project ? (
      <>
        <CinemaHero
          label={project.client ? `WORKSPACE · ${project.client.toUpperCase()}` : 'WORKSPACE'}
          title={project.name || 'Workspace'}
          description={project.description || 'Where the project stands and what I need from you.'}
          facts={facts.length ? facts : steps}
          factsLabel="The project in short"
          icon="layout-dashboard"
          short
        />
        <ProjectView project={project} thread={thread} viewer={who.role} email={who.email} sent={sent} />
      </>
    ) : (
      <>
        <CinemaHero
          label="WORKSPACE"
          title="Sign in"
          description="The workspace is for the people I build a project with. Enter your email address and I'll send you a link to sign in."
          facts={steps}
          factsLabel="How signing in works"
          icon="key-round"
          short
        />
        {!ready ? (
          <Panel label="NOT SET UP YET">
            <div class="wsp-done">
              <h2>Not set up yet</h2>
              <p>The workspace needs a few settings before anyone can sign in.</p>
            </div>
          </Panel>
        ) : sentTo && !failed ? (
          <Panel label="CHECK YOUR EMAIL">
            <div class="wsp-done" role="status">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7" />
                <rect x="2" y="4" width="20" height="16" rx="2" />
              </svg>
              <h2>Check your email</h2>
              <p>
                If this address is invited, a sign-in link is on its way to <strong>{sentTo}</strong>. It works once,
                within 15 minutes.
              </p>
              <a class="wsp-link" href="/workspace">Use another address</a>
            </div>
          </Panel>
        ) : (
          <Panel label="SIGN IN">
            <form method="post" data-astro-reload>
              <input type="hidden" name="do" value="signin" />
              <Input label="Email address" name="email" type="email" required autocomplete="email" maxlength={200} />
              <ArrowFillButton type="submit" icon="lucide:send" class="justify-self-start">
                Send me a sign-in link
              </ArrowFillButton>
              {failed ? (
                <p class="wsp-note" role="alert">
                  The link couldn't be sent just now. Please try again in a minute.
                </p>
              ) : (
                <p class="wsp-note">Only invited addresses can sign in. The link works once, within 15 minutes.</p>
              )}
            </form>
          </Panel>
        )}
      </>
    )
  }
</SiteLayout>
