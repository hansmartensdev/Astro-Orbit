---
/**
 * 404
 */
import SiteLayout from '@/layouts/SiteLayout.astro';
import PillButton from '@/components/site/PillButton.astro';
import { t } from '@/i18n';
---

<SiteLayout
  title={t.notFound.title}
  description={t.notFound.description}
  noindex
>
  <section
    class="flex min-h-screen flex-col justify-end shell pt-24 pb-[140px] max-[800px]:pb-[100px]"
  >
    <p class="label-mono mb-8 text-foreground-muted">404</p>

    <h1 class="display-hero m-0">
      {t.notFound.lead}<br /><em>{t.notFound.leadAccent}</em>
    </h1>

    <p class="mt-9 max-w-[420px] text-[17px] leading-[1.6] text-foreground-secondary">
      {t.notFound.text}
    </p>

    <div class="mt-13 flex flex-wrap gap-[18px]">
      <PillButton href="/">{t.notFound.home}</PillButton>
      <PillButton href="/projects" variant="outline">{t.notFound.projects}</PillButton>
    </div>
  </section>
</SiteLayout>
