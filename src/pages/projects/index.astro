---
/**
 * Projects index
 * URL: /projects
 *
 * The shared cinema hero (site/CinemaHero.astro), with the projects that
 * have a picture as links in its strip, then the same grid as the
 * homepage without the four-project cap, on the second ground (the zebra
 * of the other pages), and the sign-off.
 */
import { getCollection } from 'astro:content';
import SiteLayout from '@/layouts/SiteLayout.astro';
import CinemaHero from '@/components/site/CinemaHero.astro';
import WorkGrid from '@/components/sections/WorkGrid.astro';
import Cta from '@/components/sections/Cta.astro';

// The projects with a picture, in portfolio order: the placeholders have
// none, so they stay out of the strip.
const facts = (
  await getCollection('work', ({ data }) => data.draft !== true && !data.parent && Boolean(data.feature))
)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4)
  .map((project) => ({
    label: project.data.discipline,
    value: project.data.title,
    href: `/projects/${project.id}/`,
  }));
import { pages } from '@/config/theme.config';
---

<SiteLayout
  title="Projects"
  description={pages.projects.description}
  navOverMedia
>
  <CinemaHero
    label="PROJECTS"
    title="Projects"
    description={pages.projects.blurb}
    facts={facts}
    factsLabel="The projects"
    icon="layout-grid"
  />

  <div class="bg-background-secondary">
    <WorkGrid
      showHead={false}
      showMore={false}
      class="pt-[56px]! pb-[120px]! max-[800px]:pt-[32px]! max-[800px]:pb-[80px]!"
    />
  </div>

  <Cta />
</SiteLayout>
