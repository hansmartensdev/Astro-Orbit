---
/**
 * Work case study
 * URL: /projects/<slug>
 *
 * Built as a run of full-bleed bands rather than a column of sections. The
 * bands take turns on the page ground and the second ground, in light and in
 * dark mode (a zebra, Hans's choice), so each new section shows where it
 * starts. Light mode has no black grounds; only the footer stays ink.
 *
 * Each band's heading is sticky: it pins while that band's captures scroll past
 * it, then the next band pushes it out. That ties a caption to the pictures it
 * belongs to without repeating it above every one.
 */
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import SiteLayout from '@/layouts/SiteLayout.astro';
import Placeholder from '@/components/site/Placeholder.astro';
import PillButton from '@/components/site/PillButton.astro';
import Cta from '@/components/sections/Cta.astro';

export async function getStaticPaths() {
  const projects = await getCollection('work', ({ data }) =>
    import.meta.env.PROD ? data.draft !== true : true
  );

  const ordered = [...projects].sort((a, b) => a.data.order - b.data.order);

  // "Next project" walks the portfolio as the grids show it: projects told
  // inside a story page (`parent`) are skipped, and from one of those the
  // door leads back to the story it belongs to.
  const ring = ordered.filter((project) => !project.data.parent);

  // A project with `story: true` has its own page file beside this one, and
  // Astro would otherwise build both to the same path. It stays in the ring so
  // "next project" still walks the whole portfolio.
  return ordered
    .map((project) => {
      const parent = project.data.parent
        ? ordered.find((candidate) => candidate.id === project.data.parent)
        : undefined;
      // The next project with a picture of its own: a placeholder makes a
      // poor last thing to show. With no other real project, no band.
      const hasPicture = (candidate: (typeof ring)[number]) =>
        Boolean(candidate.data.pageHero ?? candidate.data.feature ?? candidate.data.cover);
      const from = ring.indexOf(project);
      const after = [...ring.slice(from + 1), ...ring.slice(0, Math.max(from, 0))];
      const next =
        parent ?? after.find((candidate) => candidate !== project && hasPicture(candidate));
      // Two designs for the next project take turns down the portfolio, so
      // a reader going from one project to the next sees both: the split
      // (Hans's first choice) and the cinema. `nextLayout` overrides it.
      const nextLayout =
        project.data.nextLayout ?? (Math.max(from, 0) % 2 === 0 ? 'split' : 'cinema');
      return { params: { slug: project.id }, props: { project, next, nextLayout } };
    })
    .filter(({ props }) => !props.project.data.story);
}

const { project, next, nextLayout } = Astro.props;

// Band text is plain text, escaped, with **text** in bold and [text](url)
// turned into a link:
// another site's in a new tab, a page on this site (/…) in the same one.
const escapeHtml = (t: string) =>
  t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const withLinks = (t: string) =>
  escapeHtml(t)
    .replace(
      /\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)/g,
      '<a class="band__link" href="$2" target="_blank" rel="noopener noreferrer">$1</a>'
    )
    .replace(/\[([^\]]+)\]\((\/[^)\s]*)\)/g, '<a class="band__link" href="$2">$1</a>')
    .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
const { Content } = await render(project);

const {
  title,
  discipline,
  description,
  client,
  year,
  services,
  url,
  urlLabel,
  repo,
  feature,
  featureMobile,
  pageHero,
  pageHeroMobile,
  heroImage,
  sections,
  video,
  cover,
  coverAlt,
  gallery,
  placeholder,
  challenge,
  solution,
  technologies,
  features,
  badge,
} = project.data;

// Only the facts that were actually filled in get a slot.
const facts = [
  // My own projects have no client: they are for the Astro community.
  { label: 'Client', value: client || 'The Astro Community' },
  year ? { label: 'Year', value: String(year) } : null,
  { label: 'Discipline', value: discipline },
  services.length ? { label: 'Services', value: services.join(', ') } : null,
].filter((fact) => fact !== null);

// The feature photograph leads the page the way it leads the card. The mockup
// is not dropped — it becomes the first capture in the bands below.
// A project can give its page its own hero picture (pageHero), shaped for
// the screen rather than the card.
const picture = pageHero ?? feature ?? cover;
// heroImage: false leaves the hero without a picture (title on ink); the
// project still has one for the card, the share preview and the index.
const hero = heroImage ? picture : undefined;
// A small copy of the hero picture for the glow under it on desktop: blurred
// to a wash of the picture's colours, so 480px is plenty.
const heroGlow = hero ? await getImage({ src: hero, width: 480, format: 'webp', quality: 60 }) : null;
// The phone version of the hero picture, if the project has one: composed
// for a narrow screen, shown whole at the top of the hero on phones.
const heroMobileSrc = pageHeroMobile ?? featureMobile;
const heroMobile = heroMobileSrc
  ? await getImage({
      src: heroMobileSrc,
      widths: [600, 900, 1200, 1600],
      format: 'webp',
      quality: 90,
    })
  : null;
// The hero takes the page ground: light in light mode, ink in dark mode,
// so the nav keeps its own colours over it.
const shots = feature && cover ? [{ src: cover, alt: coverAlt ?? title }, ...gallery] : gallery;

/* The written half of a case study, split across two bands. Most projects have
   neither half written yet, so each band has to earn its place: one with no
   prose AND no captures isn't rendered rather than left as an empty heading.
   Captures are dealt between the bands so the page still has rhythm when the
   writing is missing. */
const half = Math.ceil(shots.length / 2);
// A picture can name its part (band: 1 or 2); then the others go to part 1.
const placed = shots.some((shot) => 'band' in shot && shot.band);
const inBand = (n: 1 | 2) =>
  placed
    ? shots.filter((shot) => (('band' in shot && shot.band) || 1) === n)
    : n === 1
      ? shots.slice(0, half)
      : shots.slice(half);
// One video or several, shown one under another at the top of band 1.
const videos = video ? (Array.isArray(video) ? video : [video]) : [];

const bands = [
  { key: 'problem', label: 'WHY I BUILT IT', prose: challenge, shots: inBand(1) },
  { key: 'solution', label: 'WHAT I BUILT', prose: solution, shots: inBand(2) },
  ...sections.map((section, k) => ({
    key: `section-${k}`,
    label: section.label.toUpperCase(),
    prose: section.text,
    shots: [] as ReturnType<typeof inBand>,
  })),
].filter((band) => band.prose || band.shots.length > 0);

const hasBuild = technologies.length > 0 || features.length > 0;
// The stack, what shipped and the site link sit under the last band's text,
// in line with it, rather than in sections of their own with their own
// padding. Only a project without any band gets them as sections below.
const extrasInBand = bands.length > 0;
// The written case study under the bands, only when the project has one.
const hasBody = Boolean(project.body?.trim());
// The cinema fills the width, so it takes the next project's page hero,
// which is shaped for a screen; the split's half fits the card picture.
const nextWide = next ? (next.data.pageHero ?? next.data.feature ?? next.data.cover) : undefined;
const nextImage = next ? (next.data.feature ?? next.data.cover) : undefined;
// The cinema needs a picture; without one the split is used.
const nextCinema = nextLayout === 'cinema' && Boolean(nextWide);

// The zebra, counted back from the next project: that sits on the second
// ground, so it stands apart from the sign-off under it, and the bands above
// take turns from there. Without a next project the last band takes the
// second ground instead.
const toneOf = (i: number) =>
  (bands.length - 1 - i + (next ? 0 : 1)) % 2 === 0 ? 'base' : 'alt';
---

<SiteLayout
  title={title}
  description={description}
  noindex={!picture}
  image={picture?.src}
  imageAlt={coverAlt ?? title}
  navContext={client ?? title}
>
  <article class="case">
    {/* --- hero: full-bleed, viewport tall, type over the picture -------- */}
    <header class="case__hero">
      {
        hero ? (
          <picture class="case__hero-picture">
            {heroMobile && (
              <source
                media="(max-width: 800px), (max-width: 1100px) and (orientation: portrait)"
                srcset={heroMobile.srcSet.attribute}
                sizes="100vw"
                type="image/webp"
              />
            )}
            <Image
              src={hero}
              alt={coverAlt ?? title}
              layout="none"
              widths={[768, 1280, 1920, 2560, 3200, 3840]}
              quality={90}
              sizes="100vw"
              class:list={['case__hero-img', heroMobile && 'case__hero-img--has-mobile']}
              loading="eager"
              fetchpriority="high"
            />
          </picture>
        ) : picture ? (
          <div class="case__hero-img case__hero-img--plain" />
        ) : (
          <div class="case__hero-img">
            <Placeholder class="h-full w-full rounded-none" label={placeholder ?? title} />
          </div>
        )
      }

      <div class="case__hero-scrim"></div>
      {heroGlow && <img class="case__hero-glow" src={heroGlow.src} alt="" aria-hidden="true" decoding="async" />}

      <div class="case__hero-body shell">
        <div class="case__eyebrow">
          <span class="label-mono">{discipline}</span>
          {badge && <span class="case__badge label-mono">{badge}</span>}
        </div>

        <h1 class="case__title" style={`--len: ${title.length}`}>{title}</h1>
        <p class="case__lede">{description}</p>
      </div>

      {/* --- facts: along the foot of the hero, over the picture on desktop */}
      <div class="case__ledger" role="group" aria-label="Project details">
        <dl class="case__ledger-inner shell">
          {
            facts.map((fact, i) => (
              <div class="case__fact" data-reveal data-reveal-delay={i * 0.08}>
                <dt class="label-mono">{fact.label.toUpperCase()}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </header>


    {/* --- alternating bands -------------------------------------------- */}
    {
      bands.map((band, i) => (
        <section class="band" data-tone={toneOf(i)}>
          <div class="band__inner shell">
            <div
              class:list={[
                'band__aside',
                extrasInBand && i === bands.length - 1 && 'band__aside--long',
              ]}
            >
              <span class="band__label label-mono" data-reveal>
                {band.label}
              </span>
              {/* A blank line in the text starts a new paragraph. */}
              {band.prose &&
                band.prose
                  .split(/\n\s*\n/)
                  .map((para) => (
                    <p class="band__prose" data-reveal set:html={withLinks(para.trim())} />
                  ))}
              {extrasInBand && i === bands.length - 1 && (
                <div class="band__extras" data-reveal>
                  {technologies.length > 0 && (
                    <div>
                      <span class="band__label label-mono">STACK</span>
                      <ul class="case__chips">
                        {technologies.map((item) => (
                          <li>{item}</li>
                        ))}
                      </ul>
                    </div>
                  )}
                  {features.length > 0 && (
                    <div>
                      <span class="band__label label-mono">SHIPPED</span>
                      <ul class="case__shipped">
                        {features.map((item) => (
                          <li>{item}</li>
                        ))}
                      </ul>
                    </div>
                  )}
                  {(url || repo) && (
                    <div class="case__buttons">
                      {url && (
                        <PillButton href={url} target="_blank" variant="solid">
                          {urlLabel ?? 'Visit the site'}
                          <Icon name="lucide:arrow-up-right" aria-hidden="true" />
                        </PillButton>
                      )}
                      {repo && (
                        <PillButton href={repo} target="_blank" variant="outline">
                          View on GitHub
                          <Icon name="fa6-brands:github" aria-hidden="true" />
                        </PillButton>
                      )}
                    </div>
                  )}
                </div>
              )}
            </div>

            <div class="band__shots">
              {i === 0 &&
                videos.map((v) => (
                  <video
                    class="band__shot band__shot--framed band__video"
                    data-autoplay-video
                    data-src={v.src}
                    poster={v.poster}
                    width={v.width}
                    height={v.height}
                    muted
                    loop
                    playsinline
                    preload="none"
                    aria-label={v.alt}
                    data-reveal
                  />
                ))}
              {band.shots.map((shot, j) => (
                <>
                  <Image
                    src={shot.src}
                    alt={shot.alt ?? title}
                    layout="none"
                    widths={[768, 1280, 1920]}
                    quality={90}
                    sizes="(max-width: 1000px) 100vw, 62vw"
                    class:list={[
                      'band__shot',
                      'frame' in shot && shot.frame && 'band__shot--framed',
                    ]}
                    data-reveal
                    data-reveal-delay={j * 0.1}
                  />
                </>
              ))}
            </div>
          </div>
        </section>
      ))
    }

    {/* --- stack + shipped ---------------------------------------------- */}
    {
      !extrasInBand && hasBuild && (
        <section class="case__build">
          <div class="case__build-inner shell">
            {technologies.length > 0 && (
              <div data-reveal>
                <span class="label-mono text-foreground-muted">STACK</span>
                <ul class="case__chips">
                  {technologies.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            )}
            {features.length > 0 && (
              <div data-reveal data-reveal-delay="0.1">
                <span class="label-mono text-foreground-muted">SHIPPED</span>
                <ul class="case__shipped">
                  {features.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </section>
      )
    }

    {
      hasBody && (
        <div class="case__prose shell">
          <div class="prose" data-reveal-content>
            <Content />
          </div>
        </div>
      )
    }

    {
      !extrasInBand && (url || repo) && (
        <div class="case__visit case__buttons shell" data-reveal>
          {url && (
            <PillButton href={url} target="_blank" variant="solid">
              {urlLabel ?? 'Visit the site'}
              <Icon name="lucide:arrow-up-right" aria-hidden="true" />
            </PillButton>
          )}
          {repo && (
            <PillButton href={repo} target="_blank" variant="outline">
              View on GitHub
              <Icon name="fa6-brands:github" aria-hidden="true" />
            </PillButton>
          )}
        </div>
      )
    }

    {/* --- next project: the split or the cinema, on the second ground ---- */}
    {
      next && !nextCinema && (
        <a class="nextup nextup--split" href={'/projects/' + next.id} data-card>
          <span class="nextup__text" data-reveal>
            <span class="label-mono nextup__label">NEXT PROJECT</span>
            <span class="nextup__title" style={`--len: ${next.data.title.length}`}>
              {next.data.title}
            </span>
            <span class="nextup__line">{next.data.description}</span>
            <span class="nextup__go">
              View project
              <Icon name="lucide:arrow-right" aria-hidden="true" />
            </span>
          </span>
          <span class="nextup__pic">
            {nextImage ? (
              <Image
                src={nextImage}
                alt=""
                layout="none"
                widths={[640, 960, 1280, 1600, 2000]}
                quality={90}
                sizes="(max-width: 800px) 100vw, 50vw"
                class="nextup__img"
                loading="lazy"
              />
            ) : (
              <span class="nextup__blank label-mono" aria-hidden="true">
                {next.data.title}
              </span>
            )}
          </span>
        </a>
      )
    }
    {
      next && nextCinema && nextWide && (
        <a class="nextup nextup--cinema" href={'/projects/' + next.id} data-card>
          <Image
            src={nextWide}
            alt=""
            layout="none"
            widths={[768, 1280, 1920, 2560]}
            quality={90}
            sizes="100vw"
            class="nextup__img"
            loading="lazy"
          />
          <span class="nextup__scrim" aria-hidden="true"></span>
          <span class="nextup__body shell" data-reveal>
            <span class="nextup__head">
              <span class="label-mono nextup__label">NEXT PROJECT</span>
              <span class="nextup__title" style={`--len: ${next.data.title.length}`}>
                {next.data.title}
              </span>
            </span>
            <span class="nextup__side">
              <span class="nextup__line">{next.data.description}</span>
              <span class="nextup__go nextup__go--plain">
                View project
                <Icon name="lucide:arrow-right" aria-hidden="true" />
              </span>
            </span>
          </span>
        </a>
      )
    }
  </article>

  <Cta />
</SiteLayout>

<style>
  /* --- hero ------------------------------------------------------------ */

  .case__hero-picture {
    display: contents;
  }

  /* The picture's colours, blurred, under the stage on desktop (below). */
  .case__hero-glow {
    display: none;
  }

  .case__hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 100svh;
    overflow: hidden;
    background: var(--background);
    isolation: isolate;
  }

  .case__hero-img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The picture's arrival, the only motion in the hero: the label, title and
     line above it stand still (Hans's choice). Once the picture has loaded
     (scripts/motion/case.ts adds .is-in) it is unveiled from the bottom up,
     like a curtain rising, while it settles from slightly larger; its glow
     comes up after. The transition is on the arrived state only, as with
     [data-reveal], so the hidden state applies at once. `scale` leaves the
     picture's own `transform` alone. The clip's corners follow the card's
     (--hero-clip-radius, set for the card layout below). */
  .case__hero-img {
    --hero-clip-radius: 0px;
    clip-path: inset(0 0 0 0 round var(--hero-clip-radius));
  }

  .case__hero:where(.is-in) .case__hero-img {
    transition:
      clip-path 1.25s cubic-bezier(0.76, 0, 0.24, 1),
      scale 1.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .case__hero:where(.is-in) .case__hero-glow {
    transition: opacity 1.4s cubic-bezier(0.16, 1, 0.3, 1) 0.6s;
  }

  :global(html.js) .case__hero:not(.is-in) .case__hero-img {
    clip-path: inset(100% 0 0 0 round var(--hero-clip-radius));
    scale: 1.08;
  }

  :global(html.js) .case__hero:not(.is-in) .case__hero-glow {
    opacity: 0;
  }

  /* Type sits on the picture, so the picture is made safe for type rather than
     the type given a box to hide in. The shade is the page ground: light in
     light mode with dark type, ink in dark mode with light type (Hans's
     choice: no black grounds in light mode). */
  .case__hero-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(
        to top,
        color-mix(in srgb, var(--background) 92%, transparent) 0%,
        color-mix(in srgb, var(--background) 30%, transparent) 46%,
        transparent 72%
      ),
      linear-gradient(to right, color-mix(in srgb, var(--background) 60%, transparent), transparent 60%);
  }

  .case__hero-body {
    width: 100%;
    padding-bottom: 88px;
    color: var(--foreground);
  }

  .case__eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    color: var(--foreground-secondary);
  }

  .case__badge {
    padding: 6px 13px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-full);
  }

  .case__title {
    margin: 22px 0 0;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    text-transform: var(--display-case);
    /* Never wider than the page: a long one-word title (a domain name)
       shrinks to fit, about 0.52em per character in this face. */
    font-size: min(10vw, 148px, calc((100vw - 96px) / (var(--len, 10) * 0.52)));
    line-height: 0.92;
    letter-spacing: var(--display-tracking);
  }

  .case__lede {
    margin: 28px 0 0;
    max-width: 46ch;
    font-size: clamp(1.0625rem, 1.5vw, 1.375rem);
    line-height: 1.5;
    color: var(--foreground-secondary);
  }


  /* --- ledger ---------------------------------------------------------- */

  .case__ledger {
    width: 100%;
    background: var(--background);
    color: var(--foreground);
    border-top: 1px solid var(--border-strong);
  }

  .case__ledger-inner {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    padding-block: 36px 44px;
  }

  .case__fact dt {
    color: var(--foreground-muted);
  }

  .case__fact dd {
    margin: 12px 0 0;
    font-size: 17px;
    line-height: 1.45;
  }

  /* --- bands ----------------------------------------------------------- */

  .band {
    padding-block: clamp(80px, 11vw, 160px);
  }

  /* The zebra: the page ground and the second ground, in turn (toneOf). */
  .band[data-tone='base'] {
    background: var(--background);
    color: var(--foreground);
  }

  .band[data-tone='alt'] {
    background: var(--background-secondary);
    color: var(--foreground);
  }

  .band__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.1fr);
    gap: 64px;
    align-items: start;
  }

  /* The heading pins while its own captures scroll past, then the next band
     pushes it out. `align-self: start` is what stops the sticky box being
     stretched to the row's full height, which would leave it sticking to
     nothing. */
  .band__aside {
    position: sticky;
    top: calc(var(--sw-nav-h, 76px) + 32px);
    align-self: start;
  }

  .band__label {
    display: block;
    opacity: 0.6;
  }

  .band__prose {
    margin: 22px 0 0;
    font-size: clamp(1.125rem, 1.7vw, 1.5rem);
    line-height: 1.45;
    letter-spacing: -0.01em;
  }

  .band__shots {
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 3vw, 40px);
  }

  .band__shot {
    width: 100%;
    border-radius: var(--radius-lg);
  }

  /* A capture whose edge is the page colour gets a border, so it reads as one
     picture instead of running into the page. */
  .band__shot--framed {
    border: 1px solid var(--color-border-strong);
  }

  /* A link in the band text: the text's own colour, underlined. */
  .band__prose :global(.band__link) {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 4px;
  }

  .band__prose :global(.band__link:hover) {
    text-decoration-thickness: 2.5px;
  }

  .band__video {
    display: block;
    height: auto;
    aspect-ratio: 16 / 10;
    background: var(--color-background-secondary);
  }

  /* A band with prose but no pictures shouldn't leave a hole where they'd be. */
  .band__shots:empty {
    display: none;
  }

  .band__inner:has(.band__shots:empty) {
    grid-template-columns: minmax(0, 1fr);
    max-width: 68ch;
  }

  .band__inner:has(.band__shots:empty) .band__aside {
    position: static;
  }

  /* With the stack and the link under it, the last band's column is taller
     than a laptop screen, so it would pin with its foot out of sight: it
     scrolls with the page instead. */
  .band__aside--long {
    position: static;
  }

  /* The stack, what shipped and the site link, under the last band's text:
     the same column and left edge, a rule above to close off the text. */
  .band__extras {
    display: flex;
    flex-direction: column;
