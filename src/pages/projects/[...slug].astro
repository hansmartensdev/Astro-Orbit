---
/**
 * Work case study
 * URL: /projects/<slug>
 *
 * Built as a run of full-bleed bands rather than a column of sections. The
 * page changes temperature as you move down it — ink, ice, ink — so the
 * chapters are felt before they are read.
 *
 * Each band's heading is sticky: it pins while that band's captures scroll past
 * it, then the next band pushes it out. That ties a caption to the pictures it
 * belongs to without repeating it above every one.
 */
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import SiteLayout from '@/layouts/SiteLayout.astro';
import Placeholder from '@/components/site/Placeholder.astro';
import PillButton from '@/components/site/PillButton.astro';
import Cta from '@/components/sections/Cta.astro';

export async function getStaticPaths() {
  const projects = await getCollection('work', ({ data }) =>
    import.meta.env.PROD ? data.draft !== true : true
  );

  const ordered = [...projects].sort((a, b) => a.data.order - b.data.order);

  // "Next project" walks the portfolio as the grids show it: projects told
  // inside a story page (`parent`) are skipped, and from one of those the
  // door leads back to the story it belongs to.
  const ring = ordered.filter((project) => !project.data.parent);

  // A project with `story: true` has its own page file beside this one, and
  // Astro would otherwise build both to the same path. It stays in the ring so
  // "next project" still walks the whole portfolio.
  return ordered
    .map((project) => {
      const parent = project.data.parent
        ? ordered.find((candidate) => candidate.id === project.data.parent)
        : undefined;
      const next = parent ?? ring[(ring.indexOf(project) + 1) % ring.length];
      return { params: { slug: project.id }, props: { project, next } };
    })
    .filter(({ props }) => !props.project.data.story);
}

const { project, next } = Astro.props;
const { Content } = await render(project);

const {
  title,
  discipline,
  description,
  client,
  year,
  services,
  url,
  feature,
  featureMobile,
  cover,
  coverAlt,
  gallery,
  placeholder,
  challenge,
  solution,
  technologies,
  features,
  badge,
} = project.data;

// Only the facts that were actually filled in get a slot.
const facts = [
  client ? { label: 'Client', value: client } : null,
  year ? { label: 'Year', value: String(year) } : null,
  { label: 'Discipline', value: discipline },
  services.length ? { label: 'Services', value: services.join(', ') } : null,
].filter((fact) => fact !== null);

// The feature photograph leads the page the way it leads the card. The mockup
// is not dropped — it becomes the first capture in the bands below.
const hero = feature ?? cover;
// The phone version of the hero picture, if the project has one: composed
// for a narrow screen, shown whole at the top of the hero on phones.
const heroMobile = featureMobile
  ? await getImage({ src: featureMobile, widths: [600, 900, 1200, 1600], format: 'webp', quality: 90 })
  : null;
// The hero is ink with or without a picture, so the nav always reads light
// over it (navOverMedia below).
const shots = feature && cover ? [{ src: cover, alt: coverAlt ?? title }, ...gallery] : gallery;

/* The written half of a case study, split across two bands. Most projects have
   neither half written yet, so each band has to earn its place: one with no
   prose AND no captures isn't rendered rather than left as an empty heading.
   Captures are dealt between the bands so the page still has rhythm when the
   writing is missing. */
const half = Math.ceil(shots.length / 2);
const bands = [
  { key: 'problem', label: 'WHY I BUILT IT', prose: challenge, shots: shots.slice(0, half) },
  { key: 'solution', label: 'WHAT I BUILT', prose: solution, shots: shots.slice(half) },
].filter((band) => band.prose || band.shots.length > 0);

const hasBuild = technologies.length > 0 || features.length > 0;
const nextImage = next.data.feature ?? next.data.cover;
---

<SiteLayout
  title={title}
  description={description}
  image={hero?.src}
  imageAlt={coverAlt ?? title}
  navContext={client ?? title}
  navOverMedia
>
  <article class="case">
    {/* --- hero: full-bleed, viewport tall, type over the picture -------- */}
    <header class="case__hero">
      {
        hero ? (
          <picture class="case__hero-picture">
            {heroMobile && (
              <source
                media="(max-width: 700px)"
                srcset={heroMobile.srcSet.attribute}
                sizes="100vw"
                type="image/webp"
              />
            )}
            <Image
              src={hero}
              alt={coverAlt ?? title}
              layout="none"
              widths={[768, 1280, 1920, 2560]}
              quality={90}
              sizes="100vw"
              class:list={['case__hero-img', heroMobile && 'case__hero-img--has-mobile']}
              loading="eager"
              fetchpriority="high"
            />
          </picture>
        ) : (
          <div class="case__hero-img">
            <Placeholder class="h-full w-full rounded-none" invert label={placeholder ?? title} />
          </div>
        )
      }

      <div class="case__hero-scrim"></div>

      <div class="case__hero-body shell">
        <div class="case__eyebrow" data-reveal>
          <span class="label-mono">{discipline}</span>
          {badge && <span class="case__badge label-mono">{badge}</span>}
        </div>

        <h1 class="case__title" style={`--len: ${title.length}`} data-reveal="lift">{title}</h1>
        <p class="case__lede" data-reveal>{description}</p>
      </div>

      <span class="case__scroll label-mono" aria-hidden="true">scroll</span>
    </header>

    {/* --- facts: a thin ledger closing off the hero -------------------- */}
    <section class="case__ledger" aria-label="Project details">
      <dl class="case__ledger-inner shell">
        {
          facts.map((fact, i) => (
            <div class="case__fact" data-reveal data-reveal-delay={i * 0.08}>
              <dt class="label-mono">{fact.label.toUpperCase()}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    {/* --- alternating bands -------------------------------------------- */}
    {
      bands.map((band, i) => (
        <section class="band" data-tone={i % 2 === 0 ? 'ink' : 'ice'}>
          <div class="band__inner shell">
            <div class="band__aside">
              <span class="band__label label-mono" data-reveal>{band.label}</span>
              {band.prose && <p class="band__prose" data-reveal>{band.prose}</p>}
            </div>

            <div class="band__shots">
              {band.shots.map((shot, j) => (
                <Image
                  src={shot.src}
                  alt={shot.alt ?? title}
                  layout="none"
                  widths={[768, 1280, 1920]}
                  quality={90}
                  sizes="(max-width: 1000px) 100vw, 62vw"
                  class:list={['band__shot', 'frame' in shot && shot.frame && 'band__shot--framed']}
                  data-reveal
                  data-reveal-delay={j * 0.1}
                />
              ))}
            </div>
          </div>
        </section>
      ))
    }

    {/* --- stack + shipped ---------------------------------------------- */}
    {
      hasBuild && (
        <section class="case__build">
          <div class="case__build-inner shell">
            {technologies.length > 0 && (
              <div data-reveal>
                <span class="label-mono text-foreground-muted">STACK</span>
                <ul class="case__chips">
                  {technologies.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            )}
            {features.length > 0 && (
              <div data-reveal data-reveal-delay="0.1">
                <span class="label-mono text-foreground-muted">SHIPPED</span>
                <ul class="case__shipped">
                  {features.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </section>
      )
    }

    <div class="case__prose shell">
      <div class="prose" data-reveal-content>
        <Content />
      </div>
    </div>

    {
      url && (
        <div class="case__visit shell" data-reveal>
          <PillButton href={url} target="_blank" variant="solid">
            Visit the site
            <Icon name="lucide:arrow-up-right" aria-hidden="true" />
          </PillButton>
        </div>
      )
    }

    {/* --- next project: the text and a preview of it, on the page ground */}
    <a class="nextup" href={'/projects/' + next.id} data-card>
      <div class="nextup__inner shell">
        <div class="nextup__text" data-reveal>
          <span class="label-mono nextup__label">NEXT PROJECT</span>
          <span class="nextup__title" style={`--len: ${next.data.title.length}`}>{next.data.title}</span>
          <span class="nextup__line">{next.data.description}</span>
          <span class="nextup__go">
            View project
            <Icon name="lucide:arrow-right" aria-hidden="true" />
          </span>
        </div>
        <div class="nextup__preview" data-reveal data-reveal-delay="0.1">
          {
            nextImage ? (
              <Image
                src={nextImage}
                alt=""
                layout="none"
                widths={[640, 960, 1280, 1600]}
                quality={90}
                sizes="(max-width: 900px) 100vw, 50vw"
                class="nextup__img"
              />
            ) : (
              <span class="nextup__blank label-mono" aria-hidden="true">
                {next.data.title}
              </span>
            )
          }
        </div>
      </div>
    </a>
  </article>

  <Cta />
</SiteLayout>

<style>
  /* --- hero ------------------------------------------------------------ */

  .case__hero-picture {
    display: contents;
  }

  .case__hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 100svh;
    overflow: hidden;
    background: var(--ink-950);
    isolation: isolate;
  }

  .case__hero-img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Type sits on the picture, so the picture is made safe for type rather than
     the type given a box to hide in. */
  .case__hero-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to top, rgb(12 16 22 / 0.88) 0%, rgb(12 16 22 / 0.25) 46%, transparent 72%),
      linear-gradient(to right, rgb(12 16 22 / 0.55), transparent 60%);
  }

  .case__hero-body {
    padding-bottom: 88px;
    color: var(--ice-100);
  }

  .case__eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    color: rgb(238 242 244 / 0.72);
  }

  .case__badge {
    padding: 6px 13px;
    border: 1px solid rgb(238 242 244 / 0.28);
    border-radius: var(--radius-full);
  }

  .case__title {
    margin: 22px 0 0;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    text-transform: var(--display-case);
    /* Never wider than the page: a long one-word title (a domain name)
       shrinks to fit, about 0.52em per character in this face. */
    font-size: min(10vw, 148px, calc((100vw - 96px) / (var(--len, 10) * 0.52)));
    line-height: 0.92;
    letter-spacing: var(--display-tracking);
  }

  .case__lede {
    margin: 28px 0 0;
    max-width: 46ch;
    font-size: clamp(1.0625rem, 1.5vw, 1.375rem);
    line-height: 1.5;
    color: rgb(238 242 244 / 0.82);
  }

  .case__scroll {
    position: absolute;
    right: var(--gutter);
    bottom: 88px;
    color: rgb(238 242 244 / 0.6);
    writing-mode: vertical-rl;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  /* --- ledger ---------------------------------------------------------- */

  .case__ledger {
    background: var(--ink-950);
    color: var(--ice-100);
    border-top: 1px solid rgb(238 242 244 / 0.14);
  }

  .case__ledger-inner {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    padding-block: 36px 44px;
  }

  .case__fact dt {
    color: rgb(238 242 244 / 0.55);
  }

  .case__fact dd {
    margin: 12px 0 0;
    font-size: 17px;
    line-height: 1.45;
  }

  /* --- bands ----------------------------------------------------------- */

  .band {
    padding-block: clamp(80px, 11vw, 160px);
  }

  .band[data-tone='ink'] {
    background: var(--ink-950);
    color: var(--ice-100);
  }

  .band[data-tone='ice'] {
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .band__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.1fr);
    gap: 64px;
    align-items: start;
  }

  /* The heading pins while its own captures scroll past, then the next band
     pushes it out. `align-self: start` is what stops the sticky box being
     stretched to the row's full height, which would leave it sticking to
     nothing. */
  .band__aside {
    position: sticky;
    top: calc(var(--sw-nav-h, 76px) + 32px);
    align-self: start;
  }

  .band__label {
    display: block;
    opacity: 0.6;
  }

  .band__prose {
    margin: 22px 0 0;
    font-size: clamp(1.125rem, 1.7vw, 1.5rem);
    line-height: 1.45;
    letter-spacing: -0.01em;
  }

  .band__shots {
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 3vw, 40px);
  }

  .band__shot {
    width: 100%;
    border-radius: var(--radius-lg);
  }

  /* A capture whose edge is the page colour gets a border, so it reads as one
     picture instead of running into the page. */
  .band__shot--framed {
    border: 1px solid var(--color-border-strong);
  }

  /* On the dark band the border is a light line, or it would disappear. */
  .band[data-tone='ink'] .band__shot--framed {
    border-color: rgb(238 242 244 / 0.28);
  }

  /* A band with prose but no pictures shouldn't leave a hole where they'd be. */
  .band__shots:empty {
    display: none;
  }

  .band__inner:has(.band__shots:empty) {
    grid-template-columns: minmax(0, 1fr);
    max-width: 68ch;
  }

  .band__inner:has(.band__shots:empty) .band__aside {
    position: static;
  }

  /* --- build ----------------------------------------------------------- */

  .case__build {
    padding-block: clamp(64px, 8vw, 112px);
    background: var(--color-background);
  }

  .case__build-inner {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 56px;
    padding-top: 44px;
    border-top: 1px solid var(--color-border);
  }

  .case__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }

  .case__chips li {
    padding: 8px 16px;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-full);
    font-size: 14px;
    font-weight: 500;
  }

  .case__shipped {
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }

  .case__shipped li {
    padding-block: 13px;
    border-bottom: 1px solid var(--color-border);
    font-size: 17px;
  }

  .case__shipped li:last-child {
    border-bottom: 0;
  }

  /* --- prose + visit ---------------------------------------------------- */

  .case__prose {
    padding-block: 8px;
  }

  /* Velocity's .prose centres on a 65ch column; here it sits in the page
     gutter alongside everything else. */
  .prose {
    max-width: 680px;
  }

  .prose:empty {
    display: none;
  }

  .case__visit {
    padding-block: 40px 96px;
  }

  /* --- next project -----------------------------------------------------
     Light, on the page ground, so it stands apart from the ink footer
     below: the next project's label, title, line and a violet button on
     the left, a preview card of it on the right (its picture, or the
     violet glow when it has none yet). */
  .nextup {
    display: block;
    padding-block: clamp(64px, 8vw, 112px);
    border-top: 1px solid var(--color-border);
    color: var(--color-foreground);
    text-decoration: none;
  }

  .nextup__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }

  .nextup__label {
    color: var(--color-foreground-muted);
  }

  .nextup__title {
    display: block;
    margin-top: 14px;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    text-transform: var(--display-case);
    font-size: min(6vw, 88px, calc((50vw - 96px) / (var(--len, 10) * 0.52)));
    line-height: 1;
    letter-spacing: var(--display-tracking);
  }

  .nextup__line {
    display: block;
    max-width: 44ch;
    margin-top: 18px;
    font-size: 18px;
    line-height: 1.55;
    color: var(--color-foreground-secondary);
  }

  .nextup__go {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 32px;
    padding: 16px 28px;
    border-radius: var(--radius-full);
    background: var(--hero-accent, #7c3aed);
    color: #fff;
    font-weight: 600;
    font-size: 16px;
  }

  .nextup__go :global(svg) {
    width: 18px;
    height: 18px;
    transition: transform 0.35s var(--ease-sw);
  }

  .nextup:hover .nextup__go :global(svg) {
    transform: translateX(4px);
  }

  .nextup:focus-visible {
    outline: 2px solid var(--hero-accent, #7c3aed);
    outline-offset: -4px;
  }

  .nextup__preview {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 18px;
    background-color: #0c1016;
    background-image: radial-gradient(circle at 0% 100%, rgb(124 58 237 / 0.55), rgb(124 58 237 / 0) 55%);
    box-shadow: 0 30px 60px -36px rgb(12 16 22 / 0.45);
  }

  .nextup__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease-sw);
  }

  .nextup:hover .nextup__img {
    transform: scale(1.04);
  }

  .nextup__blank {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--hero-accent-on-ink, #a78bfa);
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .nextup__inner {
      grid-template-columns: minmax(0, 1fr);
    }

    .nextup__preview {
      order: -1;
    }

    .nextup__title {
      font-size: min(13vw, calc((100vw - 48px) / (var(--len, 10) * 0.52)));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nextup__img,
    .nextup__go :global(svg) {
      transition: none;
    }
  }

  @media (max-width: 1000px) {
    .band__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }

    /* One column means the heading has nothing to pin beside. */
    .band__aside {
      position: static;
    }

    .case__ledger-inner {
      grid-template-columns: repeat(2, 1fr);
      gap: 28px;
    }
  }

  @media (max-width: 800px) {
    .case__hero-body {
      padding-bottom: 56px;
    }

    .case__title {
      font-size: min(15vw, calc((100vw - 48px) / (var(--len, 10) * 0.52)));
    }

    /* With a phone picture: the hero is the picture, shown whole below the
       nav, fading into the ink at its foot, with the title right under it.
       No full-screen hero with a gap, no hard edge, nothing under the nav. */
    .case__hero:has(.case__hero-img--has-mobile) {
      flex-direction: column;
      align-items: stretch;
      min-height: 0;
      padding-top: calc(var(--sw-nav-h, 72px) + 8px);
    }

    .case__hero-img--has-mobile {
      position: relative;
      inset: auto;
      z-index: 0;
      height: auto;
      aspect-ratio: 1200 / 940;
      object-fit: cover;
      -webkit-mask-image: linear-gradient(to bottom, transparent, #000 14%, #000 70%, transparent);
      mask-image: linear-gradient(to bottom, transparent, #000 14%, #000 70%, transparent);
    }

    .case__hero:has(.case__hero-img--has-mobile) .case__hero-scrim {
      display: none;
    }

    .case__hero:has(.case__hero-img--has-mobile) .case__hero-body {
      margin-top: -24px;
    }

    .case__lede {
      font-size: 1rem;
      margin-top: 20px;
    }

    .case__scroll {
      display: none;
    }

    .case__build-inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }

  }
</style>
