---
import ProjectView from '@/views/ProjectView.astro';
import { defaultLocale } from '@/i18n';
import { getProjects, getProjectSlug } from '@/lib/projects';

export async function getStaticPaths() {
  const projects = await getProjects(defaultLocale);
  return projects.map((project) => ({ params: { slug: getProjectSlug(project) }, props: { project } }));
}

const { project } = Astro.props;
---

<ProjectView project={project} />
