---
/**
 * Homepage
 * URL: /
 */
import SiteLayout from '@/layouts/SiteLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import Reel from '@/components/sections/Reel.astro';
import WorkGrid from '@/components/sections/WorkGrid.astro';
import FeaturedPosts from '@/components/sections/FeaturedPosts.astro';
import Cta from '@/components/sections/Cta.astro';
import Services from '@/components/sections/Services.astro';
import { services } from '@/config/services.config';
import siteConfig from '@/config/site.config';
---

<SiteLayout
  title="Astro Developer in Veghel, the Netherlands"
  description={siteConfig.description}
  includeOrgSchema
>
  <Hero />
  {/* The droplet lands beside the reel's headline and blooms into the
      statement card (StatementCard.astro). */}
  <Reel />
  {
    /* Four lands on a row boundary: the full-width lead over two rows, then
      the pattern's first segment (a large card beside two standard ones)
      over two more. Project five and six stay on /projects. */
  }
  <WorkGrid count={4} deliverLead />
  {/* What I do: the four stacked cards (config/services.config.ts; show: false removes them). */}
  {services.show && <Services />}
  {
    /* The violet band about Astro Orbit (@/components/sections/ThemeBand.astro,
      with `released`) is parked off the homepage for now, to use elsewhere
      later. */
  }
  {/* Four posts across the full width: those marked featured: true first,
      then the newest. */}
  <FeaturedPosts count={4} />
  {
    /* The founder section (@/components/sections/Founder.astro) is parked
      off the homepage for now; it runs on /about. */
  }
  <Cta />
</SiteLayout>
