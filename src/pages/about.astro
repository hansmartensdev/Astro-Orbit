---
/**
 * About page
 * URL: /about (was /studio; the old address redirects, see astro.config.mjs)
 *
 * In the style of the project and blog pages (Hans's choice): a cinema hero
 * (the violet grid with the hm/ mark, the name large at its foot, the
 * introduction beside it and four facts in a frosted strip), then sections
 * that take turns on the page ground and the second ground. The facts come
 * from the earlier About page and Hans's post "Hi, I'm Hans Martens".
 *
 * The About card (sections/Founder.astro) is parked, not deleted. His photo
 * comes later, from a photographer: it would take the mark's place in the
 * hero.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import SiteLayout from '@/layouts/SiteLayout.astro';
import StackMarquee from '@/components/sections/StackMarquee.astro';
import Cta from '@/components/sections/Cta.astro';

const facts = [
  { label: 'Based in', value: 'Veghel, the Netherlands' },
  { label: 'Websites since', value: '2010' },
  { label: 'Astro since', value: '2022' },
  { label: 'Builds with', value: 'Claude Code' },
];

// From "Hi, I'm Hans Martens", one sentence a year.
const timeline = [
  {
    year: '1992',
    text: "I bought a new computer, and I've been interested in both the operating system and the hardware ever since.",
  },
  { year: '1998', text: 'I built my first computer from parts.' },
  {
    year: '2000',
    text: 'I started working as a computer service engineer, repairing laptops, seconded to the Eindhoven University of Technology.',
  },
  {
    year: '2010',
    text: "I built my first website with WordPress, for myself, and I've never stopped building websites.",
  },
  { year: '2022', text: 'I moved to Astro and stayed.' },
  {
    year: 'Now',
    text: 'I work with Astro every day. I build websites and free Astro themes for the Astro community.',
  },
];

// The projects with a picture, in portfolio order: the placeholders have
// none, so they stay out.
const work = (
  await getCollection('work', ({ data }) => data.draft !== true && !data.parent && Boolean(data.feature))
)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<SiteLayout
  title="About"
  description="About Hans Martens, an Astro developer in Veghel, the Netherlands, building fast &amp; beautiful websites."
  includeOrgSchema
>
  {/* --- hero: the cinema of the project pages --------------------------- */}
  <header class="ab-hero">
    <div class="ab-hero__art">
      <span class="ab-hero__mark" aria-hidden="true">hm/</span>
    </div>
    <div class="ab-hero__scrim" aria-hidden="true"></div>

    <div class="ab-hero__body shell">
      <span class="label-mono ab-hero__label">ABOUT</span>
      <h1 class="ab-hero__title">Hans Martens</h1>
      <p class="ab-hero__desc">
        I'm Hans Martens, an Astro developer in Veghel, the Netherlands. I design and build my own
        websites and free Astro themes.
      </p>
    </div>

    <div class="ab-hero__ledger" role="group" aria-label="About me in short">
      <dl class="ab-hero__facts shell">
        {
          facts.map((fact) => (
            <div>
              <dt class="label-mono">{fact.label.toUpperCase()}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </header>

  {/* --- the years ------------------------------------------------------- */}
  <section class="ab">
    <div class="shell">
      <span class="label-mono ab__label" data-reveal>FROM 1992 TO NOW</span>
      <h2 class="ab__h" data-reveal>Computers first, then websites</h2>
      <ol class="ab-tl">
        {
          timeline.map((item, i) => (
            <li data-reveal data-reveal-delay={(i % 3) * 0.08}>
              <span class="ab-tl__year">{item.year}</span>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* --- why, in Hans's own words ---------------------------------------- */}
  <section class="ab ab--alt">
    <div class="shell ab__split">
      <h2 class="ab__big" data-reveal>Design and code, <em>for the love of it</em></h2>
      <div class="ab__prose" data-reveal data-reveal-delay="0.1">
        <p class="ab__first">Web design and development are my craft.</p>
        <p>
          What draws me to this work is where design and technology meet. Getting that intersection
          right — making something that is both beautifully designed and technically solid — is what I
          find satisfying. That's why I keep doing it.
        </p>
      </div>
    </div>
  </section>

  {/* --- what I build now ------------------------------------------------ */}
  <section class="ab">
    <div class="shell">
      <span class="label-mono ab__label" data-reveal>WHAT I BUILD NOW</span>
      <h2 class="ab__h" data-reveal>My website and my free themes</h2>
      <div class="ab-work">
        {
          work.map((project, i) => (
            <a class="ab-work__card" href={`/projects/${project.id}/`} data-card data-reveal data-reveal-delay={i * 0.08}>
              <span class="ab-work__pic">
                {project.data.feature && (
                  <Image
                    src={project.data.feature}
                    alt=""
                    layout="none"
                    widths={[480, 720, 960, 1280]}
                    sizes="(max-width: 800px) 100vw, 33vw"
                    class="ab-work__img"
                  />
                )}
              </span>
              <span class="label-mono ab-work__discipline">{project.data.discipline.toUpperCase()}</span>
              <span class="ab-work__title">{project.data.title}</span>
              <span class="ab-work__go">
                View project
                <Icon name="lucide:arrow-right" aria-hidden="true" />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* --- tools ----------------------------------------------------------- */}
  <section class="ab ab--alt ab--tools">
    <div class="shell ab__split ab__split--tools">
      <div data-reveal>
        <span class="label-mono ab__label">TOOLS</span>
        <h2 class="ab__h">What I work with</h2>
      </div>
      <p class="ab__line" data-reveal data-reveal-delay="0.1">
        I use Claude Code to build my websites. I often use Ubuntu Linux on my dual-boot laptop, I'm
        interested in the Raspberry Pi, and my phone is an iPhone.
      </p>
    </div>
    <div class="ab__marquee" data-reveal>
      <StackMarquee />
    </div>
  </section>

  <Cta />
</SiteLayout>

<style>
  /* --- hero ------------------------------------------------------------ */
  .ab-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 100svh;
    padding-top: calc(var(--sw-nav-h, 72px) + 24px);
    background: var(--background);
  }

  /* The violet grid of the blog covers, with the mark drawn large. */
  .ab-hero__art {
    position: absolute;
    inset: 0;
    z-index: -2;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--orbit-950) 14%, var(--orbit-fill)),
      var(--orbit-950)
    );
  }

  .ab-hero__art::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0.16;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.35) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.35) 1px, transparent 1px);
    background-size: 64px 64px;
  }

  .ab-hero__mark {
    position: absolute;
    left: 50%;
    top: 38%;
    translate: -50% -50%;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: min(15vw, 24svh);
    line-height: 1;
    letter-spacing: -0.06em;
    color: #fff;
    text-shadow: 0 0 80px rgb(255 255 255 / 0.35);
  }

  /* The page ground over the art's foot (light in light mode, ink in dark),
     and a little at the top for the nav. */
  .ab-hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(
        to top,
        color-mix(in srgb, var(--background) 96%, transparent) 0%,
        color-mix(in srgb, var(--background) 62%, transparent) 30%,
        transparent 62%
      ),
      linear-gradient(to bottom, color-mix(in srgb, var(--background) 55%, transparent), transparent 22%);
  }

  .ab-hero__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 36ch);
    align-items: end;
    column-gap: 48px;
    width: 100%;
    padding-bottom: 48px;
    color: var(--foreground);
  }

  .ab-hero__label {
    grid-column: 1;
    margin-bottom: 14px;
    color: var(--foreground-secondary);
  }

  .ab-hero__title {
    grid-column: 1;
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    text-transform: var(--display-case);
    letter-spacing: var(--display-tracking);
    font-size: clamp(3.4rem, 9vw, 9rem);
    line-height: 0.9;
  }

  .ab-hero__desc {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: end;
    margin: 0 0 10px;
    font-size: 19px;
    line-height: 1.55;
    color: var(--foreground-secondary);
  }

  .ab-hero__ledger {
    width: 100%;
    border-top: 1px solid var(--border-strong);
    background: color-mix(in srgb, var(--background) 55%, transparent);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    color: var(--foreground);
  }

  .ab-hero__facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px;
    margin: 0;
    padding-block: 26px 30px;
  }

  .ab-hero__facts dt {
    color: var(--foreground-muted);
  }

  .ab-hero__facts dd {
    margin: 12px 0 0;
    font-size: 17px;
    line-height: 1.45;
  }

  /* --- sections: the zebra --------------------------------------------- */
  .ab {
    padding-block: clamp(88px, 11vw, 160px);
    background: var(--background);
    color: var(--foreground);
  }

  .ab--alt {
    background: var(--background-secondary);
  }

  .ab__label {
    display: block;
    color: var(--foreground-muted);
  }

  .ab__h {
    margin: 16px 0 0;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    text-transform: var(--display-case);
    letter-spacing: var(--display-tracking);
    font-size: clamp(2.2rem, 4vw, 3.8rem);
    line-height: 1;
  }

  /* The years: large, in the accent, over a rule. */
  .ab-tl {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 40px;
    margin: clamp(48px, 6vw, 80px) 0 0;
    padding: 0;
    list-style: none;
  }

  .ab-tl li {
    padding: 32px 0 40px;
    border-top: 1px solid var(--border-strong);
  }

  .ab-tl__year {
    display: block;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: clamp(3.4rem, 6vw, 6rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
    color: var(--hero-accent);
  }

  .ab-tl p {
    max-width: 34ch;
    margin: 18px 0 0;
    font-size: 18px;
    line-height: 1.55;
    color: var(--foreground-secondary);
  }

  .ab__split {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 64px;
    align-items: start;
  }

  .ab__big {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    text-transform: var(--display-case);
    letter-spacing: var(--display-tracking);
    font-size: clamp(2.8rem, 5.4vw, 5.4rem);
    line-height: 0.95;
  }

  .ab__big em {
    font-style: normal;
    color: var(--hero-accent);
  }

  .ab__prose p {
    margin: 0 0 1.2em;
    font-size: clamp(1.2rem, 1.7vw, 1.5rem);
    line-height: 1.5;
    color: var(--foreground-secondary);
  }

  .ab__prose p:last-child {
    margin-bottom: 0;
  }

  .ab__prose .ab__first {
    font-weight: 500;
    color: var(--foreground);
  }

  /* The projects as cards: picture, discipline, name, link. */
  .ab-work {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin-top: clamp(48px, 6vw, 72px);
  }

  .ab-work__card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    color: inherit;
    text-decoration: none;
  }

  .ab-work__card:focus-visible {
    outline: 2px solid var(--hero-accent, var(--orbit-600));
    outline-offset: 6px;
    border-radius: 20px;
  }

  .ab-work__pic {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 20px;
    background: #0c1016;
  }

  .ab-work__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 1s var(--ease-sw);
  }

  .ab-work__card:hover .ab-work__img {
    scale: 1.04;
  }

  .ab-work__discipline {
    margin-top: 20px;
    color: var(--foreground-muted);
  }

  .ab-work__title {
    margin-top: 8px;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    text-transform: var(--display-case);
    letter-spacing: var(--display-tracking);
    font-size: clamp(1.8rem, 2.6vw, 2.5rem);
    line-height: 1;
  }

  .ab-work__go {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
    font-weight: 600;
    font-size: 16px;
  }

  .ab-work__go :global(svg) {
    width: 18px;
    height: 18px;
    transition: transform 0.35s var(--ease-sw);
  }

  .ab-work__card:hover .ab-work__go :global(svg) {
    transform: translateX(4px);
  }

  /* Tools: the line beside the heading, the moving row under both. */
  .ab--tools {
    padding-bottom: clamp(64px, 8vw, 112px);
  }

  .ab__split--tools {
    align-items: end;
  }

  .ab__line {
    max-width: 46ch;
    margin: 0;
    font-size: clamp(1.1rem, 1.5vw, 1.35rem);
    line-height: 1.55;
    color: var(--foreground-secondary);
  }

  .ab__marquee {
    margin-top: clamp(48px, 6vw, 72px);
  }

  /* The tool cards were made for the ink About card; here they sit on the
     page grounds. */
  .ab__marquee :global(.smq__item) {
    border-color: var(--border-strong);
    background: var(--background-elevated);
  }

  .ab__marquee :global(.smq__icon) {
    color: var(--hero-accent);
  }

  :global(.dark) .ab__marquee :global(.smq__icon) {
    color: var(--orbit-300);
  }

  .ab__marquee :global(.smq__name) {
    color: var(--foreground);
  }

  @media (prefers-reduced-motion: reduce) {
    .ab-work__img,
    .ab-work__go :global(svg) {
      transition: none;
    }
  }

  @media (max-width: 1000px) {
    .ab-tl,
    .ab-work {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .ab-hero__facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px;
    }
  }

  /* Phones and tablets held upright: the art at the top, fading out, and
     the name, the line and the facts under it on the page ground. */
  @media (max-width: 800px), (max-width: 1100px) and (orientation: portrait) {
    .ab-hero {
      min-height: 0;
      padding-top: 0;
    }

    .ab-hero__art {
      position: relative;
      inset: auto;
      height: 60svh;
      -webkit-mask-image: linear-gradient(#000 70%, transparent);
      mask-image: linear-gradient(#000 70%, transparent);
    }

    .ab-hero__mark {
      top: 52%;
      font-size: min(24vw, 20svh);
    }

    .ab-hero__scrim {
      display: none;
    }

    .ab-hero__body {
      grid-template-columns: minmax(0, 1fr);
      margin-top: -24px;
      padding-bottom: 40px;
    }

    .ab-hero__desc {
      grid-column: 1;
      grid-row: auto;
      margin: 20px 0 0;
      font-size: 17px;
    }

    .ab-hero__title {
      font-size: clamp(2.8rem, 14vw, 4.4rem);
    }

    .ab-hero__ledger {
      background: var(--background);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  @media (max-width: 800px) {
    .ab-tl,
    .ab-work,
    .ab__split {
      grid-template-columns: minmax(0, 1fr);
    }

    .ab__split {
      gap: 28px;
    }
  }
</style>
