---
/**
 * About page
 * URL: /about (was /studio; the old address redirects, see astro.config.mjs)
 *
 * In the style of the project and blog pages (Hans's choice): the shared
 * cinema hero (site/CinemaHero.astro) with Hans's photo (Hans's own,
 * assets/about/hans-martens.jpg), then sections that take turns on the
 * page ground and the second ground. The facts come from the earlier About
 * page and Hans's post "Hi, I'm Hans Martens".
 *
 * The About card (sections/Founder.astro) is parked, not deleted.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import SiteLayout from '@/layouts/SiteLayout.astro';
import CinemaHero from '@/components/site/CinemaHero.astro';
import portrait from '@/assets/about/hans-martens.jpg';
import StackMarquee from '@/components/sections/StackMarquee.astro';
import Cta from '@/components/sections/Cta.astro';

const facts = [
  { label: 'Based in', value: 'Veghel, the Netherlands' },
  { label: 'Websites since', value: '2010' },
  { label: 'Astro since', value: '2022' },
  { label: 'Builds with', value: 'Claude Code' },
];

// From "Hi, I'm Hans Martens", one sentence a year.
const timeline = [
  {
    year: '1992',
    text: "I bought a new computer, and I've been interested in both the operating system and the hardware ever since.",
  },
  { year: '1998', text: 'I built my first computer from parts.' },
  {
    year: '2000',
    text: 'I started working as a computer service engineer, repairing laptops, seconded to the Eindhoven University of Technology.',
  },
  {
    year: '2010',
    text: "I built my first website with WordPress, for myself, and I've never stopped building websites.",
  },
  { year: '2022', text: 'I moved to Astro and stayed.' },
  {
    year: 'Now',
    text: 'I work with Astro every day. I build websites and free Astro themes for the Astro community.',
  },
];

// The projects with a picture, in portfolio order: the placeholders have
// none, so they stay out.
const work = (
  await getCollection('work', ({ data }) => data.draft !== true && !data.parent && Boolean(data.feature))
)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<SiteLayout
  title="About"
  description="About Hans Martens, an Astro developer in Veghel, the Netherlands, building fast &amp; beautiful websites."
  includeOrgSchema
  navOverMedia
>
  <CinemaHero
    label="ABOUT"
    title="Hans Martens"
    description="I'm Hans Martens, an Astro developer in Veghel, the Netherlands. I design and build my own websites and free Astro themes."
    facts={facts}
    factsLabel="About me in short"
    image={portrait}
    imageAlt="Hans Martens in a green field under a blue sky with white clouds"
    imagePosition="50% 30%"
  />

  {/* --- the years ------------------------------------------------------- */}
  <section class="ab">
    <div class="shell">
      <span class="label-mono ab__label" data-reveal>FROM 1992 TO NOW</span>
      <h2 class="ab__h" data-reveal>Computers first, then websites</h2>
      <ol class="ab-tl">
        {
          timeline.map((item, i) => (
            <li data-reveal data-reveal-delay={(i % 3) * 0.08}>
              {/* A year counts up when it scrolls into view (the script
                  below); screen readers get the year itself. */}
              <span class="ab-tl__year">
                {/^\d+$/.test(item.year) ? (
                  <>
                    <span aria-hidden="true" data-count={item.year}>{item.year}</span>
                    <span class="sr-only">{item.year}</span>
                  </>
                ) : (
                  item.year
                )}
              </span>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* --- why, in Hans's own words ---------------------------------------- */}
  <section class="ab ab--alt">
    <div class="shell ab__split">
      <h2 class="ab__big" data-reveal>Design and code, <em>for the love of it</em></h2>
      <div class="ab__prose" data-reveal data-reveal-delay="0.1">
        <p class="ab__first">Web design and development are my craft.</p>
        <p>
          What draws me to this work is where design and technology meet. Getting that intersection
          right — making something that is both beautifully designed and technically solid — is what I
          find satisfying. That's why I keep doing it.
        </p>
      </div>
    </div>
  </section>

  {/* --- what I build now ------------------------------------------------ */}
  <section class="ab">
    <div class="shell">
      <span class="label-mono ab__label" data-reveal>WHAT I BUILD NOW</span>
      <h2 class="ab__h" data-reveal>My website and my free themes</h2>
      <div class="ab-work">
        {
          work.map((project, i) => (
            <a class="ab-work__card" href={`/projects/${project.id}/`} data-card data-reveal data-reveal-delay={i * 0.08}>
              <span class="ab-work__pic">
                {project.data.feature && (
                  <Image
                    src={project.data.feature}
                    alt=""
                    layout="none"
                    widths={[480, 720, 960, 1280]}
                    sizes="(max-width: 800px) 100vw, 33vw"
                    class="ab-work__img"
                  />
                )}
              </span>
              <span class="label-mono ab-work__discipline">{project.data.discipline.toUpperCase()}</span>
              <span class="ab-work__title">{project.data.title}</span>
              <span class="ab-work__go">
                View project
                <Icon name="lucide:arrow-right" aria-hidden="true" />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* --- tools ----------------------------------------------------------- */}
  <section class="ab ab--alt ab--tools">
    <div class="shell ab__split ab__split--tools">
      <div data-reveal>
        <span class="label-mono ab__label">TOOLS</span>
        <h2 class="ab__h">What I work with</h2>
      </div>
      <p class="ab__line" data-reveal data-reveal-delay="0.1">
        I use Claude Code to build my websites. I often use Ubuntu Linux on my dual-boot laptop, I'm
        interested in the Raspberry Pi, and my phone is an iPhone.
      </p>
    </div>
    <div class="ab__marquee" data-reveal>
      <StackMarquee />
    </div>
  </section>

  <Cta />
</SiteLayout>

<style>
  /* --- sections: the zebra --------------------------------------------- */
  .ab {
    padding-block: clamp(88px, 11vw, 160px);
    background: var(--background);
    color: var(--foreground);
  }

  .ab--alt {
    background: var(--background-secondary);
  }

  .ab__label {
    display: block;
    color: var(--foreground-muted);
  }

  .ab__h {
    margin: 16px 0 0;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    text-transform: var(--display-case);
    letter-spacing: var(--display-tracking);
    font-size: clamp(2.2rem, 4vw, 3.8rem);
    line-height: 1;
  }

  /* The years: large, in the accent, over a rule. */
  .ab-tl {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 40px;
    margin: clamp(48px, 6vw, 80px) 0 0;
    padding: 0;
    list-style: none;
  }

  .ab-tl li {
    padding: 32px 0 40px;
    border-top: 1px solid var(--border-strong);
  }

  .ab-tl__year {
    display: block;
    font-variant-numeric: tabular-nums;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: clamp(3.4rem, 6vw, 6rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
    color: var(--hero-accent);
  }

  .ab-tl p {
    max-width: 34ch;
    margin: 18px 0 0;
    font-size: 18px;
    line-height: 1.55;
    color: var(--foreground-secondary);
  }

  .ab__split {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 64px;
    align-items: start;
  }

  .ab__big {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    text-transform: var(--display-case);
    letter-spacing: var(--display-tracking);
    font-size: clamp(2.8rem, 5.4vw, 5.4rem);
    line-height: 0.95;
  }

  .ab__big em {
    font-style: normal;
    color: var(--hero-accent);
  }

  .ab__prose p {
    margin: 0 0 1.2em;
    font-size: clamp(1.2rem, 1.7vw, 1.5rem);
    line-height: 1.5;
    color: var(--foreground-secondary);
  }

  .ab__prose p:last-child {
    margin-bottom: 0;
  }

  .ab__prose .ab__first {
    font-weight: 500;
    color: var(--foreground);
  }

  /* The projects as cards: picture, discipline, name, link. */
  .ab-work {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin-top: clamp(48px, 6vw, 72px);
  }

  .ab-work__card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    color: inherit;
    text-decoration: none;
  }

  .ab-work__card:focus-visible {
    outline: 2px solid var(--hero-accent, var(--orbit-600));
    outline-offset: 6px;
    border-radius: 20px;
  }

  .ab-work__pic {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 20px;
    background: #0c1016;
  }

  .ab-work__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 1s var(--ease-sw);
  }

  .ab-work__card:hover .ab-work__img {
    scale: 1.04;
  }

  .ab-work__discipline {
    margin-top: 20px;
    color: var(--foreground-muted);
  }

  .ab-work__title {
    margin-top: 8px;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    text-transform: var(--display-case);
    letter-spacing: var(--display-tracking);
    font-size: clamp(1.8rem, 2.6vw, 2.5rem);
    line-height: 1;
  }

  .ab-work__go {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
    font-weight: 600;
    font-size: 16px;
  }

  .ab-work__go :global(svg) {
    width: 18px;
    height: 18px;
    transition: transform 0.35s var(--ease-sw);
  }

  .ab-work__card:hover .ab-work__go :global(svg) {
    transform: translateX(4px);
  }

  /* Tools: the line beside the heading, the moving row under both. */
  .ab--tools {
    padding-bottom: clamp(64px, 8vw, 112px);
  }

  .ab__split--tools {
    align-items: end;
  }

  .ab__line {
    max-width: 46ch;
    margin: 0;
    font-size: clamp(1.1rem, 1.5vw, 1.35rem);
    line-height: 1.55;
    color: var(--foreground-secondary);
  }

  .ab__marquee {
    margin-top: clamp(48px, 6vw, 72px);
  }

  /* The tool cards were made for the ink About card; here they sit on the
     page grounds. */
  .ab__marquee :global(.smq__item) {
    border-color: var(--border-strong);
    background: var(--background-elevated);
  }

  .ab__marquee :global(.smq__icon) {
    color: var(--hero-accent);
  }

  :global(.dark) .ab__marquee :global(.smq__icon) {
    color: var(--orbit-300);
  }

  .ab__marquee :global(.smq__name) {
    color: var(--foreground);
  }

  @media (prefers-reduced-motion: reduce) {
    .ab-work__img,
    .ab-work__go :global(svg) {
      transition: none;
    }
  }

  @media (max-width: 1000px) {
    .ab-tl,
    .ab-work {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 800px) {
    .ab-tl,
    .ab-work,
    .ab__split {
      grid-template-columns: minmax(0, 1fr);
    }

    .ab__split {
      gap: 28px;
    }
  }
</style>

<script>
  /* The years in the timeline count up from 0 when they scroll into view,
     fast at first and slowing into the year (an ease-out), each once. The
     page holds the years themselves, so without the script, or under
     reduced motion, they simply show. */
  const DURATION = 1400;

  function initCount() {
    const els = [...document.querySelectorAll<HTMLElement>('[data-count]')].filter(
      (el) => !el.dataset.counted
    );
    if (!els.length || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const run = (el: HTMLElement) => {
      const end = Number(el.dataset.count);
      const start = performance.now();
      const tick = (now: number) => {
        const t = Math.min((now - start) / DURATION, 1);
        const eased = 1 - Math.pow(1 - t, 4);
        el.textContent = String(Math.round(end * eased));
        if (t < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const el = entry.target as HTMLElement;
          io.unobserve(el);
          run(el);
        }
      },
      { rootMargin: '0px 0px -15% 0px' }
    );

    for (const el of els) {
      el.dataset.counted = 'true';
      el.textContent = '0';
      io.observe(el);
    }
  }

  initCount();
  document.addEventListener('astro:after-swap', initCount);
</script>
