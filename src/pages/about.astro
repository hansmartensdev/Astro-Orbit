---
/**
 * About page
 * URL: /about (was /studio; the old address redirects, see astro.config.mjs)
 *
 * Who Hans is: the intro and the personal card, with the facts from his own
 * introduction post in other words. His photos come later, from a photographer.
 */
import SiteLayout from '@/layouts/SiteLayout.astro';
import SectionHead from '@/components/sections/SectionHead.astro';
import Founder from '@/components/sections/Founder.astro';
import Cta from '@/components/sections/Cta.astro';
import siteConfig from '@/config/site.config';
---

<SiteLayout
  title="About"
  description="About Hans Martens, an Astro developer in Veghel, the Netherlands, building fast &amp; beautiful websites."
  includeOrgSchema
>
  <header class="shell pt-[180px] max-[800px]:pt-[130px]">
    <SectionHead
      as="h1"
      title="About"
      blurb="I'm Hans Martens, an Astro developer in Veghel, the Netherlands. I design and build my own websites and free Astro themes."
    />
  </header>

  {/* The wide photo of Hans at work comes from a photographer; it goes here,
      as an <Image /> in a block like the one in git history (h-[52vh],
      rounded-[14px]), when it exists. */}

  <section class="mt-20 shell max-[800px]:mt-12" data-reveal>
    {/* The facts. The large line that stood above them repeated the header
        blurb, so it's gone. */}
    <dl class="grid grid-cols-3 gap-10 border-t border-border pt-10 max-[800px]:grid-cols-1">
      <div>
        <dt class="label-mono text-foreground-muted">BASED IN</dt>
        <dd class="mt-3 ml-0 text-[17px]">{siteConfig.location}</dd>
      </div>
      <div>
        <dt class="label-mono text-foreground-muted">BUILDS WITH</dt>
        <dd class="mt-3 ml-0 text-[17px]">Astro</dd>
      </div>
      <div>
        <dt class="label-mono text-foreground-muted">SAY HI</dt>
        <dd class="mt-3 ml-0 text-[17px]">
          <a href={'mailto:' + siteConfig.email}>{siteConfig.email}</a>
        </dd>
      </div>
    </dl>
  </section>

  <Founder />

  {/* Why Hans does this work, in his own words. */}
  <section class="shell mt-28 max-[800px]:mt-16" data-reveal>
    <div class="grid grid-cols-[minmax(0,1fr)_minmax(0,1fr)] gap-16 border-t border-border pt-12 max-[800px]:grid-cols-1 max-[800px]:gap-6 max-[800px]:pt-10">
      <h2 class="display-service about-craft__title m-0">Design and code, <em>for the love of it</em></h2>
      <div class="about-craft max-w-[560px]">
        <p>Web design and development are my craft.</p>
        <p>
          What draws me to this work is where design and technology meet. Getting that intersection
          right — making something that is both beautifully designed and technically solid — is what I
          find satisfying. That's why I keep doing it.
        </p>
      </div>
    </div>
  </section>

  <Cta />
</SiteLayout>

<style>
  .about-craft p {
    margin: 0;
    font-size: 19px;
    line-height: 1.6;
    color: var(--color-foreground-secondary);
  }

  .about-craft p:first-child {
    color: var(--color-foreground);
    font-weight: 500;
  }

  .about-craft p + p {
    margin-top: 1.2em;
  }

  /* On a phone the section-card size drops below the text under it; the
     heading keeps the page-title size there instead. */
  @media (max-width: 800px) {
    .about-craft__title {
      font-size: clamp(34px, 9.4vw, 44px);
      text-wrap: balance;
    }
  }
</style>
