---
/**
 * About page
 * URL: /about (was /studio; the old address redirects, see astro.config.mjs)
 *
 * Who Hans is: the intro and the personal card, with the facts from his own
 * introduction. His photos come later, from a photographer.
 */
import SiteLayout from '@/layouts/SiteLayout.astro';
import SectionHead from '@/components/sections/SectionHead.astro';
import Founder from '@/components/sections/Founder.astro';
import Cta from '@/components/sections/Cta.astro';
import siteConfig from '@/config/site.config';
---

<SiteLayout
  title="About"
  description="About Hans Martens, an Astro developer in Veghel, the Netherlands, building fast &amp; beautiful websites."
  includeOrgSchema
>
  <header class="shell pt-[180px] max-[800px]:pt-[130px]">
    <SectionHead
      as="h1"
      title="About"
      blurb="I'm Hans, an Astro developer in Veghel, the Netherlands. I design and build my own websites and free Astro themes."
    />
  </header>

  {/* The wide photo of Hans at work comes from a photographer; it goes here,
      as an <Image /> in a block like the one in git history (h-[52vh],
      rounded-[14px]), when it exists. */}

  <section class="mt-20 shell max-[800px]:mt-12" data-reveal>
    <p class="max-w-[760px] text-[clamp(1.375rem,2.4vw,2rem)] leading-[1.35] tracking-[-0.02em]">
      {siteConfig.description}
    </p>

    <dl class="mt-16 grid grid-cols-3 gap-10 border-t border-border pt-10 max-[800px]:grid-cols-1">
      <div>
        <dt class="label-mono text-foreground-muted">BASED IN</dt>
        <dd class="mt-3 ml-0 text-[17px]">{siteConfig.location}</dd>
      </div>
      <div>
        <dt class="label-mono text-foreground-muted">BUILDS WITH</dt>
        <dd class="mt-3 ml-0 text-[17px]">Astro</dd>
      </div>
      <div>
        <dt class="label-mono text-foreground-muted">SAY HI</dt>
        <dd class="mt-3 ml-0 text-[17px]">
          <a href={'mailto:' + siteConfig.email}>{siteConfig.email}</a>
        </dd>
      </div>
    </dl>
  </section>

  <Founder />
  <Cta />
</SiteLayout>
