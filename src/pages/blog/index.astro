---
/**
 * Blog index
 * URL: /blog
 *
 * The listing is an editorial list rather than Velocity's card grid — the
 * identity is built on big type and hairline rules, not cards.
 */
import SiteLayout from '@/layouts/SiteLayout.astro';
import SectionHead from '@/components/sections/SectionHead.astro';
import Cta from '@/components/sections/Cta.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '@/lib/utils';
import { coverPath } from '@/lib/og';
import PostCover from '@/components/blog/PostCover.astro';
import { Icon } from 'astro-icon/components';

const posts = (
  await getCollection('blog', ({ data }) => (import.meta.env.PROD ? data.draft !== true : true))
)
  .filter((post) => post.data.locale === 'en')
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const postUrl = (id: string) => '/blog/' + id.replace('en/', '');
---

<SiteLayout
  title="Blog"
  description="Notes on Astro, web performance and building fast websites, by Hans Martens."
>
  <header class="shell pt-[180px] max-[800px]:pt-[130px]">
    <SectionHead
      as="h1"
      title="Blog"
      blurb="Notes on Astro, web performance and building fast websites: what I'm working on, and what I learn along the way."
    />
    {/* Follow along without a newsletter: the RSS feed, for feed readers. */}
    <a class="blog-rss" href="/rss.xml" data-reveal>
      <Icon name="lucide:rss" aria-hidden="true" />
      Follow via RSS
    </a>
  </header>

  <!-- Pagefind search. Hidden until the index is confirmed present, so it
       never shows up broken in `astro dev`, where no index has been built. -->
  <div class="shell mt-16 max-[800px]:mt-10" id="lab-search" hidden>
    <label class="label-mono text-foreground-muted" for="lab-search-input">SEARCH</label>
    <input
      id="lab-search-input"
      type="search"
      autocomplete="off"
      placeholder="Search the blog"
      class="border-border placeholder:text-foreground-subtle focus:border-foreground mt-3 w-full max-w-[560px] border-0 border-b bg-transparent pb-4 text-[clamp(1.25rem,2.4vw,1.75rem)] tracking-[-0.03em] outline-none"
    />
  </div>

  <section class="shell mt-14 max-[800px]:mt-10">
    <ul class="m-0 list-none p-0" id="lab-results" hidden></ul>

    <ul class="m-0 list-none p-0" id="lab-list">
      {
        posts.map((post) => (
          <li class="border-border border-t last:border-b" data-reveal>
            <a
              class="group grid grid-cols-[minmax(0,1fr)_minmax(0,360px)] items-center gap-12 py-10 max-[800px]:grid-cols-1 max-[800px]:gap-6 max-[800px]:py-7"
              href={postUrl(post.id)}
              data-card
            >
              <div class="max-[800px]:order-2">
                <span class="label-mono text-foreground-muted">
                  {formatDate(post.data.publishedAt).toUpperCase()}
                </span>

                <h2 class="font-display mt-4 mb-0 text-[clamp(1.75rem,4.4vw,3.25rem)] leading-[1.05] font-semibold tracking-[var(--display-tracking)] [text-transform:var(--display-case)]">
                  {post.data.title}
                </h2>

                <p class="text-foreground-secondary mt-4 mb-0 max-w-[620px] text-[17px] leading-[1.55]">
                  {post.data.description}
                </p>

                {post.data.tags.length > 0 && (
                  <div class="mt-5 flex flex-wrap gap-2">
                    {post.data.tags.map((tag) => (
                      <span class="border-border rounded-full border px-3.5 py-1.5 text-[13px] font-medium">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}
              </div>
              {/* The cover, beside the text (above it on a phone). Decorative:
                  it is the title set as artwork. */}
              <PostCover
                class="border-border w-full rounded-[12px] border max-[800px]:order-1"
                src={post.data.image?.src ?? coverPath(post.id.replace(/^en\//, ''))}
              />
            </a>
          </li>
        ))
      }
    </ul>

    {
      posts.length === 0 && (
        <p class="text-foreground-secondary py-10 text-[17px]">Nothing published yet.</p>
      )
    }
  </section>

  <Cta />
</SiteLayout>

<script>
  interface PagefindResult {
    data: () => Promise<{ url: string; excerpt: string; meta: { title?: string } }>;
  }

  interface PagefindApi {
    init: () => Promise<void>;
    debouncedSearch: (query: string) => Promise<{ results: PagefindResult[] } | null>;
  }

  async function initLabSearch() {
    const wrapper = document.getElementById('lab-search');
    const input = document.getElementById('lab-search-input') as HTMLInputElement | null;
    const results = document.getElementById('lab-results');
    const list = document.getElementById('lab-list');

    if (!wrapper || !input || !results || !list) return;

    let pagefind: PagefindApi;

    try {
      // The path is held in a variable so Vite does not try to resolve it at
      // build time — the index only exists in dist/ after `pagefind` runs.
      const modulePath = '/pagefind/pagefind.js';
      pagefind = (await import(/* @vite-ignore */ modulePath)) as PagefindApi;
      await pagefind.init();
    } catch {
      // No index (dev server, or a build that skipped the pagefind step).
      return;
    }

    wrapper.hidden = false;

    input.addEventListener('input', async () => {
      const query = input.value.trim();

      if (query === '') {
        results.hidden = true;
        results.innerHTML = '';
        list.hidden = false;
        return;
      }

      const search = await pagefind.debouncedSearch(query);
      if (!search) return;

      const found = await Promise.all(search.results.slice(0, 8).map((result) => result.data()));

      list.hidden = true;
      results.hidden = false;
      results.innerHTML = found
        .map(
          (item) =>
            '<li class="border-t border-border last:border-b">' +
            '<a class="group block py-8" href="' +
            item.url +
            '">' +
            '<h2 class="font-display [text-transform:var(--display-case)] m-0 text-[clamp(1.5rem,3.2vw,2.25rem)] leading-[1.1] font-semibold tracking-[var(--display-tracking)]">' +
            (item.meta.title ?? 'Untitled') +
            '</h2>' +
            '<p class="mt-3 mb-0 max-w-[620px] text-[16px] leading-[1.55] text-foreground-secondary">' +
            item.excerpt +
            '</p>' +
            '</a></li>'
        )
        .join('');

      if (found.length === 0) {
        results.innerHTML =
          '<li class="py-10 text-[17px] text-foreground-secondary">No matches.</li>';
      }
    });
  }

  initLabSearch();
  document.addEventListener('astro:after-swap', initLabSearch);
</script>

<style>
  .blog-rss {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 28px;
    font-size: 15px;
    font-weight: 600;
    color: var(--hero-accent, #7c3aed);
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 4px;
  }

  .blog-rss:hover {
    text-decoration-thickness: 2.5px;
  }

  .blog-rss :global(svg) {
    width: 16px;
    height: 16px;
  }
</style>
