---
/**
 * Contact page
 * URL: /contact
 *
 * In the style of the project, blog and About pages (Hans's choice): the
 * shared cinema hero (site/CinemaHero.astro) with a mail icon and the ways
 * to reach me in its strip, then the form in the card with the violet glow (Hans's earlier choice),
 * on the second ground. Velocity's form and /api/contact endpoint; the
 * submit handler is carried over unchanged.
 */
import SiteLayout from '@/layouts/SiteLayout.astro';
import CinemaHero from '@/components/site/CinemaHero.astro';
import Input from '@/components/ui/form/Input/Input.astro';
import Textarea from '@/components/ui/form/Textarea/Textarea.astro';
import ArrowFillButton from '@/components/site/ArrowFillButton.astro';
import siteConfig from '@/config/site.config';

const channels = [
  { label: 'Email', value: siteConfig.email, href: 'mailto:' + siteConfig.email },
  // Messages, not calls: they come in from everywhere.
  { label: 'WhatsApp', value: 'Send a message', href: siteConfig.whatsapp, external: true },
  { label: 'Based in', value: siteConfig.location },
  // WhatsApp only with a link in site.config.ts.
].filter((channel) => channel.label !== 'WhatsApp' || channel.href);
import { pages } from '@/config/theme.config';
---

<SiteLayout
  title="Contact"
  description={pages.contact.description}
  includeOrgSchema
  navOverMedia
  footerDeep
>
  <CinemaHero
    label="CONTACT"
    title={pages.contact.title}
    accent={pages.contact.accent}
    description={pages.contact.blurb}
    facts={channels}
    factsLabel="Other ways to reach me"
    icon="mail"
    short
  />

  {/* --- the form: the glow card, on the second ground ------------------- */}
  <section class="ct">
    <div class="ct__inner shell">
      <span class="label-mono ct__label" data-reveal>SEND A MESSAGE</span>
      <div class="ct__stage" data-reveal>
        <div class="ct__card">
          <form id="contact-form" action="/api/contact" method="POST" class="contact__form">
            <Input label="Your name" name="name" type="text" required autocomplete="name" />
            <Input label="Email address" name="email" type="email" required autocomplete="email" />
            <Input label="Subject" name="subject" type="text" />
            <Textarea
              label="Message"
              name="message"
              placeholder="Your idea, your question, or just hello."
              rows={6}
              required
            />

            <!-- Honeypot field for spam protection -->
            <div class="hidden" aria-hidden="true">
              <input type="text" name="honeypot" tabindex="-1" autocomplete="off" />
            </div>

            <div id="form-message" class="hidden text-sm" role="status" aria-live="polite"></div>

            <ArrowFillButton type="submit" id="submit-button" icon="lucide:send" class="self-start">
              Send message
            </ArrowFillButton>
          </form>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  /* --- the form -------------------------------------------------------- */
  /* The hero is lower here, and the card starts close under it, so the
     form shows on the first screen (Hans's choice). */
  .ct {
    padding-block: clamp(48px, 5vw, 72px) clamp(88px, 11vw, 160px);
    background: var(--background-secondary);
  }

  .ct__inner {
    max-width: 820px;
  }

  .ct__label {
    display: block;
    margin-bottom: 24px;
    text-align: center;
    color: var(--foreground-muted);
  }

  /* The violet glow behind the card: the brand colour, blurred. Light
     mode only: on the dark ground a wide blur shows its steps as rings,
     so dark mode has a close glow round the card instead (below). */
  .ct__stage {
    position: relative;
    isolation: isolate;
  }

  .ct__stage::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 8% 4% -4%;
    border-radius: 40px;
    background: var(--orbit-fill);
    filter: blur(110px);
    opacity: 0.35;
    pointer-events: none;
  }

  :global(.dark) .ct__stage::before {
    display: none;
  }

  /* Dark mode: a thin violet edge and a short glow round the card, close
     enough to show no rings (Hans's choice). */
  :global(.dark) .ct__card {
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--orbit-fill) 35%, transparent),
      0 24px 80px -24px color-mix(in srgb, var(--orbit-fill) 55%, transparent);
  }

  .ct__card {
    padding: clamp(28px, 4vw, 52px);
    border: 1px solid var(--border);
    border-radius: 28px;
    background: var(--background-elevated, #fff);
  }

  /* Name and email side by side, the rest across the card. */
  .contact__form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px 18px;
  }

  .contact__form > :global(*) {
    grid-column: 1 / -1;
    min-width: 0;
  }

  .contact__form > :global(div:nth-of-type(-n + 2)) {
    grid-column: auto;
  }

  .contact__form > :global(button) {
    justify-self: start;
  }

  @media (max-width: 640px) {
    .contact__form > :global(div:nth-of-type(-n + 2)) {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  function initContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const button = document.getElementById('submit-button') as HTMLButtonElement | null;
    const message = document.getElementById('form-message') as HTMLDivElement | null;

    if (!form || !button || !message) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // The button carries its label twice (the pill and the disc's copy).
      const setLabel = (text: string) =>
        button.querySelectorAll('.afb__label').forEach((el) => (el.textContent = text));
      button.disabled = true;
      setLabel('Sending…');
      message.classList.add('hidden');

      try {
        const formData = new FormData(form);
        const response = await fetch('/api/contact', {
          method: 'POST',
          body: formData,
        });

        const data = await response.json();

        if (data.success) {
          message.textContent = "Message sent. I'll get back to you by email.";
          message.className = 'text-sm text-success';
          form.reset();
        } else {
          const errors = data.errors
            ? Object.values(data.errors).flat().join(', ')
            : 'Something went wrong';
          message.textContent = errors;
          message.className = 'text-sm text-destructive';
        }
      } catch {
        message.textContent = 'Failed to send message. Please try again later.';
        message.className = 'text-sm text-destructive';
      } finally {
        button.disabled = false;
        setLabel('Send message');
        message.classList.remove('hidden');
      }
    });
  }

  initContactForm();
  document.addEventListener('astro:after-swap', initContactForm);
</script>
