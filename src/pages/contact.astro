---
/**
 * Contact page
 * URL: /contact
 *
 * Velocity's contact form and /api/contact endpoint, wearing the studio's
 * type. The submit handler is carried over from the stock page unchanged.
 */
import { Icon } from 'astro-icon/components';
import SiteLayout from '@/layouts/SiteLayout.astro';
import SectionHead from '@/components/sections/SectionHead.astro';
import Input from '@/components/ui/form/Input/Input.astro';
import Textarea from '@/components/ui/form/Textarea/Textarea.astro';
import ArrowFillButton from '@/components/site/ArrowFillButton.astro';
import siteConfig from '@/config/site.config';

const channels = [
  { label: 'EMAIL', value: siteConfig.email, href: 'mailto:' + siteConfig.email, icon: 'mail' },
  // Messages, not calls: they come in from everywhere.
  {
    label: 'WHATSAPP',
    value: 'Send a message',
    href: siteConfig.whatsapp,
    icon: 'message-circle',
    external: true,
  },
  { label: 'BASED IN', value: siteConfig.location, href: undefined, icon: 'map-pin' },
];
---

<SiteLayout
  title="Contact"
  description="Let's talk Astro. An idea for a website, a question about a theme, a blog post or something on GitHub: say hello to Hans Martens."
  includeOrgSchema
>
  <header class="contact__head shell pt-[180px] max-[800px]:pt-[130px]">
    <SectionHead
      as="h1"
      title="Let’s talk Astro"
      accent="Astro"
      blurb="An idea for a website, a question about one of my themes, a blog post or something I shared on GitHub? Everybody is welcome. I read and answer every message myself."
    />
  </header>

  {/* From 1024px wide: one card, the violet panel (the line and the ways to
      reach me) beside the form. Smaller screens keep the page in one column:
      heading and line, form, ways to reach me (the panel steps aside with
      display: contents, and the header's line shows instead of its own). */}
  <section class="contact shell">
    <div class="contact__card">
      <div class="contact__panel">
        <p class="contact__blurb">An idea for a website, a question about one of my themes, a blog post or something I shared on GitHub? Everybody is welcome. I read and answer every message myself.</p>
        <aside class="contact__channels flex flex-col gap-10">
          {
            channels.map((channel) => (
              <div class="channel border-t border-border pt-6">
                <span class="channel__label label-mono text-foreground-muted">
                  <Icon name={'lucide:' + channel.icon} aria-hidden="true" />
                  {channel.label}
                </span>
                <p class="channel__value mt-3 mb-0 text-[clamp(1.25rem,2vw,1.75rem)] tracking-[-0.03em]">
                  {channel.href ? (
                    <a
                      href={channel.href}
                      target={'external' in channel && channel.external ? '_blank' : undefined}
                      rel={'external' in channel && channel.external ? 'noopener noreferrer' : undefined}
                    >
                      {channel.value}
                    </a>
                  ) : (
                    channel.value
                  )}
                </p>
              </div>
            ))
          }
        </aside>
      </div>

      <form id="contact-form" action="/api/contact" method="POST" class="contact__form flex flex-col gap-6">
        <Input label="Your name" name="name" type="text" required autocomplete="name" />
        <Input label="Email address" name="email" type="email" required autocomplete="email" />
        <Input label="Subject" name="subject" type="text" />
        <Textarea
          label="Message"
          name="message"
          placeholder="Your idea, your question, or just hello."
          rows={6}
          required
        />

        <!-- Honeypot field for spam protection -->
        <div class="hidden" aria-hidden="true">
          <input type="text" name="honeypot" tabindex="-1" autocomplete="off" />
        </div>

        <div id="form-message" class="hidden text-sm" role="status" aria-live="polite"></div>

        <ArrowFillButton type="submit" id="submit-button" icon="lucide:send" class="self-start">
          Send message
        </ArrowFillButton>
      </form>
    </div>
  </section>

  <div class="h-[140px] max-[800px]:h-[100px]"></div>
</SiteLayout>

<style>
  .channel__label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .channel__label :global(svg) {
    width: 14px;
    height: 14px;
    stroke-width: 1.75;
  }
  /* --- one column (phone, tablet portrait) ------------------------------ */
  .contact {
    margin-top: 80px;
  }

  .contact__card {
    display: flex;
    flex-direction: column;
    gap: 80px;
  }

  .contact__panel {
    display: contents;
  }

  .contact__blurb {
    display: none;
  }

  .contact__form {
    order: 1;
  }

  .contact__channels {
    order: 2;
  }

  @media (max-width: 900px) {
    .contact {
      margin-top: 48px;
    }

    .contact__card {
      gap: 48px;
    }
  }

  /* --- the card (tablet landscape and wider) ----------------------------- */
  @media (min-width: 1024px) {
    /* The line moves from under the heading into the panel. */
    .contact__head :global(header > p) {
      display: none;
    }

    .contact {
      margin-top: 64px;
    }

    .contact__card {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.2fr);
      gap: 0;
      overflow: hidden;
      border: 1px solid var(--border);
      border-radius: 28px;
      background: var(--background-elevated, #fff);
    }

    /* The brand colour under white text (--orbit-fill keeps that contrast
       whatever colour the owner picks), lit from the top right. */
    .contact__panel {
      position: relative;
      isolation: isolate;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      gap: 48px;
      padding: clamp(36px, 4vw, 56px);
      background: var(--orbit-fill);
      color: #fff;
    }

    .contact__panel::before {
      content: '';
      position: absolute;
      z-index: -1;
      top: -35%;
      right: -35%;
      width: 80%;
      aspect-ratio: 1;
      border-radius: 50%;
      background: radial-gradient(circle, rgb(255 255 255 / 0.2), transparent 65%);
    }

    .contact__blurb {
      display: block;
      margin: 0;
      font-size: clamp(1.15rem, 1.6vw, 1.4rem);
      line-height: 1.5;
    }

    .contact__channels {
      gap: 24px;
    }

    .contact__panel .channel {
      padding-top: 20px;
      border-color: rgb(255 255 255 / 0.28);
    }

    .contact__panel .channel__label {
      color: rgb(255 255 255 / 0.85);
    }

    .contact__panel .channel__value {
      margin-top: 8px;
      font-size: clamp(1.1rem, 1.5vw, 1.35rem);
      color: #fff;
    }

    .contact__panel .channel__value a {
      color: inherit;
      text-decoration: underline;
      text-decoration-color: rgb(255 255 255 / 0.45);
      text-underline-offset: 4px;
    }

    .contact__panel .channel__value a:hover {
      text-decoration-color: #fff;
    }

    .contact__panel .channel__value a:focus-visible {
      outline: 2px solid #fff;
      outline-offset: 4px;
    }

    .contact__form {
      padding: clamp(36px, 4vw, 56px);
    }
  }
</style>

<script>
  function initContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const button = document.getElementById('submit-button') as HTMLButtonElement | null;
    const message = document.getElementById('form-message') as HTMLDivElement | null;

    if (!form || !button || !message) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // The button carries its label twice (the pill and the disc's copy).
      const setLabel = (text: string) =>
        button.querySelectorAll('.afb__label').forEach((el) => (el.textContent = text));
      button.disabled = true;
      setLabel('Sending…');
      message.classList.add('hidden');

      try {
        const formData = new FormData(form);
        const response = await fetch('/api/contact', {
          method: 'POST',
          body: formData,
        });

        const data = await response.json();

        if (data.success) {
          message.textContent = "Message sent. I'll get back to you by email.";
          message.className = 'text-sm text-success';
          form.reset();
        } else {
          const errors = data.errors
            ? Object.values(data.errors).flat().join(', ')
            : 'Something went wrong';
          message.textContent = errors;
          message.className = 'text-sm text-destructive';
        }
      } catch {
        message.textContent = 'Failed to send message. Please try again later.';
        message.className = 'text-sm text-destructive';
      } finally {
        button.disabled = false;
        setLabel('Send message');
        message.classList.remove('hidden');
      }
    });
  }

  initContactForm();
  document.addEventListener('astro:after-swap', initContactForm);
</script>
