---
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Nav from '@/components/site/Nav.astro';
import Footer from '@/components/site/Footer.astro';
import BackToTop from '@/components/site/BackToTop.astro';
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro';
import ArticleHero from '@/components/blog/ArticleHero.astro';
import ShareButtons from '@/components/blog/ShareButtons.astro';
import RelatedPosts from '@/components/blog/RelatedPosts.astro';
import NewsletterSignup from '@/components/blog/NewsletterSignup.astro';
import TableOfContents from '@/components/blog/TableOfContents.astro';
import type { MarkdownHeading } from 'astro';

interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  updatedAt?: Date;
  author?: string;
  /** Astro, Themes or Performance: shown in the hero's facts. */
  category?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  /** The generated cover (/covers/<slug>.png), used when there is no image. */
  cover?: string;
  tags?: string[];
  slug?: string;
  /** The post's headings, for the table of contents (empty hides it). */
  headings?: MarkdownHeading[];
  /** The cover's Lucide icon, for the hero's corner. */
  icon?: string;
  /** Minutes to read, shown in the hero. */
  readingTime?: number;
}

const {
  title,
  description,
  publishedAt,
  updatedAt,
  author = 'Hans Martens',
  category,
  image,
  imageAlt,
  cover,
  tags = [],
  slug = '',
  headings = [],
  readingTime,
  icon,
} = Astro.props;

// The same rule as the component: H2 + H3, at least three of them.
const hasToc = headings.filter((h) => h.depth >= 2 && h.depth <= 3).length >= 3;

const ogImage = image?.src || cover || `/og${Astro.url.pathname.replace(/\/$/, '')}.png`;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Blog', href: '/blog' },
  { label: title },
];

// Get full URL for sharing
const fullUrl = new URL(Astro.url.pathname, Astro.site).toString();
---

<BaseLayout
  title={title}
  description={description}
  image={ogImage}
  imageAlt={imageAlt || title}
  article={{
    publishedTime: publishedAt,
    modifiedTime: updatedAt,
    authors: [author],
    tags,
  }}
>
  <Nav slot="header" />

  <!-- Article Hero -->
  <ArticleHero
    title={title}
    description={description}
    publishedAt={publishedAt}
    updatedAt={updatedAt}
    author={author}
    category={category}
    tags={tags}
    image={image}
    imageAlt={imageAlt}
    readingTime={readingTime}
    icon={icon}
  />

  <article class="py-12">
    <div class:list={['mx-auto px-6', hasToc ? 'max-w-4xl xl:max-w-7xl' : 'max-w-4xl']}>
      <div class:list={[hasToc && 'xl:grid xl:grid-cols-[minmax(0,1fr)_16rem] xl:gap-14']}>
      <div class="min-w-0 xl:max-w-4xl">
      <!-- Breadcrumbs -->
      {/* The breadcrumbs and the contents arrive with the post on load, not
          on scroll: on a tall phone they fall below the first wave's line,
          and the space under the header card stood empty until a scroll. */}
      <div class="mb-8" data-reveal data-reveal-load><Breadcrumbs items={breadcrumbs} /></div>

      {hasToc && (
        <div class="mb-10 xl:hidden" data-reveal data-reveal-load>
          <TableOfContents headings={headings} collapsible />
        </div>
      )}

      <!-- Article Content -->
      <div
        data-pagefind-body
        data-reveal-content
        class="prose prose-lg prose-headings:font-display prose-headings:font-bold prose-code:text-brand-600 prose-code:bg-brand-50 prose-code:px-1 prose-code:py-0.5 prose-code:rounded prose-pre:bg-background-secondary prose-pre:border prose-pre:border-border dark:prose-invert dark:prose-code:text-brand-400 dark:prose-code:bg-brand-900/30 max-w-none"
      >
        <slot />
      </div>

      <!-- Article Footer -->
      <footer class="border-border mt-12 border-t pt-8" data-reveal>
        <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
          <!-- Back link -->
          <a
            href="/blog"
            class="text-brand-600 hover:text-brand-500 dark:text-[var(--hero-accent-on-ink)] dark:hover:text-white inline-flex items-center gap-2 text-sm font-medium transition-colors"
          >
            <svg
              class="h-4 w-4"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"
              ></path>
            </svg>
            Back to Blog
          </a>

          <!-- Share buttons -->
          <ShareButtons title={title} url={fullUrl} />
        </div>
      </footer>

      <!-- New posts by email -->
      <NewsletterSignup />
      </div>

      {hasToc && (
        <aside class="hidden xl:block" data-reveal>
          <TableOfContents headings={headings} sticky />
        </aside>
      )}
      </div>
    </div>
  </article>

  <!-- Related Posts, on the second ground: the zebra of the project pages -->
  {
    tags.length > 0 && (
      <div class="bg-background-secondary">
        <div class="shell pb-24">
          <RelatedPosts currentSlug={slug} tags={tags} locale="en" maxPosts={4} />
        </div>
      </div>
    )
  }

  <Footer slot="footer" />
  <BackToTop slot="footer" />
</BaseLayout>

<script>
  /* The site's reveal system (src/scripts/motion): the whole post arrives
     as it is read, the header card's lines, then each block of the text,
     the footer and the related posts. Without the script nothing would
     show, since BaseLayout hides reveals for it to show. */
  import '@/scripts/motion';
</script>
