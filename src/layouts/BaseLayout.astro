---
import '@/styles/global.css';
import SEO from '@/components/seo/SEO.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import Analytics from '@/components/layout/Analytics.astro';
import ConsentBanner from '@/components/ui/overlay/ConsentBanner';
import { ClientRouter } from 'astro:transitions';
import { createWebsiteSchema, createPersonSchema } from '@/lib/schema';
import type { WebSite, Person, WithContext } from 'schema-dts';
import siteConfig from '@/config/site.config';
// The two faces every page paints first. Preloaded so the display headline
// does not swap in after first paint and reflow at 168px.
import outfitWoff2 from '@fontsource-variable/outfit/files/outfit-latin-wght-normal.woff2?url';
import archivoWoff2 from '@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  article?: {
    publishedTime?: Date;
    modifiedTime?: Date;
    authors?: string[];
    tags?: string[];
  };
  noindex?: boolean;
  nofollow?: boolean;
  includeOrgSchema?: boolean;
}

const {
  title,
  description,
  image,
  imageAlt,
  article,
  noindex = false,
  nofollow = false,
  includeOrgSchema = false,
} = Astro.props;

// Build JSON-LD schemas
// The site and the person it is by, on every page: the WebSite names the
// Person as its author by @id, so the Person has to be there to resolve.
// (includeOrgSchema is kept so existing pages still compile.)
const schemas: Array<WithContext<WebSite> | WithContext<Person>> = [createWebsiteSchema(), createPersonSchema()];
void includeOrgSchema;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={siteConfig.branding.favicon.svg} />
    <link rel="manifest" href="/manifest.webmanifest" />
    {/* The browser bar's colour follows the page: ink by default (dark
        first), ice once light is chosen. The inline theme script below and
        ThemeToggle keep it in step. Not branding.colors.themeColor, which
        the share images use and stays the light ground. */}
    <meta name="theme-color" content="#0e0d15" id="theme-color" />

    <!-- Fonts: latin subsets of the display and body faces -->
    <link rel="preload" href={outfitWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={archivoWoff2} as="font" type="font/woff2" crossorigin />

    <!-- SEO -->
    <SEO
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      article={article}
      noindex={noindex}
      nofollow={nofollow}
    />

    <!-- RSS Feed -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteConfig.name} RSS Feed`}
      href="/rss.xml"
    />

    <!-- JSON-LD Structured Data -->
    <JsonLd schema={schemas} />

    <!-- Analytics (loads if PUBLIC_GA_MEASUREMENT_ID or PUBLIC_GTM_ID is set) -->
    <Analytics />

    <!-- Client-side routing for view transitions -->
    <ClientRouter />

    <!-- Motion (src/scripts/motion) hides what it is about to reveal behind
         this class, so nothing is ever hidden for a visitor without JS. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <!-- Theme, before first paint so it never flashes: the visitor's choice
         from the header's ThemeToggle (localStorage.theme), else dark. Dark
         comes first for everyone on arrival (Hans's choice: the 3D scene is
         at its best on ink); a visitor who picks Light or System keeps it on
         every visit. Sets <html data-theme-mode> for the toggle's icon, .dark
         for the theme itself, and the browser bar's colour. -->
    <script is:inline>
      (function () {
        let mode = 'dark';
        try {
          const saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark' || saved === 'system') mode = saved;
        } catch {
          // Storage blocked (private mode, site data off): follow the system.
        }
        const dark =
          mode === 'dark' ||
          (mode === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        const root = document.documentElement;
        root.setAttribute('data-theme-mode', mode);
        root.classList.toggle('dark', dark);
        const bar = document.getElementById('theme-color');
        if (bar) bar.setAttribute('content', dark ? '#0e0d15' : '#eef2f4');
      })();
    </script>
  </head>

  <body class="bg-background text-foreground min-h-screen antialiased">
    <!-- Skip to content link -->
    <a
      href="#main-content"
      class="focus:bg-primary focus:text-primary-foreground sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-md focus:px-4 focus:py-2"
    >
      Skip to content
    </a>

    <slot name="header" />

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <slot name="footer" />

    <ConsentBanner />
  </body>
</html>
