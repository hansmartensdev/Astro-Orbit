---
/**
 * About page. Rendered by src/pages/about.astro and src/pages/[lang]/[...about].astro.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import PageHero from '@/components/blocks/PageHero.astro';
import FeatureSplit from '@/components/blocks/FeatureSplit.astro';
import Timeline from '@/components/blocks/Timeline.astro';
import FeatureGrid from '@/components/blocks/FeatureGrid.astro';
import CtaBand from '@/components/blocks/CtaBand.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import { localizeRoute, useTranslations, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const step = (key: string) => ({
  date: t(`aboutPage.path.${key}.date`),
  title: t(`aboutPage.path.${key}.title`),
  body: t(`aboutPage.path.${key}.body`),
});
---

<PageLayout title={t('aboutPage.eyebrow')} description={t('aboutPage.description')}>
  <PageHero eyebrow={t('aboutPage.eyebrow')} title={t('aboutPage.title')} lead={t('aboutPage.description')} size="lg" />

  <FeatureSplit
    eyebrow={t('aboutPage.intro.eyebrow')}
    title={t('aboutPage.intro.title')}
    lead={t('aboutPage.intro.lead')}
    points={[t('aboutPage.intro.points.one'), t('aboutPage.intro.points.two'), t('aboutPage.intro.points.three')]}
    photo="about"
    alt={t('aboutPage.intro.portrait')}
    ratio="4/5"
    reverse
  />

  <Timeline
    tone="secondary"
    eyebrow={t('aboutPage.path.eyebrow')}
    title={t('aboutPage.path.title')}
    items={[step('now'), step('before'), step('start')]}
  />

  <FeatureGrid
    columns={2}
    variant="card"
    eyebrow={t('aboutPage.values.eyebrow')}
    title={t('aboutPage.values.title')}
    items={[
      { icon: 'zap', title: t('aboutPage.values.fast.title'), body: t('aboutPage.values.fast.body') },
      { icon: 'accessibility', title: t('aboutPage.values.everyone.title'), body: t('aboutPage.values.everyone.body') },
      { icon: 'message-square-text', title: t('aboutPage.values.plain.title'), body: t('aboutPage.values.plain.body') },
      { icon: 'anchor', title: t('aboutPage.values.lasting.title'), body: t('aboutPage.values.lasting.body') },
    ]}
  />

  <CtaBand title={t('aboutPage.cta.title')} lead={t('aboutPage.cta.lead')} tone="brand">
    <Button size="lg" variant="secondary" href={localizeRoute('contact', locale)}>{t('aboutPage.cta.button')}</Button>
  </CtaBand>
</PageLayout>
