---
/**
 * Home page. Rendered by src/pages/index.astro and src/pages/[lang]/index.astro.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Hero from '@/components/hero/Hero.astro';
import Section from '@/components/patterns/Section.astro';
import MediaSlot from '@/components/patterns/MediaSlot.astro';
import FeatureGrid from '@/components/blocks/FeatureGrid.astro';
import Steps from '@/components/blocks/Steps.astro';
import CtaBand from '@/components/blocks/CtaBand.astro';
import BlogCard from '@/components/blog/BlogCard.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import ProjectCard from '@/components/site/ProjectCard.astro';
import { localizeRoute, useTranslations, type Locale } from '@/i18n';
import { getProjects } from '@/lib/projects';
import { getPosts, getPostReadingTime, getPostUrl } from '@/lib/blog';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const projects = await getProjects(locale);
const featured = projects.filter((p) => p.data.featured);
const shown = (featured.length > 0 ? featured : projects).slice(0, 4);
const posts = (await getPosts(locale)).slice(0, 3);
---

<PageLayout title={t('meta.home.title')} description={t('meta.home.description')}>
  <Hero layout="split" size="lg" showGrid>
    <Badge slot="badge" variant="success" pill pulse>{t('home.hero.status')}</Badge>
    <h1 slot="title">
      {t('home.hero.title')}
      <span class="text-brand-600 dark:text-brand-400">{t('home.hero.titleHighlight')}</span>
    </h1>
    <p slot="description">{t('home.hero.lead')}</p>
    <div slot="actions" class="flex flex-col gap-3 sm:flex-row">
      <Button href="#work" size="lg" variant="brand">
        {t('home.hero.primary')}
        <Icon name="arrow-down" size="sm" />
      </Button>
      <Button href={localizeRoute('contact', locale)} size="lg" variant="outline">
        {t('home.hero.secondary')}
      </Button>
    </div>
    <MediaSlot slot="aside" photo="portrait" alt={t('home.hero.portrait')} label={t('home.hero.portrait')} ratio="4/5" priority class="mx-auto w-full max-w-sm rounded-2xl" />
  </Hero>

  <Section id="work" eyebrow={t('home.work.eyebrow')} title={t('home.work.title')}  lead={t('home.work.lead')}>
    <Button slot="action" variant="outline" href={localizeRoute('work', locale)}>
      {t('home.work.all')}
      <Icon name="arrow-right" size="sm" />
    </Button>
    <div class="grid gap-x-8 gap-y-14 md:grid-cols-2">
      {shown.map((project) => <ProjectCard project={project} />)}
    </div>
  </Section>

  <FeatureGrid
    tone="secondary"
    columns={4}
    eyebrow={t('home.services.eyebrow')}
    title={t('home.services.title')}
    lead={t('home.services.lead')}
    items={[
      { icon: 'pen-tool', title: t('home.services.product.title'), body: t('home.services.product.body') },
      { icon: 'code-xml', title: t('home.services.frontend.title'), body: t('home.services.frontend.body') },
      { icon: 'blocks', title: t('home.services.systems.title'), body: t('home.services.systems.body') },
      { icon: 'globe', title: t('home.services.sites.title'), body: t('home.services.sites.body') },
    ]}
  />

  <Steps
    layout="row"
    eyebrow={t('home.process.eyebrow')}
    title={t('home.process.title')}
    items={[
      { title: t('home.process.listen.title'), body: t('home.process.listen.body') },
      { title: t('home.process.shape.title'), body: t('home.process.shape.body') },
      { title: t('home.process.build.title'), body: t('home.process.build.body') },
      { title: t('home.process.handover.title'), body: t('home.process.handover.body') },
    ]}
  />

  {
    posts.length > 0 && (
      <Section eyebrow={t('home.writing.eyebrow')} title={t('home.writing.title')} tone="secondary">
        <Button slot="action" variant="outline" href={localizeRoute('blog', locale)}>
          {t('home.writing.all')}
          <Icon name="arrow-right" size="sm" />
        </Button>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <BlogCard
              title={post.data.title}
              description={post.data.description}
              readingTime={getPostReadingTime(post)}
              href={getPostUrl(post)}
              publishedAt={post.data.publishedAt}
              tags={post.data.tags}
              image={post.data.image}
            />
          ))}
        </div>
      </Section>
    )
  }

  <CtaBand title={t('home.cta.title')} lead={t('home.cta.lead')} tone="brand">
    <Button size="lg" variant="secondary" href={localizeRoute('contact', locale)}>
      {t('home.cta.button')}
      <Icon name="arrow-right" size="sm" />
    </Button>
  </CtaBand>
</PageLayout>
